{{define "head"}}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="app-name" content="{{.AppName}}">
<meta name="build-stamp" content="{{.Version}}-{{.CommitID}}">
<meta name="offline-title" content="{{.OfflineTitle}}">
<meta name="offline-heading" content="{{.OfflineHeading}}">
<meta name="offline-message" content="{{.OfflineMessage}}">
<meta name="description" content="{{if .PageDescription}}{{.PageDescription}}{{else}}{{.SiteDescription}}{{end}}">
<meta name="robots" content="{{if .NoIndex}}noindex, nofollow{{else}}index, follow{{end}}">
{{if .SEOKeywords}}<meta name="keywords" content="{{.SEOKeywords}}">{{end}}
{{if .SEOAuthor}}<meta name="author" content="{{.SEOAuthor}}">{{end}}
<link rel="canonical" href="{{.SEOCanonical}}">
{{range $name, $content := .SEOMetaTags}}<meta name="{{$name}}" content="{{$content}}">{{end}}
{{range .SEOVerification}}{{if .Name}}<meta name="{{.Name}}" content="{{.Content}}">{{else}}<meta property="{{.Property}}" content="{{.Content}}">{{end}}{{end}}
{{if .DocumentTitle}}<title>{{.DocumentTitle}}</title>{{else}}<title>{{if .PageTitle}}{{.PageTitle}}{{.SEOTitleSeparator}}{{end}}{{.SiteTitle}}{{if .Tagline}}{{.SEOTitleSeparator}}{{.Tagline}}{{end}}</title>{{end}}

{{/* Every static asset is requested through the "asset" func so the URL carries
     the running build stamp: a matching stamp is served immutable for a year,
     while a stale one revalidates instead of pinning old bytes. */}}
{{/* FaviconURL resolves server.branding.favicon: embedded default when unset,
     the remote URL when configured, or the local serving route. */}}
<link rel="icon" href="{{.FaviconURL}}">
<link rel="apple-touch-icon" href="{{path .BaseURL (asset "/static/images/apple-touch-icon.png")}}">

<link rel="stylesheet" href="{{path .BaseURL (asset "/static/css/common.css")}}">
<link rel="stylesheet" href="{{path .BaseURL (asset "/static/css/components.css")}}">
{{if eq .Layout "public"}}
<link rel="stylesheet" href="{{path .BaseURL (asset "/static/css/public.css")}}">
{{end}}

<link rel="manifest" href="{{path .BaseURL "/manifest.json"}}">
{{/* theme-color mirrors the resolved theme's Background (src/common/theme/colors.go)
     instead of a hardcoded brand color, so browser chrome matches the active theme. */}}
{{if eq .Theme "light"}}
<meta name="theme-color" content="#ffffff">
{{else if eq .Theme "auto"}}
<meta name="theme-color" content="#1a1b26" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
{{else}}
<meta name="theme-color" content="#1a1b26">
{{end}}

{{/* iOS has no beforeinstallprompt event, so home-screen install relies on
     these meta tags plus the manual "Add to Home Screen" instructions in
     app.js's install-prompt UI. */}}
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{.SiteTitle}}">

{{if .SEOOpenGraphEnabled}}
<meta property="og:title" content="{{if .DocumentTitle}}{{.DocumentTitle}}{{else if .PageTitle}}{{.PageTitle}}{{else}}{{.SiteTitle}}{{end}}">
<meta property="og:description" content="{{if .PageDescription}}{{.PageDescription}}{{else}}{{.SiteDescription}}{{end}}">
{{if .SEOImage}}<meta property="og:image" content="{{.SEOImage}}">{{end}}
<meta property="og:type" content="{{if .SEOOpenGraphType}}{{.SEOOpenGraphType}}{{else}}website{{end}}">
<meta property="og:url" content="{{.SEOCanonical}}">
<meta property="og:site_name" content="{{if .SEOOpenGraphSiteName}}{{.SEOOpenGraphSiteName}}{{else}}{{.SiteTitle}}{{end}}">
{{end}}
{{if .SEOTwitterEnabled}}
<meta name="twitter:card" content="{{if .SEOTwitterCard}}{{.SEOTwitterCard}}{{else}}summary_large_image{{end}}">
<meta name="twitter:title" content="{{if .DocumentTitle}}{{.DocumentTitle}}{{else if .PageTitle}}{{.PageTitle}}{{else}}{{.SiteTitle}}{{end}}">
<meta name="twitter:description" content="{{if .PageDescription}}{{.PageDescription}}{{else}}{{.SiteDescription}}{{end}}">
{{if .SEOImage}}<meta name="twitter:image" content="{{.SEOImage}}">{{end}}
{{if .SEOTwitterHandle}}<meta name="twitter:site" content="{{.SEOTwitterHandle}}">{{end}}
{{if .SEOTwitterCreator}}<meta name="twitter:creator" content="{{.SEOTwitterCreator}}">{{end}}
{{end}}
<script type="application/ld+json">{{.SEOJSONLD}}</script>

{{block "head-extra" .}}{{end}}
{{end}}

{{define "head"}}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="CasTools - Everything but the kitchen sink... actually, that too. 1,418 utility endpoints.">
<meta name="keywords" content="developer tools, api utilities, text tools, crypto tools, converters, validators">
<title>{{if .PageTitle}}{{.PageTitle}} - {{end}}CasTools</title>

<link rel="icon" href="/static/images/favicon.ico">
<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png">

<link rel="stylesheet" href="/static/css/common.css">
<link rel="stylesheet" href="/static/css/components.css">
{{if eq .Layout "public"}}
<link rel="stylesheet" href="/static/css/public.css">
{{else if eq .Layout "admin"}}
<link rel="stylesheet" href="/static/css/admin.css">
{{end}}

<link rel="manifest" href="/manifest.json">
{{/* theme-color mirrors the resolved theme's Background (src/common/theme/colors.go)
     instead of a hardcoded brand color, so browser chrome matches the active theme. */}}
{{if eq .Theme "light"}}
<meta name="theme-color" content="#ffffff">
{{else if eq .Theme "auto"}}
<meta name="theme-color" content="#1a1b26" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
{{else}}
<meta name="theme-color" content="#1a1b26">
{{end}}

{{/* iOS has no beforeinstallprompt event, so home-screen install relies on
     these meta tags plus the manual "Add to Home Screen" instructions in
     app.js's install-prompt UI. */}}
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="CasTools">

<meta property="og:title" content="{{if .PageTitle}}{{.PageTitle}}{{else}}CasTools{{end}}">
<meta property="og:description" content="Universal API toolkit with 1,418 utility endpoints">
<meta property="og:type" content="website">

{{block "head-extra" .}}{{end}}
{{end}}

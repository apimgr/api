{{define "header"}}
{{/* Single-row header with the four zones PART 16 "Header Layout" prescribes,
     in order: brand, centered links, preferences, theme toggle. The nav partial
     contributes the middle zone in place rather than rendering a second row
     underneath, which is the layout bug that section exists to fix.
     role="banner" is explicit so assistive tech maps the landmark even when
     <header> is not a direct child of <body>. */}}
<header class="header" role="banner">
  <div class="container">
    {{/* LogoURL is empty unless server.branding.logo is configured, in which
         case the brand renders that image instead of the title text. */}}
    <a href="{{path .BaseURL "/"}}" class="site-brand">
      {{if .LogoURL}}<img class="site-logo" src="{{.LogoURL}}" alt="{{.SiteTitle}}">{{else}}{{.SiteTitle}}{{end}}
    </a>

    {{template "nav" .}}

    {{/* Actions stay in the header on mobile too - never inside the slide-in
         menu (PART 16 "Mobile Responsive Rules"). */}}
    <div class="header-actions">
      {{if .OwnerTokenCookieExists}}
      <details class="header-preferences">
        <summary class="header-link" aria-label="{{t .Lang "common.preferences"}}" title="{{t .Lang "common.preferences"}}"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-5v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.06 16.94l-1.42 1.42m12.72 0-1.42-1.42M7.06 7.06 5.64 5.64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></summary>
        <div class="header-preferences-menu">
          <a href="{{path .BaseURL .OwnerTokensPath}}">{{t .Lang "page_text.text.owner.tokens.a5dc2b2bfe"}}</a>
          <a href="{{path .BaseURL .PreferencesHubPath}}">{{t .Lang "common.preferences"}}</a>
        </div>
      </details>
      {{else}}
      <a href="{{path .BaseURL .PreferencesHubPath}}" class="header-link" aria-label="{{t .Lang "common.preferences"}}" title="{{t .Lang "common.preferences"}}"><svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm0-5v2m0 14v2m9-9h-2M5 12H3m15.36-6.36-1.42 1.42M7.06 16.94l-1.42 1.42m12.72 0-1.42-1.42M7.06 7.06 5.64 5.64" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg></a>
      {{end}}

      {{/* A real form submit, so switching themes works with JavaScript
           disabled; app.js only adds instant preview. The target is nextTheme
           of the theme actually in effect, never a fixed value. */}}
      {{if ne .CurrentPath "/server/preferences"}}
      <form action="{{path .BaseURL .PreferencesHubPath}}" method="POST" class="theme-toggle-form">
        {{csrfField .CSRFToken}}
        <input type="hidden" name="theme" value="{{nextTheme .Theme}}">
        <button type="submit" class="theme-button" aria-label="{{t .Lang "theme.toggle"}}" title="{{t .Lang "theme.toggle"}}">
          <span class="theme-icon" aria-hidden="true">{{if eq .Theme "light"}}☀{{else if eq .Theme "auto"}}◐{{else}}☾{{end}}</span>
        </button>
      </form>
      {{end}}

    </div>
  </div>
  {{if .HeaderExtension}}{{.HeaderExtension}}{{end}}
</header>
{{end}}

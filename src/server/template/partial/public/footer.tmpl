{{define "footer"}}
{{/* role="contentinfo" per PART 30 landmarks. */}}
<footer class="footer" role="contentinfo">
  <div class="container">
    {{/* Row order is fixed per PART 16: overlay addresses (Tor/I2P) -> page
         links -> branding -> last update. Overlay rows are omitted entirely
         when the address is not published, leaving no gap. */}}
    {{if and .TorEnabled .TorRunning .OnionAddress}}
    <p class="footer-onion">
      <a href="{{path .BaseURL "/server/help#tor-access"}}" aria-label="{{t .Lang "page_text.text.tor.support.3384ebc49b"}}"><span aria-hidden="true">🧅</span></a>
      <code class="onion-address">{{.OnionAddress}}</code>
      {{/* Icon-only copy button carries aria-live on itself per PART 16 so the
           swapped label is announced without moving focus. */}}
      <button type="button" class="copy-btn" data-copy="{{.OnionAddress}}" data-copied-label="{{t .Lang "common.copied"}}" aria-live="polite" aria-label="{{t .Lang "page_text.text.copy.onion.address.8c1978ca9e"}}"><span aria-hidden="true">📋</span></button>
    </p>
    {{end}}
    {{if and .I2PEnabled .I2PRunning .I2PAddress}}
    <p class="footer-i2p">
      <a href="{{path .BaseURL "/server/help#i2p-access"}}" aria-label="{{t .Lang "common.i2p_access"}}"><span aria-hidden="true">🧅</span></a>
      <code class="i2p-address">{{.I2PAddress}}</code>
      <button type="button" class="copy-btn" data-copy="{{.I2PAddress}}" data-copied-label="{{t .Lang "common.copied"}}" aria-live="polite" aria-label="{{t .Lang "common.i2p_address"}}"><span aria-hidden="true">📋</span></button>
    </p>
    {{end}}
    <p class="footer-install">
      <button id="pwa-install-btn" class="btn btn-sm" type="button" hidden>{{t .Lang "pwa.install"}}</button>
      <span id="offline-indicator" class="offline-indicator" role="status" aria-live="polite" hidden>{{t .Lang "pwa.offline_message"}}</span>
    </p>
    {{/* The bullet separators are purely visual - aria-hidden keeps screen
         readers from reading "bullet" between every link. */}}
    <p class="footer-links">
      <a href="{{path .BaseURL "/server/about"}}">{{t .Lang "nav.about"}}</a>
      <span aria-hidden="true">•</span>
      <a href="{{path .BaseURL "/server/privacy"}}">{{t .Lang "nav.privacy"}}</a>
      <span aria-hidden="true">•</span>
      <a href="{{path .BaseURL .HelpHubPath}}">{{t .Lang "nav.help"}}</a>
      <span aria-hidden="true">•</span>
      <a href="{{path .BaseURL "/server/terms"}}">{{t .Lang "nav.terms"}}</a>
      <span aria-hidden="true">•</span>
      <a href="{{path .BaseURL .PreferencesHubPath}}">{{t .Lang "common.preferences"}}</a>
      <span aria-hidden="true">•</span>
      <a href="{{path .BaseURL "/server/docs/swagger"}}">{{t .Lang "nav.api_docs"}}</a>
      <span aria-hidden="true">•</span>
      {{range .Languages}}{{if eq $.Lang .Code}}<a href="{{path $.BaseURL "/server/preferences#language"}}" lang="{{.Code}}">{{.NativeName}}</a>{{end}}{{end}}
    </p>
    <p class="footer-branding">
      <a href="https://github.com/apimgr/api" target="_blank" rel="noopener">{{t .Lang "common.made_with"}}</a> <span aria-hidden="true">❤️</span>
      {{if .Version}}
      <span aria-hidden="true">•</span>
      <span>{{.Version}}</span>
      {{end}}
    </p>
    {{if .BuildDate}}
    <p class="footer-build">
      <a href="{{path .BaseURL "/server/healthz"}}">{{t .Lang "privacy.last_updated"}} {{.BuildDate}}</a>
    </p>
    {{end}}
  </div>
</footer>
{{end}}

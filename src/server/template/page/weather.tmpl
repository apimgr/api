{{define "content"}}
<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{t .Lang "page_text.text.weather.fb376a87fc"}}</h1>
    <p class="hero-subtitle">
      {{t .Lang "page_text.text.current.weather.forecasts.and.air.quality.da.11442ec104"}}
    </p>
  </div>
</section>

<section>
  <div class="container">
    <div class="category-grid">
      <a href="{{path .BaseURL "/weather/current"}}" class="category-card">
        <div class="category-icon">🌤️</div>
        <h3 class="category-title">{{t .Lang "page_text.text.current.weather.2c23151233"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.get.current.weather.for.a.location.a767194600"}}</p>
      </a>
      
      <a href="{{path .BaseURL "/weather/forecast"}}" class="category-card">
        <div class="category-icon">📅</div>
        <h3 class="category-title">{{t .Lang "page_text.text.weather.forecast.71a92379ec"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.7.day.weather.forecast.6be341cb54"}}</p>
      </a>
      
      <a href="{{path .BaseURL "/weather/hourly"}}" class="category-card">
        <div class="category-icon">⏰</div>

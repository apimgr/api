{{define "content"}}
<section class="error-section">
    <div class="container container-sm">
        <div class="error-content">
            <div class="error-code">{{.ErrorCode}}</div>
            <h1 class="error-title page-title">{{.ErrorTitle}}</h1>
            <p class="error-message">{{.ErrorMessage}}</p>
            <div class="error-actions">
                <a href="{{path .BaseURL "/"}}" class="btn btn-primary">{{t .Lang "common.go_home"}}</a>
                <button type="button" class="btn btn-secondary" data-back>{{t .Lang "common.go_back"}}</button>
            </div>
        </div>
    </div>
</section>
{{end}}

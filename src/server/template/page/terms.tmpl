{{define "content"}}
<article class="container container-sm">
  <header class="page-header">
    <h1 class="page-title">{{.PageTitle}}</h1>
    <p class="page-lead">{{.SiteTitle}}</p>
  </header>

  <section class="section-card" aria-labelledby="terms-content-heading">
    <h2 id="terms-content-heading">{{t .Lang "page_sections.terms"}}</h2>
    {{.TermsContent}}
  </section>
</article>
{{end}}

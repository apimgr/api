{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/weather">Weather</a> / Historical Weather
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Historical Weather</h1>
        <button class="btn btn-icon" data-favorite="weather-historical" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get historical daily weather (high/low temperature, precipitation,
        max wind speed) for a location over a date range.
      </p>

      <form id="historical-form" class="tool-form" data-template="/api/v1/weather/historical/{location}?start={start}&end={end}">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-input" required placeholder="London, 90210, or 51.5,-0.1">
        </div>

        <div class="form-group">
          <label class="form-label">Start date</label>
          <input type="date" name="start" class="form-input" required value="2024-01-01">
        </div>

        <div class="form-group">
          <label class="form-label">End date</label>
          <input type="date" name="end" class="form-input" required value="2024-01-07">
        </div>

        <button type="submit" class="btn btn-primary">Get Historical Weather</button>
      </form>

      <div id="historical-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/weather/historical/London?start=2024-01-01&end=2024-01-07"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

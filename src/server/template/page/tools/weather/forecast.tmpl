{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/weather"}}">{{t .Lang "categories.weather.name"}}</a> {{t .Lang "tool_pages.text.weather.forecast.bb77f13950"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.weather.forecast.71a92379ec"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="weather-forecast" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.get.a.daily.weather.forecast.1.16.days.defau.5f6fe8ff33"}} <code>?days=</code>
        {{t .Lang "tool_pages.text.to.the.api.url.to.change.the.number.of.days.eb2448a3c8"}}
      </p>

      <form id="forecast-form" class="tool-form" data-template="{{.APIBasePath}}/weather/forecast/{location}" method="post" action="{{path .BaseURL "/weather/forecast"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="forecast-form-location">{{t .Lang "common.location"}}</label>
          <input type="text" name="location" class="form-input" required placeholder="{{t .Lang "common.location_example"}}" id="forecast-form-location">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.get.forecast.b158280ad3"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="forecast-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/weather/forecast/London?days=5"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

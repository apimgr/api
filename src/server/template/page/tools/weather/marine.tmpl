{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/weather">Weather</a> / Marine Conditions
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Marine Conditions</h1>
        <button class="btn btn-icon" data-favorite="weather-marine" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get current marine and ocean conditions (wave height, wave period,
        swell height, ocean current velocity, sea surface temperature) for a
        coastal location. Inland locations return zero-value fields, not an
        error.
      </p>

      <form id="marine-form" class="tool-form" data-template="/api/v1/weather/marine/{location}">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-input" required placeholder="Miami, or 25.7,-80.1">
        </div>

        <button type="submit" class="btn btn-primary">Get Marine Conditions</button>
      </form>

      <div id="marine-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/weather/marine/Miami</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

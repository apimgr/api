{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/weather">Weather</a> / Weather Alerts
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Weather Alerts</h1>
        <button class="btn btn-icon" data-favorite="weather-alerts" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get active government weather alerts and warnings for a location by
        city name, ZIP/postal code, or coordinates. Aggregates and normalizes
        alerts from multiple free, keyless government sources: the US
        National Weather Service, Environment Canada, and MeteoAlarm for
        European countries. Locations outside these coverage areas return an
        empty list, not an error.
      </p>

      <form id="alerts-form" class="tool-form" data-template="/api/v1/weather/alerts/{location}">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-input" required placeholder="London, 90210, or 51.5,-0.1">
        </div>

        <button type="submit" class="btn btn-primary">Get Alerts</button>
      </form>

      <div id="alerts-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/weather/alerts/London</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

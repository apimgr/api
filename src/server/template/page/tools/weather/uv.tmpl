{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/weather">Weather</a> / UV Index
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">UV Index</h1>
        <button class="btn btn-icon" data-favorite="weather-uv" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get the current UV index for a location by city name, ZIP/postal
        code, or coordinates.
      </p>

      <form id="uv-form" class="tool-form" data-template="/api/v1/weather/uv/{location}">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-input" required placeholder="London, 90210, or 51.5,-0.1">
        </div>

        <button type="submit" class="btn btn-primary">Get UV Index</button>
      </form>

      <div id="uv-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/weather/uv/London</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

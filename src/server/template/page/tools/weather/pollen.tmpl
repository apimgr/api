{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/weather">Weather</a> / Pollen Count
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Pollen Count</h1>
        <button class="btn btn-icon" data-favorite="weather-pollen" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get current pollen counts (alder, birch, grass, mugwort, olive,
        ragweed) for a location by city name, ZIP/postal code, or
        coordinates. Coverage is currently limited to Europe by the upstream
        provider; other regions return an explanatory coverage note.
      </p>

      <form id="pollen-form" class="tool-form" data-template="/api/v1/weather/pollen/{location}">
        <div class="form-group">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-input" required placeholder="Berlin, or 52.5,13.4">
        </div>

        <button type="submit" class="btn btn-primary">Get Pollen Count</button>
      </form>

      <div id="pollen-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/weather/pollen/Berlin</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

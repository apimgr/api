{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/language">Language</a> / Dictionary Lookup
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Dictionary Lookup</h1>
        <button class="btn btn-icon" data-favorite="language-dictionary" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up word definitions, phonetics, and parts of speech using the free, keyless Dictionary API.
      </p>

      <form id="dictionary-form" class="tool-form" data-query-post-endpoint="/api/v1/language/dictionary">
        <div class="form-group">
          <label class="form-label">Word</label>
          <input type="text" name="word" class="form-input" required placeholder="serendipity">
        </div>

        <button type="submit" class="btn btn-primary">Look Up</button>
      </form>

      <div id="dictionary-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/language/dictionary?word=serendipity"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/language">Language</a> / Sentiment Analysis
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Sentiment Analysis</h1>
        <button class="btn btn-icon" data-favorite="language-sentiment" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Score text as positive, negative, or neutral using a lexicon-based heuristic.
      </p>

      <form id="sentiment-form" class="tool-form" data-body-endpoint="/api/v1/language/sentiment">
        <div class="form-group">
          <label class="form-label">Text</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="Paste or type text here."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Analyze</button>
      </form>

      <div id="sentiment-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/language/sentiment -d 'Some text to analyze for sentiment.'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

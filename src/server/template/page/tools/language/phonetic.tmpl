{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/language">Language</a> / Phonetic Encoding
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Phonetic Encoding</h1>
        <button class="btn btn-icon" data-favorite="language-phonetic" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate the Soundex and Metaphone phonetic codes for a word.
      </p>

      <form id="phonetic-form" class="tool-form" data-endpoint="/api/v1/language/phonetic">
        <div class="form-group">
          <label class="form-label">Word</label>
          <input type="text" name="word" class="form-input" required value="Robert">
        </div>

        <button type="submit" class="btn btn-primary">Encode</button>
      </form>

      <div id="phonetic-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/language/phonetic?word=Robert"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

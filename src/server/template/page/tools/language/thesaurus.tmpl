{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/language">Language</a> / Thesaurus
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Thesaurus</h1>
        <button class="btn btn-icon" data-favorite="language-thesaurus" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up word synonyms and antonyms using the free, keyless Datamuse API.
      </p>

      <form id="thesaurus-form" class="tool-form" data-query-post-endpoint="/api/v1/language/thesaurus">
        <div class="form-group">
          <label class="form-label">Word</label>
          <input type="text" name="word" class="form-input" required placeholder="happy">
        </div>

        <button type="submit" class="btn btn-primary">Look Up</button>
      </form>

      <div id="thesaurus-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/language/thesaurus?word=happy"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

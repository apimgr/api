{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/language"}}">{{t .Lang "tool_pages.text.language.a4fe65264e"}}</a> {{t .Lang "tool_pages.text.thesaurus.12b409bf54"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.thesaurus.39ee7c3843"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="language-thesaurus" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.word.synonyms.and.antonyms.using.the.1d34c5196c"}}
      </p>

      <form id="thesaurus-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/language/thesaurus" method="post" action="{{path .BaseURL "/language/thesaurus"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="thesaurus-form-word">{{t .Lang "tool_pages.text.word.3a2860ece5"}}</label>
          <input type="text" name="word" class="form-input" required placeholder="{{t .Lang "tool_pages.text.happy.489f719cad"}}" id="thesaurus-form-word">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.look.up.1f435536d8"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="thesaurus-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/language/thesaurus?word=happy"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

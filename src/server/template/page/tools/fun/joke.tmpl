{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/fun">Fun &amp; Content</a> / Random Joke
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Random Joke</h1>
        <button class="btn btn-icon" data-favorite="fun-joke" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get a random joke type paired with a fortune-cookie style saying.
      </p>

      <form id="joke-form" class="tool-form" data-template="/api/v1/fun/joke">
        <button type="submit" class="btn btn-primary">Tell Me One</button>
      </form>

      <div id="joke-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/fun/joke</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/fun">Fun &amp; Content</a> / Compliment Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Compliment Generator</h1>
        <button class="btn btn-icon" data-favorite="fun-compliment" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get a random compliment from the built-in curated collection.
      </p>

      <form id="compliment-form" class="tool-form" data-template="/api/v1/fun/compliment">
        <button type="submit" class="btn btn-primary">Compliment Me</button>
      </form>

      <div id="compliment-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/fun/compliment</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

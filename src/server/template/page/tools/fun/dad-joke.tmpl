{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/fun">Fun &amp; Content</a> / Dad Jokes
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Dad Jokes</h1>
        <button class="btn btn-icon" data-favorite="fun-dad-joke" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get a classic dad joke from the built-in curated collection.
      </p>

      <form id="dad-joke-form" class="tool-form" data-template="/api/v1/fun/dad-joke">
        <button type="submit" class="btn btn-primary">Tell Me One</button>
      </form>

      <div id="dad-joke-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/fun/dad-joke</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

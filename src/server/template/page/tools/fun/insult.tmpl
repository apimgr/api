{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/fun">Fun &amp; Content</a> / Insult Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Insult Generator</h1>
        <button class="btn btn-icon" data-favorite="fun-insult" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get a playful, harmless mock-insult from the built-in curated
        collection.
      </p>

      <form id="insult-form" class="tool-form" data-template="/api/v1/fun/insult">
        <button type="submit" class="btn btn-primary">Insult Me</button>
      </form>

      <div id="insult-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/fun/insult</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

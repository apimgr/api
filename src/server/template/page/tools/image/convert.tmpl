{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/image">Images</a> / Convert Image Format
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Convert Image Format</h1>
        <button class="btn btn-icon" data-favorite="image-convert" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Upload an image and convert it to PNG, JPEG, or GIF.
      </p>

      <form id="convert-form" class="tool-form" method="post" action="/api/v1/image/convert" enctype="multipart/form-data">
        <div class="form-group">
          <label class="form-label" for="convert-image">Image File</label>
          <input type="file" id="convert-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="convert-format">Output Format</label>
          <select id="convert-format" name="format" class="form-input" required>
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/image/convert?format=jpeg" --data-binary @image.png -o converted.jpg</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

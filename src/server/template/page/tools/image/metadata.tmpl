{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/image"}}">{{t .Lang "categories.image.name"}}</a> {{t .Lang "tool_pages.text.image.metadata.bcf61287f6"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.image.metadata.b45c9c79a4"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="image-metadata" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.upload.an.image.and.inspect.its.dimensions.f.104e0a5f70"}}
      </p>

      <form id="metadata-form" class="tool-form" method="post" action="{{path .BaseURL "/image/metadata"}}" enctype="multipart/form-data" data-api-endpoint="{{.APIBasePath}}/image/metadata">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="metadata-image">{{t .Lang "tool_pages.text.image.file.93d41abc35"}}</label>
          <input type="file" id="metadata-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.inspect.e0723a86a5"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/image/metadata" --data-binary @image.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

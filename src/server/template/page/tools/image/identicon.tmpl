{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/image">Images</a> / Identicon
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Generate Identicon</h1>
        <button class="btn btn-icon" data-favorite="image-identicon" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a deterministic identicon image from a seed value's SHA-256 hash.
      </p>

      <form id="identicon-form" class="tool-form" data-image-template="/api/v1/image/identicon">
        <div class="form-group">
          <label class="form-label">Seed</label>
          <input type="text" name="seed" class="form-input" required placeholder="user@example.com">
        </div>

        <div class="form-group">
          <label class="form-label">Size</label>
          <input type="number" name="size" class="form-input" min="1" value="256">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="identicon-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/image/identicon?seed=user@example.com&size=256" -o identicon.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

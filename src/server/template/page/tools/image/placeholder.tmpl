{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/image"}}">{{t .Lang "tool_pages.text.image.tools.09d5d0420e"}}</a> {{t .Lang "tool_pages.text.placeholder.image.4474f2791d"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.placeholder.image.0a473d657e"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="image-placeholder" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.placeholder.image.of.any.size.opt.570ac79a4d"}}
      </p>

      <form id="placeholder-form" class="tool-form" data-image-template="{{.APIBasePath}}/image/placeholder/{width}/{height}" method="post" action="{{path .BaseURL "/image/placeholder"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="placeholder-form-width">{{t .Lang "tool_pages.text.width.3019947b6d"}}</label>
          <input type="number" name="width" class="form-input" required min="1" value="300" id="placeholder-form-width">
        </div>

        <div class="form-group">
          <label class="form-label" for="placeholder-form-height">{{t .Lang "tool_pages.text.height.bfe2eca401"}}</label>
          <input type="number" name="height" class="form-input" required min="1" value="200" id="placeholder-form-height">
        </div>

        <div class="form-group">
          <label class="form-label" for="placeholder-form-format">{{t .Lang "tool_pages.text.format.2f343666aa"}}</label>
          <select name="format" class="form-input" id="placeholder-form-format">
            <option value="">{{t .Lang "tool_pages.text.default.21b111cbfe"}}</option>
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="placeholder-form-bg">{{t .Lang "tool_pages.text.background.color.3e314dafdf"}}</label>
          <input type="text" name="bg" class="form-input" placeholder="{{t .Lang "tool_pages.text.cccccc.f2f3ae25d3"}}" id="placeholder-form-bg">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="placeholder-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/image/placeholder/300/200 -o placeholder.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

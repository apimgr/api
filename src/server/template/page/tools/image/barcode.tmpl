{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/image">Images</a> / Barcode
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Generate Barcode</h1>
        <button class="btn btn-icon" data-favorite="image-barcode" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a 1D barcode image: EAN-13, UPC-A, Code128, or Code39.
      </p>

      <form id="barcode-form" class="tool-form" data-image-template="/api/v1/image/barcode">
        <div class="form-group">
          <label class="form-label">Format</label>
          <select name="format" class="form-input">
            <option value="ean13">EAN-13</option>
            <option value="upca">UPC-A</option>
            <option value="code128">Code128</option>
            <option value="code39">Code39</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Data</label>
          <input type="text" name="data" class="form-input" required placeholder="123456789012">
        </div>

        <div class="form-group">
          <label class="form-label">Width</label>
          <input type="number" name="width" class="form-input" min="1" value="300">
        </div>

        <div class="form-group">
          <label class="form-label">Height</label>
          <input type="number" name="height" class="form-input" min="1" value="100">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="barcode-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/image/barcode?format=code128&data=Hello" -o barcode.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/image">Images</a> / Watermark Image
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Watermark Image</h1>
        <button class="btn btn-icon" data-favorite="image-watermark" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Upload an image and tile a text watermark across it.
      </p>

      <form id="watermark-form" class="tool-form" method="post" action="/api/v1/image/watermark" enctype="multipart/form-data">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="watermark-image">Image File</label>
          <input type="file" id="watermark-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-text">Watermark Text</label>
          <input type="text" id="watermark-text" name="text" class="form-input" required maxlength="40" placeholder="SAMPLE">
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-opacity">Opacity (0-1)</label>
          <input type="number" id="watermark-opacity" name="opacity" class="form-input" min="0.01" max="1" step="0.05" value="0.35">
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-format">Output Format</label>
          <select id="watermark-format" name="format" class="form-input">
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Watermark</button>
      </form>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/image/watermark?text=SAMPLE&amp;opacity=0.35" --data-binary @image.png -o watermarked.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/image"}}">{{t .Lang "categories.image.name"}}</a> {{t .Lang "tool_pages.text.watermark.image.3670c7541f"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.watermark.image.2c870e61ec"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="image-watermark" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.upload.an.image.and.tile.a.text.watermark.ac.37965138c0"}}
      </p>

      <form id="watermark-form" class="tool-form" method="post" action="{{path .BaseURL "/image/watermark"}}" enctype="multipart/form-data" data-api-endpoint="{{.APIBasePath}}/image/watermark">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="watermark-image">{{t .Lang "tool_pages.text.image.file.93d41abc35"}}</label>
          <input type="file" id="watermark-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-text">{{t .Lang "tool_pages.text.watermark.text.e0ee83cbd9"}}</label>
          <input type="text" id="watermark-text" name="text" class="form-input" required maxlength="40" placeholder="SAMPLE">
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-opacity">{{t .Lang "tool_pages.text.opacity.0.1.8f16ee019f"}}</label>
          <input type="number" id="watermark-opacity" name="opacity" class="form-input" min="0.01" max="1" step="0.05" value="0.35">
        </div>

        <div class="form-group">
          <label class="form-label" for="watermark-format">{{t .Lang "tool_pages.text.output.format.ef22a51c86"}}</label>
          <select id="watermark-format" name="format" class="form-input">
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.watermark.3bebd4c4e3"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/image/watermark?text=SAMPLE&amp;opacity=0.35" --data-binary @image.png -o watermarked.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

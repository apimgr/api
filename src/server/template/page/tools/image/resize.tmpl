{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/image"}}">{{t .Lang "categories.image.name"}}</a> {{t .Lang "tool_pages.text.resize.image.561467fcb8"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.resize.image.6cc5dc4897"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="image-resize" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.upload.an.image.and.resize.it.to.a.new.width.3e2afa8261"}}
      </p>

      <form id="resize-form" class="tool-form" method="post" action="{{path .BaseURL "/image/resize"}}" enctype="multipart/form-data" data-api-endpoint="{{.APIBasePath}}/image/resize">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="resize-image">{{t .Lang "tool_pages.text.image.file.93d41abc35"}}</label>
          <input type="file" id="resize-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="resize-width">{{t .Lang "tool_pages.text.width.3019947b6d"}}</label>
          <input type="number" id="resize-width" name="width" class="form-input" min="1" required value="200">
        </div>

        <div class="form-group">
          <label class="form-label" for="resize-height">{{t .Lang "tool_pages.text.height.bfe2eca401"}}</label>
          <input type="number" id="resize-height" name="height" class="form-input" min="1" required value="200">
        </div>

        <div class="form-group">
          <label class="form-label" for="resize-format">{{t .Lang "tool_pages.text.output.format.ef22a51c86"}}</label>
          <select id="resize-format" name="format" class="form-input">
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.resize.2956e06ac0"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/image/resize?width=200&amp;height=200&amp;format=png" --data-binary @image.png -o resized.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

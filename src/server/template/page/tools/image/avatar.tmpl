{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/image">Images</a> / Avatar
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Generate Avatar</h1>
        <button class="btn btn-icon" data-favorite="image-avatar" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate an initials-based avatar image.
      </p>

      <form id="avatar-form" class="tool-form" data-image-template="/api/v1/image/avatar">
        <div class="form-group">
          <label class="form-label">Initials</label>
          <input type="text" name="initials" class="form-input" required maxlength="3" placeholder="AB">
        </div>

        <div class="form-group">
          <label class="form-label">Size</label>
          <input type="number" name="size" class="form-input" min="1" value="128">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="avatar-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/image/avatar?initials=AB&size=128" -o avatar.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

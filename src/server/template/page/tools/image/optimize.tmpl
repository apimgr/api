{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/image"}}">{{t .Lang "categories.image.name"}}</a> {{t .Lang "tool_pages.text.optimize.image.eca64ec4af"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.optimize.image.fac53c1ffe"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="image-optimize" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.upload.an.image.and.re.encode.it.to.reduce.f.ba08690db6"}}
      </p>

      <form id="optimize-form" class="tool-form" method="post" action="{{path .BaseURL "/image/optimize"}}" enctype="multipart/form-data" data-api-endpoint="{{.APIBasePath}}/image/optimize">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="optimize-image">{{t .Lang "tool_pages.text.image.file.93d41abc35"}}</label>
          <input type="file" id="optimize-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="optimize-format">{{t .Lang "tool_pages.text.output.format.ef22a51c86"}}</label>
          <select id="optimize-format" name="format" class="form-input">
            <option value="jpeg">JPEG</option>
            <option value="png">PNG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="optimize-quality">{{t .Lang "tool_pages.text.jpeg.quality.1.100.6a87a93b64"}}</label>
          <input type="number" id="optimize-quality" name="quality" class="form-input" min="1" max="100" value="75">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.optimize.aa5f530acb"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/image/optimize?format=jpeg&amp;quality=75" --data-binary @image.png -o optimized.jpg</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/image">Images</a> / Optimize Image
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Optimize Image</h1>
        <button class="btn btn-icon" data-favorite="image-optimize" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Upload an image and re-encode it to reduce file size. The quality
        setting only affects JPEG output — PNG and GIF have no lossy
        quality knob in Go's standard library, so they are re-encoded with
        fixed lossless compression instead.
      </p>

      <form id="optimize-form" class="tool-form" method="post" action="/api/v1/image/optimize" enctype="multipart/form-data">
        <div class="form-group">
          <label class="form-label" for="optimize-image">Image File</label>
          <input type="file" id="optimize-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="optimize-format">Output Format</label>
          <select id="optimize-format" name="format" class="form-input">
            <option value="jpeg">JPEG</option>
            <option value="png">PNG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="optimize-quality">JPEG Quality (1-100)</label>
          <input type="number" id="optimize-quality" name="quality" class="form-input" min="1" max="100" value="75">
        </div>

        <button type="submit" class="btn btn-primary">Optimize</button>
      </form>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/image/optimize?format=jpeg&amp;quality=75" --data-binary @image.png -o optimized.jpg</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

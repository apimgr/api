{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/image">Images</a> / Crop Image
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Crop Image</h1>
        <button class="btn btn-icon" data-favorite="image-crop" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Upload an image and crop a region out of it.
      </p>

      <form id="crop-form" class="tool-form" method="post" action="/api/v1/image/crop" enctype="multipart/form-data">
        <div class="form-group">
          <label class="form-label" for="crop-image">Image File</label>
          <input type="file" id="crop-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="crop-x">X</label>
          <input type="number" id="crop-x" name="x" class="form-input" required value="0">
        </div>

        <div class="form-group">
          <label class="form-label" for="crop-y">Y</label>
          <input type="number" id="crop-y" name="y" class="form-input" required value="0">
        </div>

        <div class="form-group">
          <label class="form-label" for="crop-width">Width</label>
          <input type="number" id="crop-width" name="width" class="form-input" min="1" required value="100">
        </div>

        <div class="form-group">
          <label class="form-label" for="crop-height">Height</label>
          <input type="number" id="crop-height" name="height" class="form-input" min="1" required value="100">
        </div>

        <div class="form-group">
          <label class="form-label" for="crop-format">Output Format</label>
          <select id="crop-format" name="format" class="form-input">
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Crop</button>
      </form>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/image/crop?x=0&amp;y=0&amp;width=100&amp;height=100&amp;format=png" --data-binary @image.png -o cropped.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

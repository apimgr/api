{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/image">Images</a> / Apply Image Filter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Apply Image Filter</h1>
        <button class="btn btn-icon" data-favorite="image-filter" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Upload an image and apply a grayscale, sepia, invert, blur, brighten, or darken filter.
      </p>

      <form id="filter-form" class="tool-form" method="post" action="/api/v1/image/filter" enctype="multipart/form-data">
        <div class="form-group">
          <label class="form-label" for="filter-image">Image File</label>
          <input type="file" id="filter-image" name="image" class="form-input" accept="image/png,image/jpeg,image/gif" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="filter-name">Filter</label>
          <select id="filter-name" name="name" class="form-input">
            <option value="grayscale">Grayscale</option>
            <option value="sepia">Sepia</option>
            <option value="invert">Invert</option>
            <option value="blur">Blur</option>
            <option value="brighten">Brighten</option>
            <option value="darken">Darken</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="filter-amount">Amount</label>
          <input type="number" id="filter-amount" name="amount" class="form-input" min="0" step="0.1" value="0.3">
        </div>

        <div class="form-group">
          <label class="form-label" for="filter-format">Output Format</label>
          <select id="filter-format" name="format" class="form-input">
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
            <option value="gif">GIF</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Apply Filter</button>
      </form>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/image/filter?name=grayscale&amp;amount=0.3&amp;format=png" --data-binary @image.png -o filtered.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/research"}}">{{t .Lang "tool_pages.text.research.979d6300fd"}}</a> {{t .Lang "tool_pages.text.arxiv.lookup.b9ed1386b9"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.arxiv.lookup.b88c8bef5e"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="research-arxiv" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.an.arxiv.paper.by.id.using.the.free.7b631af52d"}}
      </p>

      <form id="arxiv-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/research/arxiv" method="post" action="{{path .BaseURL "/research/arxiv"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="arxiv-form-id">{{t .Lang "tool_pages.text.arxiv.id.f189c7b854"}}</label>
          <input type="text" name="id" class="form-input" required placeholder="2101.00001" id="arxiv-form-id">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.look.up.1f435536d8"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="arxiv-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/research/arxiv?id=2101.00001"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/research"}}">{{t .Lang "tool_pages.text.research.979d6300fd"}}</a> {{t .Lang "tool_pages.text.isbn.lookup.9879f7a515"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.isbn.lookup.1a01a9eaa1"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="research-isbn" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.book.metadata.by.isbn.using.the.free.e07218df02"}}
      </p>

      <form id="isbn-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/research/isbn" method="post" action="{{path .BaseURL "/research/isbn"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="isbn-form-isbn">ISBN</label>
          <input type="text" name="isbn" class="form-input" required placeholder="978-3-16-148410-0" id="isbn-form-isbn">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.look.up.1f435536d8"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="isbn-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/research/isbn?isbn=978-3-16-148410-0"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/research"}}">{{t .Lang "tool_pages.text.research.979d6300fd"}}</a> {{t .Lang "tool_pages.text.citation.formatter.6a7ccf9e7b"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.citation.formatter.2172c3b895"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="research-citation" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.a.reference.title.author.year.source.2cad2e751e"}}
      </p>

      <form id="citation-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/research/citation" method="post" action="{{path .BaseURL "/research/citation"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="citation-form-body">{{t .Lang "tool_pages.text.reference.json.44ceb72390"}}</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{{t .Lang "tool_pages.text.title.on.the.origin.of.species.author.darwin.45b1c4a2e4"}}' id="citation-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.format.2f343666aa"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="citation-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/research/citation -d '{"title":"On the Origin of Species","author":"Darwin, C.","year":"1859","source":"John Murray","style":"APA"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

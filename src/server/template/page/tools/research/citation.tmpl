{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/research">Research</a> / Citation Formatter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Citation Formatter</h1>
        <button class="btn btn-icon" data-favorite="research-citation" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Format a reference (title, author, year, source) into an APA, MLA, or Chicago style citation.
      </p>

      <form id="citation-form" class="tool-form" data-body-endpoint="/api/v1/research/citation">
        <div class="form-group">
          <label class="form-label">Reference (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"title":"On the Origin of Species","author":"Darwin, C.","year":"1859","source":"John Murray","style":"APA"}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Format</button>
      </form>

      <div id="citation-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/research/citation -d '{"title":"On the Origin of Species","author":"Darwin, C.","year":"1859","source":"John Murray","style":"APA"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

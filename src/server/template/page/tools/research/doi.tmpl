{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/research"}}">{{t .Lang "tool_pages.text.research.979d6300fd"}}</a> {{t .Lang "tool_pages.text.doi.validator.8b467d4ea5"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.doi.validator.6750cd8fdb"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="research-doi" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{tf .Lang "tool_pages.text.validate.doi.description" (dict "url" "https://doi.org")}}
      </p>

      <form id="doi-form" class="tool-form" data-template="{{.APIBasePath}}/research/doi/{doi}" method="post" action="{{path .BaseURL "/research/doi"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="doi-form-doi">DOI</label>
          <input type="text" name="doi" class="form-input" required placeholder="10.1000/182" id="doi-form-doi">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="doi-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/research/doi/10.1000/182</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

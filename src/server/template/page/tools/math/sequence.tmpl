{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/math"}}">{{t .Lang "categories.math.name"}}</a> {{t .Lang "tool_pages.text.sequence.generator.1026cdb992"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.sequence.generator.fab3761674"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="math-sequence" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.an.arithmetic.add.step.each.time.or.46a29a5721"}}
      </p>

      <form id="sequence-form" class="tool-form" data-endpoint="{{.APIBasePath}}/math/sequence" method="post" action="{{path .BaseURL "/math/sequence"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="sequence-form-type">{{t .Lang "tool_pages.text.type.baaddf70fb"}}</label>
          <select name="type" class="form-input" required id="sequence-form-type">
            <option value="arithmetic">{{t .Lang "tool_pages.text.arithmetic.641b3acc71"}}</option>
            <option value="geometric">{{t .Lang "tool_pages.text.geometric.5506501f68"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="sequence-form-start">{{t .Lang "tool_pages.text.start.e4bb9f1ece"}}</label>
          <input type="number" name="start" class="form-input" step="any" required value="1" id="sequence-form-start">
        </div>

        <div class="form-group">
          <label class="form-label" for="sequence-form-step">{{t .Lang "tool_pages.text.step.8e6a6cca7a"}}</label>
          <input type="number" name="step" class="form-input" step="any" required value="2" id="sequence-form-step">
        </div>

        <div class="form-group">
          <label class="form-label" for="sequence-form-count">{{t .Lang "tool_pages.text.count.37bac4952b"}}</label>
          <input type="number" name="count" class="form-input" step="1" min="0" required value="10" id="sequence-form-count">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="sequence-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/math/sequence?type=arithmetic&start=1&step=2&count=10"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

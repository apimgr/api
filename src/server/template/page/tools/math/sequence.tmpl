{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Sequence Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Sequence Generator</h1>
        <button class="btn btn-icon" data-favorite="math-sequence" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate an arithmetic (add step each time) or geometric (multiply by
        step each time) number sequence.
      </p>

      <form id="sequence-form" class="tool-form" data-endpoint="/api/v1/math/sequence">
        <div class="form-group">
          <label class="form-label">Type</label>
          <select name="type" class="form-input" required>
            <option value="arithmetic">Arithmetic</option>
            <option value="geometric">Geometric</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Start</label>
          <input type="number" name="start" class="form-input" step="any" required value="1">
        </div>

        <div class="form-group">
          <label class="form-label">Step</label>
          <input type="number" name="step" class="form-input" step="any" required value="2">
        </div>

        <div class="form-group">
          <label class="form-label">Count</label>
          <input type="number" name="count" class="form-input" step="1" min="0" required value="10">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="sequence-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/sequence?type=arithmetic&start=1&step=2&count=10"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

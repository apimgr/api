{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Trigonometry Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Trigonometry Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-trigonometry" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate the sine, cosine, or tangent of an angle given in radians.
      </p>

      <form id="trigonometry-form" class="tool-form" data-endpoint="/api/v1/math/calculate">
        <div class="form-group">
          <label class="form-label">Operation</label>
          <select name="operation" class="form-input">
            <option value="sin">Sine</option>
            <option value="cos">Cosine</option>
            <option value="tan">Tangent</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">n (radians)</label>
          <input type="number" name="n" class="form-input" step="any" required value="0">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="trigonometry-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/calculate?operation=sin&n=0"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

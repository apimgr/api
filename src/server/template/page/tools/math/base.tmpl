{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Base Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Base Converter</h1>
        <button class="btn btn-icon" data-favorite="math-base" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a number between bases 2-36.
      </p>

      <form id="base-form" class="tool-form" data-endpoint="/api/v1/math/base">
        <div class="form-group">
          <label class="form-label">Number</label>
          <input type="text" name="number" class="form-input" required value="255">
        </div>

        <div class="form-group">
          <label class="form-label">From Base</label>
          <input type="number" name="from_base" class="form-input" step="1" min="2" max="36" required value="10">
        </div>

        <div class="form-group">
          <label class="form-label">To Base</label>
          <input type="number" name="to_base" class="form-input" step="1" min="2" max="36" required value="16">
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="base-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/base?number=255&from_base=10&to_base=16"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

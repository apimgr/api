{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/math"}}">{{t .Lang "categories.math.name"}}</a> {{t .Lang "tool_pages.text.base.converter.a95387235e"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.base.converter.691a3e6354"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="math-base" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.number.between.bases.2.36.98ce69c5f8"}}
      </p>

      <form id="base-form" class="tool-form" data-endpoint="{{.APIBasePath}}/math/base" method="post" action="{{path .BaseURL "/math/base"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="base-form-number">{{t .Lang "tool_pages.text.number.bd82cf1669"}}</label>
          <input type="text" name="number" class="form-input" required value="255" id="base-form-number">
        </div>

        <div class="form-group">
          <label class="form-label" for="base-form-from_base">{{t .Lang "tool_pages.text.from.base.3c882f4df3"}}</label>
          <input type="number" name="from_base" class="form-input" step="1" min="2" max="36" required value="10" id="base-form-from_base">
        </div>

        <div class="form-group">
          <label class="form-label" for="base-form-to_base">{{t .Lang "tool_pages.text.to.base.3eb3bed173"}}</label>
          <input type="number" name="to_base" class="form-input" step="1" min="2" max="36" required value="16" id="base-form-to_base">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="base-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/math/base?number=255&from_base=10&to_base=16"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

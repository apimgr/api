{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Statistics Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Statistics Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-stats" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate the min, max, sum, average, and median of a comma-separated
        list of numbers.
      </p>

      <form id="stats-form" class="tool-form" data-endpoint="/api/v1/math/stats" method="get" action="/api/v1/math/stats">
        <div class="form-group">
          <label class="form-label">Numbers (comma-separated)</label>
          <input type="text" name="numbers" class="form-input" required value="4,8,15,16,23,42">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="stats-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/stats?numbers=4,8,15,16,23,42"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

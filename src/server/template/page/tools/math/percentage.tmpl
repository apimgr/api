{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/math"}}">{{t .Lang "categories.math.name"}}</a> {{t .Lang "tool_pages.text.percentage.calculator.b645a17a67"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.percentage.calculator.a2c6f48151"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="math-percentage" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.a.percentage.of.a.value.a.of.b.or.b0e157b677"}}
      </p>

      <form id="percentage-form" class="tool-form" data-endpoint="{{.APIBasePath}}/math/calculate" method="post" action="{{path .BaseURL "/math/percentage"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="percentage-form-operation">{{t .Lang "tool_pages.text.operation.0f044feb6c"}}</label>
          <select name="operation" class="form-input" id="percentage-form-operation">
            <option value="percentage_of">{{t .Lang "tool_pages.text.percentage.of.a.of.b.8ac2c63c74"}}</option>
            <option value="percentage_change">{{t .Lang "tool_pages.text.percentage.change.a.to.b.a9fc83d238"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="percentage-form-a">a</label>
          <input type="number" name="a" class="form-input" step="any" required value="20" id="percentage-form-a">
        </div>

        <div class="form-group">
          <label class="form-label" for="percentage-form-b">b</label>
          <input type="number" name="b" class="form-input" step="any" required value="150" id="percentage-form-b">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="percentage-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/math/calculate?operation=percentage_of&a=20&b=150"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

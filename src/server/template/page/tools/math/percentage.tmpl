{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Percentage Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Percentage Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-percentage" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate a percentage of a value (a% of b) or the percentage change
        from one value to another (a to b).
      </p>

      <form id="percentage-form" class="tool-form" data-endpoint="/api/v1/math/calculate">
        <div class="form-group">
          <label class="form-label">Operation</label>
          <select name="operation" class="form-input">
            <option value="percentage_of">Percentage of (a% of b)</option>
            <option value="percentage_change">Percentage change (a to b)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">a</label>
          <input type="number" name="a" class="form-input" step="any" required value="20">
        </div>

        <div class="form-group">
          <label class="form-label">b</label>
          <input type="number" name="b" class="form-input" step="any" required value="150">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="percentage-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/calculate?operation=percentage_of&a=20&b=150"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

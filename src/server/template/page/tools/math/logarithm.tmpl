{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Logarithm Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Logarithm Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-logarithm" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate the natural, base-10, or base-2 logarithm of a number.
      </p>

      <form id="logarithm-form" class="tool-form" data-endpoint="/api/v1/math/calculate" method="get" action="/api/v1/math/calculate">
        <div class="form-group">
          <label class="form-label">Operation</label>
          <select name="operation" class="form-input">
            <option value="log">Natural log (ln n)</option>
            <option value="log10">Log base 10</option>
            <option value="log2">Log base 2</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">n</label>
          <input type="number" name="n" class="form-input" step="any" required value="100">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="logarithm-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/calculate?operation=log10&n=100"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

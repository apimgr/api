{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/math"}}">{{t .Lang "categories.math.name"}}</a> {{t .Lang "tool_pages.text.logarithm.calculator.b58e353391"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.logarithm.calculator.d0d9d82f5c"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="math-logarithm" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.the.natural.base.10.or.base.2.loga.f28ea5a04a"}}
      </p>

      <form id="logarithm-form" class="tool-form" data-endpoint="{{.APIBasePath}}/math/calculate" method="post" action="{{path .BaseURL "/math/logarithm"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="logarithm-form-operation">{{t .Lang "tool_pages.text.operation.0f044feb6c"}}</label>
          <select name="operation" class="form-input" id="logarithm-form-operation">
            <option value="log">{{t .Lang "tool_pages.text.natural.log.ln.n.979947d087"}}</option>
            <option value="log10">{{t .Lang "tool_pages.text.log.base.10.d6e04b60e2"}}</option>
            <option value="log2">{{t .Lang "tool_pages.text.log.base.2.11f2a66d85"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="logarithm-form-n">n</label>
          <input type="number" name="n" class="form-input" step="any" required value="100" id="logarithm-form-n">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="logarithm-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/math/calculate?operation=log10&n=100"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

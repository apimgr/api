{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Matrix Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Matrix Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-matrix" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Add, multiply, or find the determinant of matrices. Submit a JSON body
        with <code>operation</code> ("add", "multiply", or "determinant"),
        <code>a</code>, and (for add/multiply) <code>b</code>.
      </p>

      <form id="matrix-form" class="tool-form" data-body-endpoint="/api/v1/math/matrix">
        <div class="form-group">
          <label class="form-label">Request Body (JSON)</label>
          <textarea name="body" class="form-input" rows="8" required placeholder='{"operation":"add","a":[[1,2],[3,4]],"b":[[5,6],[7,8]]}'>{"operation":"add","a":[[1,2],[3,4]],"b":[[5,6],[7,8]]}</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="matrix-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/math/matrix -d '{"operation":"add","a":[[1,2],[3,4]],"b":[[5,6],[7,8]]}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

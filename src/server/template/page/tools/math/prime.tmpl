{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Prime Checker
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Prime Checker</h1>
        <button class="btn btn-icon" data-favorite="math-prime" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Check whether a number is prime.
      </p>

      <form id="prime-form" class="tool-form" data-template="/api/v1/math/prime/{n}">
        <div class="form-group">
          <label class="form-label">n</label>
          <input type="number" name="n" class="form-input" step="1" required value="17">
        </div>

        <button type="submit" class="btn btn-primary">Check</button>
      </form>

      <div id="prime-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/math/prime/17</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / Fibonacci Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Fibonacci Generator</h1>
        <button class="btn btn-icon" data-favorite="math-fibonacci" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate the first N numbers of the Fibonacci sequence.
      </p>

      <form id="fibonacci-form" class="tool-form" data-endpoint="/api/v1/math/fibonacci" method="get" action="/api/v1/math/fibonacci">
        <div class="form-group">
          <label class="form-label">Count</label>
          <input type="number" name="count" class="form-input" step="1" min="0" required value="10">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="fibonacci-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/fibonacci?count=10"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

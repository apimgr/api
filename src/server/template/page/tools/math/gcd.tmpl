{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/math"}}">{{t .Lang "categories.math.name"}}</a> {{t .Lang "tool_pages.text.gcd.calculator.3f6a4c3f2c"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.gcd.calculator.20aa5fbf79"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="math-gcd" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.find.the.greatest.common.divisor.of.two.inte.221f774d01"}}
      </p>

      <form id="gcd-form" class="tool-form" data-endpoint="{{.APIBasePath}}/math/calculate" method="post" action="{{path .BaseURL "/math/gcd"}}">
        {{csrfField .CSRFToken}}
        <input type="hidden" name="operation" value="gcd">

        <div class="form-group">
          <label class="form-label" for="gcd-form-a">a</label>
          <input type="number" name="a" class="form-input" step="1" required value="12" id="gcd-form-a">
        </div>

        <div class="form-group">
          <label class="form-label" for="gcd-form-b">b</label>
          <input type="number" name="b" class="form-input" step="1" required value="18" id="gcd-form-b">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="gcd-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/math/calculate?operation=gcd&a=12&b=18"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

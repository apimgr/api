{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/math">Math &amp; Numbers</a> / GCD Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">GCD Calculator</h1>
        <button class="btn btn-icon" data-favorite="math-gcd" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Find the greatest common divisor of two integers.
      </p>

      <form id="gcd-form" class="tool-form" data-endpoint="/api/v1/math/calculate" method="get" action="/api/v1/math/calculate">
        <input type="hidden" name="operation" value="gcd">

        <div class="form-group">
          <label class="form-label">a</label>
          <input type="number" name="a" class="form-input" step="1" required value="12">
        </div>

        <div class="form-group">
          <label class="form-label">b</label>
          <input type="number" name="b" class="form-input" step="1" required value="18">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="gcd-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/math/calculate?operation=gcd&a=12&b=18"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/testing"}}">{{t .Lang "categories.testing.name"}}</a> {{t .Lang "tool_pages.text.fake.data.generator.50c9be9ca2"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.fake.data.generator.42ee985ce6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="testing-fake-data" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.fake.test.email.username.or.full.efef10dd82"}}
      </p>

      <form id="fake-data-form" class="tool-form" data-endpoint="{{.APIBasePath}}/test/fake-data" method="post" action="{{path .BaseURL "/testing/fake-data"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="fake-data-form-type">{{t .Lang "tool_pages.text.type.baaddf70fb"}}</label>
          <select name="type" class="form-input" id="fake-data-form-type">
            <option value="user" selected>{{t .Lang "tool_pages.text.user.04f8996da7"}}</option>
            <option value="email">{{t .Lang "tool_pages.text.email.82244417f9"}}</option>
            <option value="username">{{t .Lang "tool_pages.text.username.16f78a7d63"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="fake-data-form-prefix">{{t .Lang "tool_pages.text.prefix.74feac5eb8"}}</label>
          <input type="text" name="prefix" class="form-input" placeholder="{{t .Lang "tool_pages.text.test.9f86d08188"}}" value="test" id="fake-data-form-prefix">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="fake-data-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/test/fake-data?type=user&prefix=test"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

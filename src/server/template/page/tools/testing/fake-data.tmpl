{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / Fake Data Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Fake Data Generator</h1>
        <button class="btn btn-icon" data-favorite="testing-fake-data" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a fake test email, username, or full mock user for use in
        test suites and fixtures.
      </p>

      <form id="fake-data-form" class="tool-form" data-endpoint="/api/v1/test/fake-data" method="get" action="/api/v1/test/fake-data">
        <div class="form-group">
          <label class="form-label">Type</label>
          <select name="type" class="form-input">
            <option value="user" selected>user</option>
            <option value="email">email</option>
            <option value="username">username</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Prefix</label>
          <input type="text" name="prefix" class="form-input" placeholder="test" value="test">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="fake-data-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/test/fake-data?type=user&prefix=test"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

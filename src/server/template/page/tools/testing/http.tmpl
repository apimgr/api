{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / Mock HTTP Response
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Mock HTTP Response</h1>
        <button class="btn btn-icon" data-favorite="testing-http" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a mock API response fixture and measure how long it took to
        build, useful for testing client-side response handling.
      </p>

      <form id="http-form" class="tool-form" data-template="/api/v1/test/http">
        <button type="submit" class="btn btn-primary">Run</button>
      </form>

      <div id="http-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/test/http</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / curl Command Generator
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">curl Command Generator</h1>
        <button class="btn btn-icon" data-favorite="testing-curl-generator" title="Add to favorites">⭐</button>
      </div>
      <p class="tool-description">
        Describe an HTTP request (method, URL, headers, body) and get back a single
        ready-to-run curl command.
      </p>
      <form id="curl-generator-form" class="tool-form" data-body-endpoint="/api/v1/test/curl-generator">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"method":"POST","url":"https://example.com/api","headers":{"Content-Type":"application/json"},"body":"{\"key\":\"value\"}"}'></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Generate</button>
      </form>
      <div id="curl-generator-form-result" class="tool-result" hidden></div>
      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/test/curl-generator -d '{"method":"GET","url":"https://example.com/api"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / Webhook Inspector
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Webhook Inspector</h1>
        <button class="btn btn-icon" data-favorite="testing-webhook" title="Add to favorites">⭐</button>
      </div>
      <p class="tool-description">
        POST a payload and get back an inspection of its headers and body in the same
        response. Nothing is stored — this is a same-request echo, not a persistent
        webhook receiver.
      </p>
      <form id="webhook-form" class="tool-form" data-body-endpoint="/api/v1/test/webhook">
        <div class="form-group">
          <label class="form-label">Payload (raw body)</label>
          <textarea name="body" class="form-input" rows="6" placeholder='{"event":"example","data":{}}'></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
      <div id="webhook-form-result" class="tool-result" hidden></div>
      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/test/webhook -d '{"event":"example"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / Test Fixture Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Test Fixture Generator</h1>
        <button class="btn btn-icon" data-favorite="testing-fixtures" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a named test fixture. Built-in types are "user" and
        "api_response"; any other type returns a minimal tagged fixture.
      </p>

      <form id="fixtures-form" class="tool-form" data-template="/api/v1/test/fixture/{type}">
        <div class="form-group">
          <label class="form-label">Fixture Type</label>
          <input type="text" name="type" class="form-input" required placeholder="user" value="user">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="fixtures-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/test/fixture/user</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

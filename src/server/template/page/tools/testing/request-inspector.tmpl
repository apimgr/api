{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/testing"}}">{{t .Lang "categories.testing.name"}}</a> {{t .Lang "tool_pages.text.request.inspector.ce01a1dc80"}}
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.request.inspector.c0afdc97ad"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="testing-request-inspector" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>
      <p class="tool-description">
        {{t .Lang "tool_pages.text.inspect.the.method.path.query.parameters.hea.c7dbd68592"}}
      </p>
      <form id="request-inspector-form" class="tool-form" data-template="{{.APIBasePath}}/test/request-inspector" method="post" action="{{path .BaseURL "/testing/request-inspector"}}">
        {{csrfField .CSRFToken}}
        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.inspect.e0723a86a5"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}
      <div id="request-inspector-form-result" class="tool-result" hidden></div>
      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/test/request-inspector</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

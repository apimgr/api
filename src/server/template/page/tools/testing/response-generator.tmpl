{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / Mock Response Generator
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Mock Response Generator</h1>
        <button class="btn btn-icon" data-favorite="testing-response-generator" title="Add to favorites">⭐</button>
      </div>
      <p class="tool-description">
        Generate a mock API response fixture for use in client-side testing.
      </p>
      <form id="response-generator-form" class="tool-form" data-template="/api/v1/test/response-generator">
        <button type="submit" class="btn btn-primary">Generate</button>
      </form>
      <div id="response-generator-form-result" class="tool-result" style="display:none;"></div>
      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/test/response-generator</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

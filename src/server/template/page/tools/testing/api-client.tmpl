{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/testing">Testing Tools</a> / API Client Code Generator
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">API Client Code Generator</h1>
        <button class="btn btn-icon" data-favorite="testing-api-client" title="Add to favorites">⭐</button>
      </div>
      <p class="tool-description">
        Describe an HTTP request and generate ready-to-run client code in curl,
        JavaScript, Python, and Go.
      </p>
      <form id="api-client-form" class="tool-form" data-body-endpoint="/api/v1/test/api-client">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"method":"GET","url":"https://example.com/api","headers":{"Accept":"application/json"},"body":""}'></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Generate</button>
      </form>
      <div id="api-client-form-result" class="tool-result" hidden></div>
      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/test/api-client -d '{"method":"GET","url":"https://example.com/api"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

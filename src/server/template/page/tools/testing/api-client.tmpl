{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/testing"}}">{{t .Lang "categories.testing.name"}}</a> {{t .Lang "tool_pages.text.api.client.code.generator.e09a19070b"}}
    </nav>
    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.api.client.code.generator.5706d69ba7"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="testing-api-client" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>
      <p class="tool-description">
        {{t .Lang "tool_pages.text.describe.an.http.request.and.generate.ready.826b475722"}}
      </p>
      <form id="api-client-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/test/api-client" method="post" action="{{path .BaseURL "/testing/api-client"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="api-client-form-body">{{t .Lang "tool_pages.text.request.json.0e9d4c0115"}}</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"method":"GET","url":"https://example.com/api","headers":{"Accept":"application/json"},"body":""}' id="api-client-form-body"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}
      <div id="api-client-form-result" class="tool-result" hidden></div>
      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/test/api-client -d '{"method":"GET","url":"https://example.com/api"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

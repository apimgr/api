{{define "content"}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.password.generator.674658cf40"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.password.generator.7bec027afa"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-password" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.secure.random.passwords.with.custom.894a076f87"}}
      </p>

      <form id="password-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/password/{length}.txt" method="post" action="{{path .BaseURL "/crypto/password"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="password-form-length">{{t .Lang "tool_pages.text.length.adc95605a1"}}</label>
          <input type="number" name="length" class="form-input" value="16" min="8" max="128" id="password-form-length">
        </div>

        <div class="form-group">
          <label class="toggle" for="password-form-uppercase">
            <input type="checkbox" name="uppercase" checked id="password-form-uppercase">
            <span class="slider"></span>
            {{t .Lang "tool_pages.text.include.uppercase.a.z.d4e60c3e5c"}}
          </label>
        </div>

        <div class="form-group">
          <label class="toggle" for="password-form-lowercase">
            <input type="checkbox" name="lowercase" checked id="password-form-lowercase">
            <span class="slider"></span>
            {{t .Lang "tool_pages.text.include.lowercase.a.z.fa5ae490c6"}}
          </label>
        </div>

        <div class="form-group">
          <label class="toggle" for="password-form-numbers">
            <input type="checkbox" name="numbers" checked id="password-form-numbers">
            <span class="slider"></span>
            {{t .Lang "tool_pages.text.include.numbers.0.9.006fa4e7d4"}}
          </label>
        </div>

        <div class="form-group">
          <label class="toggle" for="password-form-symbols">
            <input type="checkbox" name="symbols" checked id="password-form-symbols">
            <span class="slider"></span>
            {{t .Lang "tool_pages.text.include.symbols.9782c03e50"}}
          </label>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.generate.password.fdcbfcc785"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="password-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy>{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/password
curl {{.BaseURL}}{{.APIBasePath}}/crypto/password/24.txt</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}

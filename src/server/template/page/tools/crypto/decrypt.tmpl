{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / AES Decrypt
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">AES Decrypt</h1>
        <button class="btn btn-icon" data-favorite="crypto-decrypt" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Decrypt AES-256-GCM ciphertext produced by the AES Encrypt tool, using the
        same passphrase that was used to encrypt it.
      </p>

      <form id="decrypt-form" class="tool-form" data-body-endpoint="/api/v1/crypto/decrypt">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="4" required placeholder='{"ciphertext":"...","key":"correct horse battery staple"}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Decrypt</button>
      </form>

      <div id="decrypt-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/crypto/decrypt -d '{"ciphertext":"...","key":"correct horse battery staple"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.bcrypt.hash.0ed6f4255a"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.bcrypt.hash.51b6d87dd0"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-bcrypt" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.hash.a.password.using.bcrypt.with.a.configur.b623ff7018"}}
      </p>

      <form id="bcrypt-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/bcrypt/{cost}/{password}" method="post" action="{{path .BaseURL "/crypto/bcrypt"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="bcrypt-form-password">{{t .Lang "users.registration.password"}}</label>
          <input type="text" name="password" class="form-input" required placeholder="{{t .Lang "tool_pages.text.password.to.hash.ab2258aeea"}}" id="bcrypt-form-password">
        </div>

        <div class="form-group">
          <label class="form-label" for="bcrypt-form-cost">{{t .Lang "tool_pages.text.cost.204a5eb2cd"}}</label>
          <input type="number" name="cost" class="form-input" value="12" min="4" max="31" id="bcrypt-form-cost">
          <span class="form-help">{{t .Lang "tool_pages.text.higher.cost.is.slower.but.more.secure.defaul.fce9022364"}}</span>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.generate.hash.2011743a57"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="bcrypt-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/bcrypt/12/hunter2</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

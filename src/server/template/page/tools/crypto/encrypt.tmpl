{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / AES Encrypt
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">AES Encrypt</h1>
        <button class="btn btn-icon" data-favorite="crypto-encrypt" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Encrypt text with AES-256-GCM. The key you supply is passed through Argon2id
        to derive the encryption key; the random salt and nonce are embedded in the
        output, so the same passphrase always decrypts it.
      </p>

      <form id="encrypt-form" class="tool-form" data-body-endpoint="/api/v1/crypto/encrypt">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="4" required placeholder='{"plaintext":"Hello World","key":"correct horse battery staple"}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Encrypt</button>
      </form>

      <div id="encrypt-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/crypto/encrypt -d '{"plaintext":"Hello World","key":"correct horse battery staple"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

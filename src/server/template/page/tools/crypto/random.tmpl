{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / Random Bytes
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Random Bytes</h1>
        <button class="btn btn-icon" data-favorite="crypto-random" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate cryptographically secure random bytes, returned as both raw byte values and hex encoding.
      </p>

      <form id="random-form" class="tool-form" data-template="/api/v1/crypto/random/bytes/{count}">
        <div class="form-group">
          <label class="form-label">Byte Count</label>
          <input type="number" name="count" class="form-input" min="1" max="1024" value="32" required>
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="random-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/crypto/random/bytes/32</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

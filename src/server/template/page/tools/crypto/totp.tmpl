{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.totp.generator.122d5d430d"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.totp.generator.8ae848fe42"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-totp" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.time.based.one.time.password.totp.71196e293a"}}
      </p>

      <form id="totp-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/totp/generate?issuer={issuer}&account={account}" method="post" action="{{path .BaseURL "/crypto/totp"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="totp-form-issuer">{{t .Lang "tool_pages.text.issuer.39e02c46a0"}}</label>
          <input type="text" name="issuer" class="form-input" placeholder="{{t .Lang "tool_pages.text.castools.cfac1af77b"}}" id="totp-form-issuer">
        </div>

        <div class="form-group">
          <label class="form-label" for="totp-form-account">{{t .Lang "tool_pages.text.account.7e1b0d5641"}}</label>
          <input type="text" name="account" class="form-input" placeholder="user@example.com" id="totp-form-account">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="totp-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/totp/generate?issuer=CasTools&account=user@example.com</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

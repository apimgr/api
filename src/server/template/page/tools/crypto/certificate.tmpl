{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.x.509.certificate.e45e1d3f27"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.x.509.certificate.8079727cb6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-certificate" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.self.signed.x.509.certificate.for.7bd6fb3500"}}
      </p>

      <form id="certificate-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/crypto/certificate" method="post" action="{{path .BaseURL "/crypto/certificate"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="certificate-form-body">{{t .Lang "tool_pages.text.request.json.0e9d4c0115"}}</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"mode":"generate","common_name":"example.com","valid_days":365}' id="certificate-form-body"></textarea>
          <span class="form-help">{{t .Lang "tool_pages.text.mode.is.one.of.generate.needs.common.name.op.51a0db8a32"}}</span>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.run.00d60e31a4"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="certificate-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/crypto/certificate -d '{"mode":"generate","common_name":"example.com","valid_days":365}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / X.509 Certificate
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">X.509 Certificate</h1>
        <button class="btn btn-icon" data-favorite="crypto-certificate" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a self-signed X.509 certificate for local development/testing,
        or parse an existing PEM certificate's subject, issuer, and validity.
      </p>

      <form id="certificate-form" class="tool-form" data-body-endpoint="/api/v1/crypto/certificate">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"mode":"generate","common_name":"example.com","valid_days":365}'></textarea>
          <span class="form-help">mode is one of generate (needs common_name, optional valid_days) or parse (needs certificate)</span>
        </div>

        <button type="submit" class="btn btn-primary">Run</button>
      </form>

      <div id="certificate-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/crypto/certificate -d '{"mode":"generate","common_name":"example.com","valid_days":365}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.jwt.decoder.30e22d7bd0"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.jwt.decoder.5d8e231d4f"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-jwt" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.decode.and.inspect.json.web.tokens.jwt.view.166984ef29"}}
      </p>

      <form id="jwt-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/jwt/{token}" method="post" action="{{path .BaseURL "/crypto/jwt"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="jwt-form-token">{{t .Lang "tool_pages.text.jwt.token.3c3ae1e761"}}</label>
          <textarea name="token" class="form-input" rows="5" required placeholder="{{t .Lang "tool_pages.text.eyjhbgcioijiuzi1niisinr5cci6ikpxvcj9.7d78120168"}}" id="jwt-form-token"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.decode.1ae3fcff1a"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="jwt-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/jwt/eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjMifQ.signature</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

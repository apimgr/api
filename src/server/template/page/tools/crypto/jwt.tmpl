{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / JWT Decoder
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">JWT Decoder</h1>
        <button class="btn btn-icon" data-favorite="crypto-jwt" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Decode and inspect JSON Web Tokens (JWT). View header, payload, and signature details.
        This is a read-only decoder — the signature is shown but never verified.
      </p>

      <form id="jwt-form" class="tool-form" data-template="/api/v1/crypto/jwt/{token}">
        <div class="form-group">
          <label class="form-label">JWT Token</label>
          <textarea name="token" class="form-input" rows="5" required placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Decode</button>
      </form>

      <div id="jwt-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/crypto/jwt/eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjMifQ.signature</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

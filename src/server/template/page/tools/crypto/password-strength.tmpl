{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.password.strength.checker.3f7ee048b1"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.password.strength.checker.fbd0dbf87e"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-password-strength" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.check.the.estimated.strength.of.a.password.b.08157b1a0a"}}
      </p>

      <form id="password-strength-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/password/strength/{password}" method="post" action="{{path .BaseURL "/crypto/password-strength"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="password-strength-form-password">{{t .Lang "users.registration.password"}}</label>
          <input type="text" name="password" class="form-input" required placeholder="{{t .Lang "tool_pages.text.password.to.check.a2a2f3d3fe"}}" id="password-strength-form-password">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.check.strength.c380a74ea6"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="password-strength-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/password/strength/hunter2</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

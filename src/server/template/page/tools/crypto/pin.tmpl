{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.pin.generator.365a9e38dd"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.pin.generator.dc72773f52"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-pin" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.random.numeric.pin.of.a.given.len.8169faa949"}}
      </p>

      <form id="pin-form" class="tool-form" data-template="{{.APIBasePath}}/crypto/pin/{length}.txt" method="post" action="{{path .BaseURL "/crypto/pin"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="pin-form-length">{{t .Lang "tool_pages.text.length.adc95605a1"}}</label>
          <input type="number" name="length" class="form-input" value="6" min="1" max="20" id="pin-form-length">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.generate.pin.70bec135f0"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="pin-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/pin/6</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

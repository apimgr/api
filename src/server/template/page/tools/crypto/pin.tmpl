{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / PIN Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">PIN Generator</h1>
        <button class="btn btn-icon" data-favorite="crypto-pin" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a random numeric PIN of a given length using a cryptographically
        secure random source.
      </p>

      <form id="pin-form" class="tool-form" data-template="/api/v1/crypto/pin/{length}.txt">
        <div class="form-group">
          <label class="form-label">Length</label>
          <input type="number" name="length" class="form-input" value="6" min="1" max="20">
        </div>

        <button type="submit" class="btn btn-primary">Generate PIN</button>
      </form>

      <div id="pin-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/crypto/pin/6</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

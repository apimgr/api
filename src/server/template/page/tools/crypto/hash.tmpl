{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/crypto">Crypto</a> / Hash Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Hash Generator</h1>
        <button class="btn btn-icon" data-favorite="crypto-hash" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate cryptographic hashes using various algorithms (MD5, SHA-1, SHA-256, SHA-512, BLAKE3).
      </p>

      <form id="hash-form" class="tool-form" data-template="/api/v1/crypto/hash/{algorithm}/{input}">
        <div class="form-group">
          <label class="form-label">Input Text</label>
          <input type="text" name="input" class="form-input" required placeholder="Hello World">
        </div>

        <div class="form-group">
          <label class="form-label">Algorithm</label>
          <select name="algorithm" class="form-input">
            <option value="md5">MD5</option>
            <option value="sha1">SHA-1</option>
            <option value="sha256" selected>SHA-256</option>
            <option value="sha512">SHA-512</option>
            <option value="blake3">BLAKE3</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Generate Hash</button>
      </form>

      <div id="hash-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/crypto/hash/sha256/Hello%20World</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/crypto"}}">{{t .Lang "tool_pages.text.crypto.df12b8f89b"}}</a> {{t .Lang "tool_pages.text.hmac.generator.ba61e0937a"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.hmac.generator.a0066c34f0"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="crypto-hmac" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.compute.an.hmac.sha.1.or.sha.256.of.a.messag.5bf7b90de2"}}
      </p>

      <form id="hmac-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/crypto/hmac" method="post" action="{{path .BaseURL "/crypto/hmac"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="hmac-form-body">{{t .Lang "tool_pages.text.request.json.0e9d4c0115"}}</label>
          <textarea name="body" class="form-input" rows="4" required placeholder='{{t .Lang "tool_pages.text.algorithm.sha256.key.secret.message.hello.wo.254e79e033"}}' id="hmac-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="hmac-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/crypto/hmac -d '{"algorithm":"sha256","key":"secret","message":"Hello World"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

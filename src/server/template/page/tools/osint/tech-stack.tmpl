{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/osint"}}">{{t .Lang "categories.osint.name"}}</a> {{t .Lang "tool_pages.text.tech.stack.detection.772faeaa1a"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.tech.stack.detection.6084bb1a1a"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="osint-tech-stack" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.detect.web.server.framework.and.cms.signatur.96f35bc580"}}
      </p>

      <form id="tech-stack-form" class="tool-form" data-endpoint="{{.APIBasePath}}/osint/tech-stack" method="post" action="{{path .BaseURL "/osint/tech-stack"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="tech-stack-form-url">URL</label>
          <input type="text" name="url" class="form-input" required placeholder="https://example.com" id="tech-stack-form-url">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.detect.7f083fe98c"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="tech-stack-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/osint/tech-stack?url=https://example.com"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

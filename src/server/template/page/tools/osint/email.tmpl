{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/osint">OSINT Tools</a> / Email Intelligence
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Email Intelligence</h1>
        <button class="btn btn-icon" data-favorite="osint-email" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Validate an email address's format and check whether its domain has
        mail-exchange (MX) records.
      </p>

      <form id="email-form" class="tool-form" data-template="/api/v1/osint/email/{email}">
        <div class="form-group">
          <label class="form-label">Email address</label>
          <input type="text" name="email" class="form-input" required placeholder="user@example.com">
        </div>

        <button type="submit" class="btn btn-primary">Investigate</button>
      </form>

      <div id="email-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/osint/email/user@example.com</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

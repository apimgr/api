{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/osint"}}">{{t .Lang "categories.osint.name"}}</a> {{t .Lang "tool_pages.text.subdomain.discovery.acc1d2bf1f"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.subdomain.discovery.fda09a7a90"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="osint-subdomain" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.discover.subdomains.of.a.domain.by.resolving.b34e4c0394"}}
      </p>

      <form id="subdomain-form" class="tool-form" data-template="{{.APIBasePath}}/osint/subdomain/{domain}" method="post" action="{{path .BaseURL "/osint/subdomain"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="subdomain-form-domain">{{t .Lang "tool_pages.text.domain.79fa33618d"}}</label>
          <input type="text" name="domain" class="form-input" required placeholder="example.com" id="subdomain-form-domain">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.discover.d4a33d5b78"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="subdomain-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/osint/subdomain/example.com</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

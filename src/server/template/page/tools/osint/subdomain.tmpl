{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/osint">OSINT Tools</a> / Subdomain Discovery
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Subdomain Discovery</h1>
        <button class="btn btn-icon" data-favorite="osint-subdomain" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Discover subdomains of a domain by resolving a fixed list of common
        subdomain labels through the system DNS resolver.
      </p>

      <form id="subdomain-form" class="tool-form" data-template="/api/v1/osint/subdomain/{domain}">
        <div class="form-group">
          <label class="form-label">Domain</label>
          <input type="text" name="domain" class="form-input" required placeholder="example.com">
        </div>

        <button type="submit" class="btn btn-primary">Discover</button>
      </form>

      <div id="subdomain-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/osint/subdomain/example.com</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

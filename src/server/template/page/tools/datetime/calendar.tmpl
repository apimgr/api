{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.calendar.344ae56a77"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.calendar.d5d0a30b51"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-calendar" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.week.grid.calendar.sunday.start.f.9f3146c6db"}}
      </p>

      <form id="calendar-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/calendar/{year}/{month}" method="post" action="{{path .BaseURL "/datetime/calendar"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="calendar-form-year">{{t .Lang "tool_pages.text.year.89f6832560"}}</label>
          <input type="number" name="year" class="form-input" required value="2024" id="calendar-form-year">
        </div>

        <div class="form-group">
          <label class="form-label" for="calendar-form-month">{{t .Lang "tool_pages.text.month.310ca503ef"}}</label>
          <input type="number" name="month" class="form-input" required min="1" max="12" value="1" id="calendar-form-month">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="calendar-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/calendar/2024/1</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

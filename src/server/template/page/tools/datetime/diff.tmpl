{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/datetime">Date/Time Tools</a> / Timestamp Diff
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Timestamp Diff</h1>
        <button class="btn btn-icon" data-favorite="datetime-diff" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Compute the difference between two Unix timestamps.
      </p>

      <form id="diff-form" class="tool-form" data-template="/api/v1/datetime/diff/{timestamp1}/{timestamp2}">
        <div class="form-group">
          <label class="form-label">First timestamp</label>
          <input type="number" name="timestamp1" class="form-input" required placeholder="1700000000">
        </div>

        <div class="form-group">
          <label class="form-label">Second timestamp</label>
          <input type="number" name="timestamp2" class="form-input" required placeholder="1700086400">
        </div>

        <button type="submit" class="btn btn-primary">Diff</button>
      </form>

      <div id="diff-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/diff/1700000000/1700086400</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

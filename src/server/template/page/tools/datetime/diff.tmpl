{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "tool_pages.text.date.time.tools.0432ab3fde"}}</a> {{t .Lang "tool_pages.text.timestamp.diff.ff11c913c4"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.timestamp.diff.3938f98caf"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-diff" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.compute.the.difference.between.two.unix.time.25aeee5c19"}}
      </p>

      <form id="diff-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/diff/{timestamp1}/{timestamp2}" method="post" action="{{path .BaseURL "/datetime/diff"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="diff-form-timestamp1">{{t .Lang "tool_pages.text.first.timestamp.d104c0110a"}}</label>
          <input type="number" name="timestamp1" class="form-input" required placeholder="1700000000" id="diff-form-timestamp1">
        </div>

        <div class="form-group">
          <label class="form-label" for="diff-form-timestamp2">{{t .Lang "tool_pages.text.second.timestamp.d185346b76"}}</label>
          <input type="number" name="timestamp2" class="form-input" required placeholder="1700086400" id="diff-form-timestamp2">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.diff.7ecf462845"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="diff-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/diff/1700000000/1700086400</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/datetime">Date/Time Tools</a> / Convert Timestamp
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Convert Timestamp</h1>
        <button class="btn btn-icon" data-favorite="datetime-convert" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a Unix timestamp to a human-readable date/time in any timezone.
      </p>

      <form id="convert-form" class="tool-form" data-template="/api/v1/datetime/convert/{timestamp}/{timezone}">
        <div class="form-group">
          <label class="form-label">Unix timestamp</label>
          <input type="number" name="timestamp" class="form-input" required placeholder="1700000000">
        </div>

        <div class="form-group">
          <label class="form-label">Timezone</label>
          <input type="text" name="timezone" class="form-input" required value="UTC" placeholder="UTC">
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="convert-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/convert/1700000000/UTC</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.date.formatter.f6f77e1369"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.date.formatter.088c43680c"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-format" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.a.unix.timestamp.using.a.named.format.18b35aef83"}}
      </p>

      <form id="format-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/format/{timestamp}/{format}" method="post" action="{{path .BaseURL "/datetime/format"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="format-form-timestamp">{{t .Lang "tool_pages.text.unix.timestamp.57c536372f"}}</label>
          <input type="number" name="timestamp" class="form-input" required value="1700000000" id="format-form-timestamp">
        </div>

        <div class="form-group">
          <label class="form-label" for="format-form-format">{{t .Lang "tool_pages.text.format.2f343666aa"}}</label>
          <select name="format" class="form-input" id="format-form-format">
            <option value="iso8601">ISO 8601</option>
            <option value="rfc3339">RFC 3339</option>
            <option value="rfc1123">RFC 1123</option>
            <option value="rfc822">RFC 822</option>
            <option value="kitchen">{{t .Lang "tool_pages.text.kitchen.d98e82ae3c"}}</option>
            <option value="date">{{t .Lang "tool_pages.text.date.only.3280b0a1d4"}}</option>
            <option value="time">{{t .Lang "tool_pages.text.time.only.1fb56c43d4"}}</option>
            <option value="datetime">{{t .Lang "tool_pages.text.date.and.time.a079c3bbe2"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.format.2f343666aa"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/format/1700000000/iso8601</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

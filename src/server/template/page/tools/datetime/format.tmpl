{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/datetime">Date & Time</a> / Date Formatter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Date Formatter</h1>
        <button class="btn btn-icon" data-favorite="datetime-format" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Format a Unix timestamp using a named format (iso8601, rfc3339,
        rfc1123, rfc822, kitchen, date, time, datetime) or a literal Go
        reference-time layout string.
      </p>

      <form id="format-form" class="tool-form" data-template="/api/v1/datetime/format/{timestamp}/{format}">
        <div class="form-group">
          <label class="form-label">Unix timestamp</label>
          <input type="number" name="timestamp" class="form-input" required value="1700000000">
        </div>

        <div class="form-group">
          <label class="form-label">Format</label>
          <select name="format" class="form-input">
            <option value="iso8601">ISO 8601</option>
            <option value="rfc3339">RFC 3339</option>
            <option value="rfc1123">RFC 1123</option>
            <option value="rfc822">RFC 822</option>
            <option value="kitchen">Kitchen</option>
            <option value="date">Date only</option>
            <option value="time">Time only</option>
            <option value="datetime">Date and time</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Format</button>
      </form>

      <div id="format-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/format/1700000000/iso8601</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

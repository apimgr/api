{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "tool_pages.text.date.time.tools.0432ab3fde"}}</a> {{t .Lang "tool_pages.text.to.unix.timestamp.e37b7e1f32"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.to.unix.timestamp.87b38601c4"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-unix" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.human.readable.date.time.string.to.ab3dc49bfa"}}
      </p>

      <form id="unix-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/to-unix/{datetime}" method="post" action="{{path .BaseURL "/datetime/unix"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="unix-form-datetime">{{t .Lang "tool_pages.text.date.time.ec061bd3b8"}}</label>
          <input type="text" name="datetime" class="form-input" required placeholder="2024-01-15T10:00:00Z" id="unix-form-datetime">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="unix-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/to-unix/2024-01-15T10:00:00Z</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/datetime">Date/Time Tools</a> / To Unix Timestamp
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">To Unix Timestamp</h1>
        <button class="btn btn-icon" data-favorite="datetime-unix" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a human-readable date/time string to a Unix timestamp.
      </p>

      <form id="unix-form" class="tool-form" data-template="/api/v1/datetime/to-unix/{datetime}">
        <div class="form-group">
          <label class="form-label">Date/time</label>
          <input type="text" name="datetime" class="form-input" required placeholder="2024-01-15T10:00:00Z">
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="unix-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/to-unix/2024-01-15T10:00:00Z</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

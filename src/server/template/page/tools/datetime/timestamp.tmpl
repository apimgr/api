{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "tool_pages.text.date.time.018fbd2ca5"}}</a> {{t .Lang "tool_pages.text.unix.timestamp.7347cf0817"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.unix.timestamp.52deb2280e"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-timestamp" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.get.the.current.unix.timestamp.seconds.since.9bed00823c"}}
      </p>

      <form id="timestamp-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/timestamp.txt" method="post" action="{{path .BaseURL "/datetime/timestamp"}}">
        {{csrfField .CSRFToken}}
        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.get.timestamp.7846ecd342"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="timestamp-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/timestamp</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/datetime">Date/Time Tools</a> / Add Duration
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Add Duration</h1>
        <button class="btn btn-icon" data-favorite="datetime-add" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Add a duration (e.g. 1h30m, 24h, 7d) to a Unix timestamp.
      </p>

      <form id="add-form" class="tool-form" data-template="/api/v1/datetime/add/{timestamp}/{duration}">
        <div class="form-group">
          <label class="form-label">Unix timestamp</label>
          <input type="number" name="timestamp" class="form-input" required placeholder="1700000000">
        </div>

        <div class="form-group">
          <label class="form-label">Duration</label>
          <input type="text" name="duration" class="form-input" required placeholder="24h">
        </div>

        <button type="submit" class="btn btn-primary">Add</button>
      </form>

      <div id="add-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/add/1700000000/24h</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

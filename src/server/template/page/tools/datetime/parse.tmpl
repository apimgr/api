{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.date.parser.70f28a80e5"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.date.parser.3f170d7d6b"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-parse" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.parse.a.free.form.date.time.string.against.c.5e3b477940"}}
      </p>

      <form id="parse-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/parse/{value}" method="post" action="{{path .BaseURL "/datetime/parse"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="parse-form-value">{{t .Lang "tool_pages.text.date.string.a16a4cbd5d"}}</label>
          <input type="text" name="value" class="form-input" required placeholder="2024-01-15T10:30:00Z" value="2024-01-15T10:30:00Z" id="parse-form-value">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.parse.605537ca5d"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="parse-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/parse/2024-01-15T10:30:00Z</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

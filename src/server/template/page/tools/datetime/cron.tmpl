{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.cron.parser.dcfc187e2c"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.cron.parser.ea867d3caa"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-cron" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.parse.a.standard.5.field.cron.expression.min.a39f892d88"}}
      </p>

      <form id="cron-form" class="tool-form" data-endpoint="{{.APIBasePath}}/datetime/cron" method="post" action="{{path .BaseURL "/datetime/cron"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="cron-form-expression">{{t .Lang "tool_pages.text.cron.expression.9e6e7de6b9"}}</label>
          <input type="text" name="expression" class="form-input" required placeholder="*/15 9-17 * * 1-5" value="*/15 9-17 * * 1-5" id="cron-form-expression">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.parse.605537ca5d"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="cron-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -G "{{.BaseURL}}{{.APIBasePath}}/datetime/cron" --data-urlencode "expression=*/15 9-17 * * 1-5"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/datetime">Date & Time</a> / Business Days
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Business Days</h1>
        <button class="btn btn-icon" data-favorite="datetime-workdays" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Count weekdays (Monday-Friday) between two dates, inclusive.
      </p>

      <form id="workdays-form" class="tool-form" data-template="/api/v1/datetime/workdays/{start}/{end}">
        <div class="form-group">
          <label class="form-label">Start date</label>
          <input type="date" name="start" class="form-input" required value="2024-01-01">
        </div>

        <div class="form-group">
          <label class="form-label">End date</label>
          <input type="date" name="end" class="form-input" required value="2024-01-31">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="workdays-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/workdays/2024-01-01/2024-01-31</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

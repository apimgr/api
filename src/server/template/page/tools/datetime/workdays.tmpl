{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.business.days.da90fd73ac"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.business.days.61c5d0498e"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-workdays" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.count.weekdays.monday.friday.between.two.dat.be114faf1d"}}
      </p>

      <form id="workdays-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/workdays/{start}/{end}" method="post" action="{{path .BaseURL "/datetime/workdays"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="workdays-form-start">{{t .Lang "common.start_date"}}</label>
          <input type="date" name="start" class="form-input" required value="2024-01-01" id="workdays-form-start">
        </div>

        <div class="form-group">
          <label class="form-label" for="workdays-form-end">{{t .Lang "common.end_date"}}</label>
          <input type="date" name="end" class="form-input" required value="2024-01-31" id="workdays-form-end">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="workdays-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/workdays/2024-01-01/2024-01-31</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/datetime">Date & Time</a> / Sunrise/Sunset
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Sunrise/Sunset</h1>
        <button class="btn btn-icon" data-favorite="datetime-sunrise" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate sunrise and sunset times (UTC) for a given latitude,
        longitude, and optional date (defaults to today).
      </p>

      <form id="sunrise-form" class="tool-form" data-template="/api/v1/datetime/sunrise/{lat}/{lon}/{date}">
        <div class="form-group">
          <label class="form-label">Latitude</label>
          <input type="number" step="any" name="lat" class="form-input" required value="40.7128">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude</label>
          <input type="number" step="any" name="lon" class="form-input" required value="-74.0060">
        </div>

        <div class="form-group">
          <label class="form-label">Date</label>
          <input type="date" name="date" class="form-input" value="2024-06-21">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="sunrise-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/datetime/sunrise/40.7128/-74.0060/2024-06-21</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

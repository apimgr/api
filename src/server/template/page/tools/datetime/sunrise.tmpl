{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/datetime"}}">{{t .Lang "categories.datetime.name"}}</a> {{t .Lang "tool_pages.text.sunrise.sunset.c36b3bb609"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.sunrise.sunset.0f1ff6ef93"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="datetime-sunrise" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.sunrise.and.sunset.times.utc.for.a.7c3963f4fb"}}
      </p>

      <form id="sunrise-form" class="tool-form" data-template="{{.APIBasePath}}/datetime/sunrise/{lat}/{lon}/{date}" method="post" action="{{path .BaseURL "/datetime/sunrise"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="sunrise-form-lat">{{t .Lang "tool_pages.text.latitude.238a676da4"}}</label>
          <input type="number" step="any" name="lat" class="form-input" required value="40.7128" id="sunrise-form-lat">
        </div>

        <div class="form-group">
          <label class="form-label" for="sunrise-form-lon">{{t .Lang "tool_pages.text.longitude.6d80458fd1"}}</label>
          <input type="number" step="any" name="lon" class="form-input" required value="-74.0060" id="sunrise-form-lon">
        </div>

        <div class="form-group">
          <label class="form-label" for="sunrise-form-date">{{t .Lang "tool_pages.text.date.99c40ab405"}}</label>
          <input type="date" name="date" class="form-input" value="2024-06-21" id="sunrise-form-date">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="sunrise-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/sunrise/40.7128/-74.0060/2024-06-21</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.compose.validator.0fc390f42f"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.compose.validator.5f492212f6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-compose-validate" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.validate.a.docker.compose.yml.file.for.struc.26b5df3998"}}
      </p>

      <form id="compose-validate-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/docker/compose-validate" method="post" action="{{path .BaseURL "/docker/compose-validate"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="compose-validate-form-body">{{t .Lang "tool_pages.text.docker.compose.yml.e45e45baed"}}</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="{{t .Lang "tool_pages.text.services.web.image.nginx.latest.a5645819dc"}}" id="compose-validate-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="compose-validate-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/docker/compose-validate -d 'services:
  web:
    image: nginx:latest'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

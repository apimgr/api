{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Run to Compose
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Run to Compose</h1>
        <button class="btn btn-icon" data-favorite="docker-run-to-compose" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a docker run command into an equivalent docker-compose
        service block.
      </p>

      <form id="run-to-compose-form" class="tool-form" data-body-endpoint="/api/v1/docker/run-to-compose">
        <div class="form-group">
          <label class="form-label">docker run command</label>
          <textarea name="body" class="form-input" rows="6" required placeholder="docker run -d --name web -p 8080:80 -v /data:/app/data nginx:latest"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="run-to-compose-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/docker/run-to-compose -d 'docker run -d --name web -p 8080:80 nginx:latest'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

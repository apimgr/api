{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.port.mapping.helper.d9d2c1a90e"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.port.mapping.helper.446872e4a3"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-port-mapping" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.a.host.container.protocol.triple.into.7319c59a15"}}
      </p>

      <form id="port-mapping-form" class="tool-form" data-endpoint="{{.APIBasePath}}/docker/port-mapping" method="post" action="{{path .BaseURL "/docker/port-mapping"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="port-mapping-form-action">{{t .Lang "tool_pages.text.action.64cff1319d"}}</label>
          <select name="action" class="form-input" id="port-mapping-form-action">
            <option value="format">{{t .Lang "tool_pages.text.format.2f343666aa"}}</option>
            <option value="parse">{{t .Lang "tool_pages.text.parse.605537ca5d"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="port-mapping-form-host">{{t .Lang "tool_pages.text.host.port.format.e6efe22ccb"}}</label>
          <input type="number" name="host" class="form-input" value="8080" id="port-mapping-form-host">
        </div>

        <div class="form-group">
          <label class="form-label" for="port-mapping-form-container">{{t .Lang "tool_pages.text.container.port.format.bd12e92532"}}</label>
          <input type="number" name="container" class="form-input" value="80" id="port-mapping-form-container">
        </div>

        <div class="form-group">
          <label class="form-label" for="port-mapping-form-protocol">{{t .Lang "tool_pages.text.protocol.format.132c008797"}}</label>
          <input type="text" name="protocol" class="form-input" value="tcp" id="port-mapping-form-protocol">
        </div>

        <div class="form-group">
          <label class="form-label" for="port-mapping-form-mapping">{{t .Lang "tool_pages.text.mapping.string.parse.f058e23559"}}</label>
          <input type="text" name="mapping" class="form-input" placeholder="{{t .Lang "tool_pages.text.8080.80.tcp.bca2af753d"}}" id="port-mapping-form-mapping">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.run.00d60e31a4"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="port-mapping-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/docker/port-mapping?action=format&host=8080&container=80&protocol=tcp"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.volume.mount.helper.41e4f8de72"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.volume.mount.helper.6648df4e07"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-volume-helper" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.a.host.path.and.container.path.into.a.804382b7ef"}}
      </p>

      <form id="volume-helper-form" class="tool-form" data-endpoint="{{.APIBasePath}}/docker/volume-helper" method="post" action="{{path .BaseURL "/docker/volume-helper"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="volume-helper-form-host">{{t .Lang "tool_pages.text.host.path.695cb4379a"}}</label>
          <input type="text" name="host" class="form-input" required value="/data/app" id="volume-helper-form-host">
        </div>

        <div class="form-group">
          <label class="form-label" for="volume-helper-form-container">{{t .Lang "tool_pages.text.container.path.bc74eaa9e6"}}</label>
          <input type="text" name="container" class="form-input" required value="/app/data" id="volume-helper-form-container">
        </div>

        <div class="form-group">
          <label class="form-label" for="volume-helper-form-readonly">
            <input type="checkbox" name="readonly" value="true" id="volume-helper-form-readonly">
            {{t .Lang "tool_pages.text.read.only.72bb90897a"}}
          </label>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="volume-helper-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/docker/volume-helper?host=/data/app&container=/app/data"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

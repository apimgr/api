{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Volume Mount Helper
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Volume Mount Helper</h1>
        <button class="btn btn-icon" data-favorite="docker-volume-helper" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Format a host path and container path into a Docker volume mount
        string, optionally read-only.
      </p>

      <form id="volume-helper-form" class="tool-form" data-endpoint="/api/v1/docker/volume-helper">
        <div class="form-group">
          <label class="form-label">Host Path</label>
          <input type="text" name="host" class="form-input" required value="/data/app">
        </div>

        <div class="form-group">
          <label class="form-label">Container Path</label>
          <input type="text" name="container" class="form-input" required value="/app/data">
        </div>

        <div class="form-group">
          <label class="form-label">
            <input type="checkbox" name="readonly" value="true">
            Read-only
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="volume-helper-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/docker/volume-helper?host=/data/app&container=/app/data"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

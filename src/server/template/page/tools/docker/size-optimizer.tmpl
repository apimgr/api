{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.size.optimizer.a851bf96d7"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.size.optimizer.eb5262dc32"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-size-optimizer" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.analyze.a.dockerfile.and.suggest.changes.to.b31f63d529"}}
      </p>

      <form id="size-optimizer-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/docker/size-optimizer" method="post" action="{{path .BaseURL "/docker/size-optimizer"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="size-optimizer-form-body">{{t .Lang "tool_pages.text.dockerfile.content.328fea9d58"}}</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="{{t .Lang "tool_pages.text.from.golang.latest.run.apt.get.update.apt.ge.f8f07c72d6"}}" id="size-optimizer-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.analyze.cad5bf29c7"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="size-optimizer-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/docker/size-optimizer -d 'FROM golang:latest'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Size Optimizer
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Size Optimizer</h1>
        <button class="btn btn-icon" data-favorite="docker-size-optimizer" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Analyze a Dockerfile and suggest changes to reduce the final image
        size.
      </p>

      <form id="size-optimizer-form" class="tool-form" data-body-endpoint="/api/v1/docker/size-optimizer">
        <div class="form-group">
          <label class="form-label">Dockerfile content</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="FROM golang:latest&#10;RUN apt-get update && apt-get install -y curl"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Analyze</button>
      </form>

      <div id="size-optimizer-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/docker/size-optimizer -d 'FROM golang:latest'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.security.scanner.53f733ecbd"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.security.scanner.ed161bc0a0"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-security-scan" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.statically.scan.a.dockerfile.or.docker.compo.a5e4307611"}}
      </p>

      <form id="security-scan-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/docker/security-scan" method="post" action="{{path .BaseURL "/docker/security-scan"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="security-scan-form-body">{{t .Lang "tool_pages.text.dockerfile.or.docker.compose.yml.content.5305deedcf"}}</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="FROM ubuntu:latest&#10;USER root&#10;RUN curl http://example.com/install.sh | sh" id="security-scan-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.scan.ea1c510d1d"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="security-scan-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/docker/security-scan -d 'FROM ubuntu:latest
USER root'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

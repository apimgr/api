{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Security Scanner
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Security Scanner</h1>
        <button class="btn btn-icon" data-favorite="docker-security-scan" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Statically scan a Dockerfile or docker-compose file for common
        security anti-patterns.
      </p>

      <form id="security-scan-form" class="tool-form" data-body-endpoint="/api/v1/docker/security-scan">
        <div class="form-group">
          <label class="form-label">Dockerfile or docker-compose.yml content</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="FROM ubuntu:latest&#10;USER root&#10;RUN curl http://example.com/install.sh | sh"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Scan</button>
      </form>

      <div id="security-scan-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/docker/security-scan -d 'FROM ubuntu:latest
USER root'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / ENV Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">ENV Parser</h1>
        <button class="btn btn-icon" data-favorite="docker-env-parser" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Parse .env file text into structured key/value entries and validate
        it.
      </p>

      <form id="env-parser-form" class="tool-form" data-body-endpoint="/api/v1/docker/env-parser">
        <div class="form-group">
          <label class="form-label">.env content</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="# comment&#10;DEBUG=true&#10;PORT=8080"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="env-parser-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/docker/env-parser -d 'PORT=8080'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

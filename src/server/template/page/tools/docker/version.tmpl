{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Docker Version
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Docker Version</h1>
        <button class="btn btn-icon" data-favorite="docker-version" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up the latest available Docker Engine version information.
      </p>

      <form id="version-form" class="tool-form" data-template="/api/v1/docker/version?image={image}">
        <div class="form-group">
          <label class="form-label">Image</label>
          <input type="text" name="image" class="form-input" required placeholder="nginx:1.25-alpine">
        </div>

        <button type="submit" class="btn btn-primary">Check Version</button>
      </form>

      <div id="version-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/docker/version?image=nginx:1.25-alpine"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

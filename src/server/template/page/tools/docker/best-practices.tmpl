{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Best Practices
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Best Practices</h1>
        <button class="btn btn-icon" data-favorite="docker-best-practices" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        A curated Docker best practices guide.
      </p>

      <form id="best-practices-form" class="tool-form" data-template="/api/v1/docker/best-practices">
        <button type="submit" class="btn btn-primary">Show Guide</button>
      </form>

      <div id="best-practices-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/docker/best-practices</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.network.helper.de3abb42f8"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.network.helper.6443e512aa"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-network-helper" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.docker.network.create.command.and.ea3de4a251"}}
      </p>

      <form id="network-helper-form" class="tool-form" data-endpoint="{{.APIBasePath}}/docker/network-helper" method="post" action="{{path .BaseURL "/docker/network-helper"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="network-helper-form-name">{{t .Lang "tool_pages.text.network.name.fc9a2e2271"}}</label>
          <input type="text" name="name" class="form-input" required placeholder="{{t .Lang "tool_pages.text.app.net.a7fb17b3e0"}}" id="network-helper-form-name">
        </div>

        <div class="form-group">
          <label class="form-label" for="network-helper-form-driver">{{t .Lang "tool_pages.text.driver.9fe4c68ec2"}}</label>
          <input type="text" name="driver" class="form-input" value="bridge" id="network-helper-form-driver">
        </div>

        <div class="form-group">
          <label class="form-label" for="network-helper-form-subnet">{{t .Lang "tool_pages.text.subnet.cidr.optional.cd2189c451"}}</label>
          <input type="text" name="subnet" class="form-input" placeholder="172.20.0.0/16" id="network-helper-form-subnet">
        </div>

        <div class="form-group">
          <label class="form-label" for="network-helper-form-gateway">{{t .Lang "tool_pages.text.gateway.optional.9a3176cdc4"}}</label>
          <input type="text" name="gateway" class="form-input" placeholder="172.20.0.1" id="network-helper-form-gateway">
        </div>

        <div class="form-group">
          <label class="form-label" for="network-helper-form-internal">
            <input type="checkbox" name="internal" value="true" id="network-helper-form-internal"> {{t .Lang "tool_pages.text.internal.no.external.access.8f8bbde139"}}
          </label>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="network-helper-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/docker/network-helper?name=app-net&driver=bridge&subnet=172.20.0.0/16"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Network Helper
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Network Helper</h1>
        <button class="btn btn-icon" data-favorite="docker-network-helper" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a docker network create command and a matching compose
        networks: block.
      </p>

      <form id="network-helper-form" class="tool-form" data-endpoint="/api/v1/docker/network-helper" method="get" action="/api/v1/docker/network-helper">
        <div class="form-group">
          <label class="form-label">Network Name</label>
          <input type="text" name="name" class="form-input" required placeholder="app-net">
        </div>

        <div class="form-group">
          <label class="form-label">Driver</label>
          <input type="text" name="driver" class="form-input" value="bridge">
        </div>

        <div class="form-group">
          <label class="form-label">Subnet (CIDR, optional)</label>
          <input type="text" name="subnet" class="form-input" placeholder="172.20.0.0/16">
        </div>

        <div class="form-group">
          <label class="form-label">Gateway (optional)</label>
          <input type="text" name="gateway" class="form-input" placeholder="172.20.0.1">
        </div>

        <div class="form-group">
          <label class="form-label">
            <input type="checkbox" name="internal" value="true"> Internal (no external access)
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="network-helper-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/docker/network-helper?name=app-net&driver=bridge&subnet=172.20.0.0/16"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

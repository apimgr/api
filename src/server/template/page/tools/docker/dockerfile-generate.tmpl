{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/docker"}}">{{t .Lang "tool_pages.text.docker.e6169e958b"}}</a> {{t .Lang "tool_pages.text.dockerfile.generator.2f0a24c46e"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.dockerfile.generator.c1b7b6e4d6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="docker-dockerfile-generate" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.dockerfile.from.a.structured.json.405b83e589"}}
      </p>

      <form id="dockerfile-generate-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/docker/dockerfile-generate" method="post" action="{{path .BaseURL "/docker/dockerfile-generate"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="dockerfile-generate-form-body">{{t .Lang "tool_pages.text.configuration.json.1a7e78fbda"}}</label>
          <textarea name="body" class="form-input" rows="10" required placeholder='{{t .Lang "tool_pages.text.base.image.alpine.latest.work.dir.app.run.co.5b8e9d587b"}}' id="dockerfile-generate-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="dockerfile-generate-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/docker/dockerfile-generate -d '{"base_image":"alpine:latest","cmd":"/app/server"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

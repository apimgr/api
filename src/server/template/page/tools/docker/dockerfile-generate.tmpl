{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Dockerfile Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Dockerfile Generator</h1>
        <button class="btn btn-icon" data-favorite="docker-dockerfile-generate" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a Dockerfile from a structured JSON configuration.
      </p>

      <form id="dockerfile-generate-form" class="tool-form" data-body-endpoint="/api/v1/docker/dockerfile-generate">
        <div class="form-group">
          <label class="form-label">Configuration (JSON)</label>
          <textarea name="body" class="form-input" rows="10" required placeholder='{"base_image":"alpine:latest","work_dir":"/app","run_commands":["apk add --no-cache ca-certificates"],"expose_ports":[8080],"cmd":"/app/server"}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="dockerfile-generate-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/docker/dockerfile-generate -d '{"base_image":"alpine:latest","cmd":"/app/server"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

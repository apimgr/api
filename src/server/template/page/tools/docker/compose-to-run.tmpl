{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/docker">Docker</a> / Compose to Run
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Compose to Run</h1>
        <button class="btn btn-icon" data-favorite="docker-compose-to-run" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a docker-compose service definition to an equivalent docker
        run command.
      </p>

      <form id="compose-to-run-form" class="tool-form" data-body-endpoint="/api/v1/docker/compose-to-run">
        <div class="form-group">
          <label class="form-label">docker-compose.yml</label>
          <textarea name="body" class="form-input" rows="10" required placeholder="services:&#10;  web:&#10;    image: nginx:latest&#10;    ports:&#10;      - &quot;8080:80&quot;"></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Service Name (optional if only one service)</label>
          <input type="text" name="service" class="form-input" placeholder="web">
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="compose-to-run-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/docker/compose-to-run?service=web" -d 'services:
  web:
    image: nginx:latest'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

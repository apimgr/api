{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Temperature Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Temperature Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-temperature" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a temperature value between Celsius, Fahrenheit, and Kelvin.
      </p>

      <form id="temperature-form" class="tool-form" data-template="/api/v1/convert/temperature/{value}/{from}/{to}">
        <div class="form-group">
          <label class="form-label">Value</label>
          <input type="number" name="value" class="form-input" step="any" required value="0">
        </div>

        <div class="form-group">
          <label class="form-label">From unit</label>
          <select name="from" class="form-input">
            <option value="c">Celsius (C)</option>
            <option value="f">Fahrenheit (F)</option>
            <option value="k">Kelvin (K)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">To unit</label>
          <select name="to" class="form-input">
            <option value="f">Fahrenheit (F)</option>
            <option value="c">Celsius (C)</option>
            <option value="k">Kelvin (K)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="temperature-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/convert/temperature/0/c/f</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

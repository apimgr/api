{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Energy Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Energy Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-energy" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert an energy value between joules, calories, and
        kilowatt-hours.
      </p>

      <form id="energy-form" class="tool-form" data-template="/api/v1/convert/energy/{value}/{from}/{to}">
        <div class="form-group">
          <label class="form-label">Value</label>
          <input type="number" name="value" class="form-input" step="any" required value="1">
        </div>

        <div class="form-group">
          <label class="form-label">From unit</label>
          <select name="from" class="form-input">
            <option value="j">Joules (j)</option>
            <option value="cal">Calories (cal)</option>
            <option value="kwh">Kilowatt-hours (kwh)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">To unit</label>
          <select name="to" class="form-input">
            <option value="cal">Calories (cal)</option>
            <option value="j">Joules (j)</option>
            <option value="kwh">Kilowatt-hours (kwh)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="energy-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/convert/energy/1/j/cal</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

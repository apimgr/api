{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Speed Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Speed Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-speed" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a speed value between mph, km/h, m/s, and knots.
      </p>

      <form id="speed-form" class="tool-form" data-template="/api/v1/convert/speed/{value}/{from}/{to}">
        <div class="form-group">
          <label class="form-label">Value</label>
          <input type="number" name="value" class="form-input" step="any" required value="1">
        </div>

        <div class="form-group">
          <label class="form-label">From unit</label>
          <select name="from" class="form-input">
            <option value="mph">Miles per hour (mph)</option>
            <option value="kmh">Kilometers per hour (kmh)</option>
            <option value="ms">Meters per second (ms)</option>
            <option value="knot">Knots</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">To unit</label>
          <select name="to" class="form-input">
            <option value="kmh">Kilometers per hour (kmh)</option>
            <option value="mph">Miles per hour (mph)</option>
            <option value="ms">Meters per second (ms)</option>
            <option value="knot">Knots</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="speed-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/convert/speed/1/mph/kmh</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/convert"}}">{{t .Lang "categories.convert.name"}}</a> {{t .Lang "tool_pages.text.speed.converter.f37d274dee"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.speed.converter.8a76e3d1d6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="convert-speed" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.speed.value.between.mph.km.h.m.s.a.4ad53ec6ef"}}
      </p>

      <form id="speed-form" class="tool-form" data-template="{{.APIBasePath}}/convert/speed/{value}/{from}/{to}" method="post" action="{{path .BaseURL "/convert/speed"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="speed-form-value">{{t .Lang "tool_pages.text.value.8e37953d23"}}</label>
          <input type="number" name="value" class="form-input" step="any" required value="1" id="speed-form-value">
        </div>

        <div class="form-group">
          <label class="form-label" for="speed-form-from">{{t .Lang "tool_pages.text.from.unit.21e7287c87"}}</label>
          <select name="from" class="form-input" id="speed-form-from">
            <option value="mph">{{t .Lang "tool_pages.text.miles.per.hour.mph.7427d6e646"}}</option>
            <option value="kmh">{{t .Lang "tool_pages.text.kilometers.per.hour.kmh.5c9c7bfd1b"}}</option>
            <option value="ms">{{t .Lang "tool_pages.text.meters.per.second.ms.70192129b8"}}</option>
            <option value="knot">{{t .Lang "tool_pages.text.knots.fc75d11636"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="speed-form-to">{{t .Lang "tool_pages.text.to.unit.bb3aef52c0"}}</label>
          <select name="to" class="form-input" id="speed-form-to">
            <option value="kmh">{{t .Lang "tool_pages.text.kilometers.per.hour.kmh.5c9c7bfd1b"}}</option>
            <option value="mph">{{t .Lang "tool_pages.text.miles.per.hour.mph.7427d6e646"}}</option>
            <option value="ms">{{t .Lang "tool_pages.text.meters.per.second.ms.70192129b8"}}</option>
            <option value="knot">{{t .Lang "tool_pages.text.knots.fc75d11636"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="speed-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/convert/speed/1/mph/kmh</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

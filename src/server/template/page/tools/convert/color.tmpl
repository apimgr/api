{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/convert"}}">{{t .Lang "categories.convert.name"}}</a> {{t .Lang "tool_pages.text.color.converter.80166c91c5"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.color.converter.d1f01162a2"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="convert-color" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.color.between.hex.rgb.and.hsl.repr.40ef285192"}}
      </p>

      <form id="color-form" class="tool-form" data-endpoint="{{.APIBasePath}}/convert/color" method="post" action="{{path .BaseURL "/convert/color"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="color-form-value">{{t .Lang "tool_pages.text.value.8e37953d23"}}</label>
          <input type="text" name="value" class="form-input" required placeholder="{{t .Lang "tool_pages.text.ff0000.7672e1d56e"}}" id="color-form-value">
        </div>

        <div class="form-group">
          <label class="form-label" for="color-form-from">{{t .Lang "tool_pages.text.from.format.f436efa750"}}</label>
          <select name="from" class="form-input" id="color-form-from">
            <option value="hex">{{t .Lang "tool_pages.text.hex.rrggbb.c3a862fad5"}}</option>
            <option value="rgb">{{t .Lang "tool_pages.text.rgb.r.g.b.b8d946e55e"}}</option>
            <option value="hsl">{{t .Lang "tool_pages.text.hsl.h.s.l.5be788c403"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="color-form-to">{{t .Lang "tool_pages.text.to.format.d7f3314772"}}</label>
          <select name="to" class="form-input" id="color-form-to">
            <option value="rgb">{{t .Lang "tool_pages.text.rgb.r.g.b.b8d946e55e"}}</option>
            <option value="hex">{{t .Lang "tool_pages.text.hex.rrggbb.c3a862fad5"}}</option>
            <option value="hsl">{{t .Lang "tool_pages.text.hsl.h.s.l.5be788c403"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="color-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/convert/color?value=%23ff0000&from=hex&to=rgb"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

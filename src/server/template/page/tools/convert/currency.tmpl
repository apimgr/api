{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Currency Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Currency Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-currency" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert an amount between currencies using live ECB reference
        rates.
      </p>

      <form id="currency-form" class="tool-form" data-endpoint="/api/v1/convert/currency">
        <div class="form-group">
          <label class="form-label">Amount</label>
          <input type="number" name="amount" class="form-input" step="any" value="1">
        </div>

        <div class="form-group">
          <label class="form-label">From currency</label>
          <input type="text" name="from" class="form-input" required placeholder="USD" maxlength="3">
        </div>

        <div class="form-group">
          <label class="form-label">To currency</label>
          <input type="text" name="to" class="form-input" required placeholder="EUR" maxlength="3">
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="currency-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/convert/currency?amount=1&from=USD&to=EUR"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

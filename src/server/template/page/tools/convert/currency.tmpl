{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/convert"}}">{{t .Lang "categories.convert.name"}}</a> {{t .Lang "tool_pages.text.currency.converter.085cadeabc"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.currency.converter.424dc8eb62"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="convert-currency" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.an.amount.between.currencies.using.l.0b659e143c"}}
      </p>

      <form id="currency-form" class="tool-form" data-endpoint="{{.APIBasePath}}/convert/currency" method="post" action="{{path .BaseURL "/convert/currency"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="currency-form-amount">{{t .Lang "tool_pages.text.amount.49e96d7cdf"}}</label>
          <input type="number" name="amount" class="form-input" step="any" value="1" id="currency-form-amount">
        </div>

        <div class="form-group">
          <label class="form-label" for="currency-form-from">{{t .Lang "tool_pages.text.from.currency.3c9d80121b"}}</label>
          <input type="text" name="from" class="form-input" required placeholder="USD" maxlength="3" id="currency-form-from">
        </div>

        <div class="form-group">
          <label class="form-label" for="currency-form-to">{{t .Lang "tool_pages.text.to.currency.baa611adfb"}}</label>
          <input type="text" name="to" class="form-input" required placeholder="EUR" maxlength="3" id="currency-form-to">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="currency-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/convert/currency?amount=1&from=USD&to=EUR"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

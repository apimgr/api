{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/convert"}}">{{t .Lang "categories.convert.name"}}</a> {{t .Lang "tool_pages.text.pressure.converter.d44c65cc68"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.pressure.converter.770fe8de91"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="convert-pressure" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.pressure.value.between.pascals.bar.54a4254e44"}}
      </p>

      <form id="pressure-form" class="tool-form" data-template="{{.APIBasePath}}/convert/pressure/{value}/{from}/{to}" method="post" action="{{path .BaseURL "/convert/pressure"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="pressure-form-value">{{t .Lang "tool_pages.text.value.8e37953d23"}}</label>
          <input type="number" name="value" class="form-input" step="any" required value="1" id="pressure-form-value">
        </div>

        <div class="form-group">
          <label class="form-label" for="pressure-form-from">{{t .Lang "tool_pages.text.from.unit.21e7287c87"}}</label>
          <select name="from" class="form-input" id="pressure-form-from">
            <option value="pa">{{t .Lang "tool_pages.text.pascals.pa.fa64799c17"}}</option>
            <option value="bar">{{t .Lang "tool_pages.text.bar.95d64cacce"}}</option>
            <option value="psi">PSI</option>
            <option value="atm">{{t .Lang "tool_pages.text.atmospheres.atm.0f55ced4b9"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="pressure-form-to">{{t .Lang "tool_pages.text.to.unit.bb3aef52c0"}}</label>
          <select name="to" class="form-input" id="pressure-form-to">
            <option value="bar">{{t .Lang "tool_pages.text.bar.95d64cacce"}}</option>
            <option value="pa">{{t .Lang "tool_pages.text.pascals.pa.fa64799c17"}}</option>
            <option value="psi">PSI</option>
            <option value="atm">{{t .Lang "tool_pages.text.atmospheres.atm.0f55ced4b9"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="pressure-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/convert/pressure/1/pa/bar</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

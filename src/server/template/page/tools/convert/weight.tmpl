{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Weight Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Weight Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-weight" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a weight value between pounds, kilograms, ounces, and grams.
      </p>

      <form id="weight-form" class="tool-form" data-template="/api/v1/convert/weight/{value}/{from}/{to}">
        <div class="form-group">
          <label class="form-label">Value</label>
          <input type="number" name="value" class="form-input" step="any" required value="1">
        </div>

        <div class="form-group">
          <label class="form-label">From unit</label>
          <select name="from" class="form-input">
            <option value="lb">Pounds (lb)</option>
            <option value="kg">Kilograms (kg)</option>
            <option value="oz">Ounces (oz)</option>
            <option value="g">Grams (g)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">To unit</label>
          <select name="to" class="form-input">
            <option value="kg">Kilograms (kg)</option>
            <option value="lb">Pounds (lb)</option>
            <option value="g">Grams (g)</option>
            <option value="oz">Ounces (oz)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="weight-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/convert/weight/1/lb/kg</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

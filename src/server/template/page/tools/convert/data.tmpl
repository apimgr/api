{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/convert">Unit Conversion</a> / Data Size Converter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Data Size Converter</h1>
        <button class="btn btn-icon" data-favorite="convert-data" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert a data size value between bytes, kilobytes, megabytes,
        gigabytes, and terabytes (decimal, 1000-based units).
      </p>

      <form id="data-form" class="tool-form" data-template="/api/v1/convert/data/{value}/{from}/{to}">
        <div class="form-group">
          <label class="form-label">Value</label>
          <input type="number" name="value" class="form-input" step="any" required value="1">
        </div>

        <div class="form-group">
          <label class="form-label">From unit</label>
          <select name="from" class="form-input">
            <option value="b">Bytes (b)</option>
            <option value="kb">Kilobytes (kb)</option>
            <option value="mb">Megabytes (mb)</option>
            <option value="gb">Gigabytes (gb)</option>
            <option value="tb">Terabytes (tb)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">To unit</label>
          <select name="to" class="form-input">
            <option value="kb">Kilobytes (kb)</option>
            <option value="b">Bytes (b)</option>
            <option value="mb">Megabytes (mb)</option>
            <option value="gb">Gigabytes (gb)</option>
            <option value="tb">Terabytes (tb)</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Convert</button>
      </form>

      <div id="data-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/convert/data/1024/b/kb</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/convert"}}">{{t .Lang "categories.convert.name"}}</a> {{t .Lang "tool_pages.text.data.size.converter.0b9543616b"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.data.size.converter.4168ba7e11"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="convert-data" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.a.data.size.value.between.bytes.kilo.afed8cc6a8"}}
      </p>

      <form id="data-form" class="tool-form" data-template="{{.APIBasePath}}/convert/data/{value}/{from}/{to}" method="post" action="{{path .BaseURL "/convert/data"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="data-form-value">{{t .Lang "tool_pages.text.value.8e37953d23"}}</label>
          <input type="number" name="value" class="form-input" step="any" required value="1" id="data-form-value">
        </div>

        <div class="form-group">
          <label class="form-label" for="data-form-from">{{t .Lang "tool_pages.text.from.unit.21e7287c87"}}</label>
          <select name="from" class="form-input" id="data-form-from">
            <option value="b">{{t .Lang "tool_pages.text.bytes.b.a39296149c"}}</option>
            <option value="kb">{{t .Lang "tool_pages.text.kilobytes.kb.27c19c76e6"}}</option>
            <option value="mb">{{t .Lang "tool_pages.text.megabytes.mb.41a5f22210"}}</option>
            <option value="gb">{{t .Lang "tool_pages.text.gigabytes.gb.7dae501cfc"}}</option>
            <option value="tb">{{t .Lang "tool_pages.text.terabytes.tb.4a686ddf05"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="data-form-to">{{t .Lang "tool_pages.text.to.unit.bb3aef52c0"}}</label>
          <select name="to" class="form-input" id="data-form-to">
            <option value="kb">{{t .Lang "tool_pages.text.kilobytes.kb.27c19c76e6"}}</option>
            <option value="b">{{t .Lang "tool_pages.text.bytes.b.a39296149c"}}</option>
            <option value="mb">{{t .Lang "tool_pages.text.megabytes.mb.41a5f22210"}}</option>
            <option value="gb">{{t .Lang "tool_pages.text.gigabytes.gb.7dae501cfc"}}</option>
            <option value="tb">{{t .Lang "tool_pages.text.terabytes.tb.4a686ddf05"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="data-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/convert/data/1024/b/kb</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/parse"}}">{{t .Lang "categories.parse.name"}}</a> {{t .Lang "tool_pages.text.csv.parser.767ac02f06"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.csv.parser.f065f3641c"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="parse-csv" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.parse.a.csv.document.first.row.treated.as.he.78b29ca45a"}}
      </p>

      <form id="csv-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/parse/csv" method="post" action="{{path .BaseURL "/parse/csv"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="csv-form-body">{{t .Lang "tool_pages.text.csv.document.85d05e183c"}}</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="{{t .Lang "tool_pages.text.name.age.alice.30.bob.25.02a10a5cb3"}}" id="csv-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.parse.605537ca5d"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="csv-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/parse/csv -d $'name,age\nAlice,30'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

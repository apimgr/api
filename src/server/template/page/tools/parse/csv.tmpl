{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / CSV Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">CSV Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-csv" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Parse a CSV document (first row treated as headers) into structured rows.
      </p>

      <form id="csv-form" class="tool-form" data-body-endpoint="/api/v1/parse/csv">
        <div class="form-group">
          <label class="form-label">CSV Document</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="name,age&#10;Alice,30&#10;Bob,25"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="csv-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/csv -d $'name,age\nAlice,30'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

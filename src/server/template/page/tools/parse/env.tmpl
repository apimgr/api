{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / Env Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Env Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-env" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Parse a .env-style KEY=VALUE document into a key/value map.
      </p>

      <form id="env-form" class="tool-form" data-body-endpoint="/api/v1/parse/env">
        <div class="form-group">
          <label class="form-label">.env document</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="FOO=bar&#10;export BAZ=&quot;qux&quot;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="env-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/env -d 'FOO=bar'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

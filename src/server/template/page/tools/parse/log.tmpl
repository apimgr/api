{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / Log Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Log Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-log" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Best-effort parse of log lines into timestamp, level, and message.
      </p>

      <form id="log-form" class="tool-form" data-body-endpoint="/api/v1/parse/log">
        <div class="form-group">
          <label class="form-label">Log lines</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="2024-01-02 15:04:05 ERROR something failed"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="log-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/log -d '2024-01-02 15:04:05 ERROR something failed'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

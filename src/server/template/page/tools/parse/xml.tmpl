{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/parse"}}">{{t .Lang "categories.parse.name"}}</a> {{t .Lang "tool_pages.text.xml.parser.0d448d68a3"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.xml.parser.fc202c9dad"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="parse-xml" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.parse.a.raw.xml.document.and.view.the.decode.6cbcbf2201"}}
      </p>

      <form id="xml-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/parse/xml" method="post" action="{{path .BaseURL "/parse/xml"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="xml-form-body">{{t .Lang "tool_pages.text.xml.document.0711bbfe1f"}}</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="{{t .Lang "tool_pages.text.root.item.value.item.root.52e0079355"}}" id="xml-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.parse.605537ca5d"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="xml-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/parse/xml -d '&lt;root&gt;&lt;item&gt;value&lt;/item&gt;&lt;/root&gt;'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / HTML Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">HTML Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-html" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Parse an HTML document into a structural summary: title, meta tags, headings, links, images, and form count.
      </p>

      <form id="html-form" class="tool-form" data-body-endpoint="/api/v1/parse/html">
        <div class="form-group">
          <label class="form-label">HTML document</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="&lt;html&gt;&lt;head&gt;&lt;title&gt;Example&lt;/title&gt;&lt;/head&gt;&lt;body&gt;&lt;/body&gt;&lt;/html&gt;"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="html-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/html -d '&lt;html&gt;&lt;title&gt;Example&lt;/title&gt;&lt;/html&gt;'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

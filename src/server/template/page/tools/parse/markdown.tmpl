{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / Markdown Structure Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Markdown Structure Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-markdown" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Extract headings, links, and code blocks from a Markdown document.
      </p>

      <form id="markdown-form" class="tool-form" data-body-endpoint="/api/v1/parse/markdown">
        <div class="form-group">
          <label class="form-label">Markdown document</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="# Title&#10;&#10;[link](https://example.com)"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="markdown-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/markdown -d '# Title'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

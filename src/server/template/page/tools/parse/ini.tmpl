{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / INI Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">INI Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-ini" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Parse an INI document into sections of key/value pairs.
      </p>

      <form id="ini-form" class="tool-form" data-body-endpoint="/api/v1/parse/ini">
        <div class="form-group">
          <label class="form-label">INI document</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="[section]&#10;key=value"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="ini-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/ini -d '[section]
key=value'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

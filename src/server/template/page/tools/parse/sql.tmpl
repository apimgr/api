{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/parse">Parsers</a> / SQL Structure Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">SQL Structure Parser</h1>
        <button class="btn btn-icon" data-favorite="parse-sql" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Best-effort extraction of statement type, referenced tables, and columns from a single SQL statement. Not a SQL validator.
      </p>

      <form id="sql-form" class="tool-form" data-body-endpoint="/api/v1/parse/sql">
        <div class="form-group">
          <label class="form-label">SQL statement</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="SELECT id, name FROM users WHERE id = 1"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="sql-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/parse/sql -d 'SELECT id, name FROM users'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

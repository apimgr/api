{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/network">Network</a> / SSL Certificate Checker
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">SSL Certificate Checker</h1>
        <button class="btn btn-icon" data-favorite="network-ssl" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Inspect the TLS certificate a host presents: subject, issuer,
        validity window, SANs, and expiry status.
      </p>

      <form id="ssl-form" class="tool-form" data-endpoint="/api/v1/network/ssl">
        <div class="form-group">
          <label class="form-label">Host</label>
          <input type="text" name="host" class="form-input" required placeholder="example.com">
        </div>

        <button type="submit" class="btn btn-primary">Check</button>
      </form>

      <div id="ssl-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/network/ssl?host=example.com"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

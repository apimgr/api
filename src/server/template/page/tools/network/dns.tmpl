{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/network"}}">{{t .Lang "categories.network.name"}}</a> {{t .Lang "tool_pages.text.dns.lookup.91caa78727"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.dns.lookup.e2cae60a16"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="network-dns" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.query.dns.records.for.any.domain.supports.a.eb0c492b47"}}
      </p>

      <form id="dns-form" class="tool-form" data-template="{{.APIBasePath}}/network/dns/{domain}/{type}" method="post" action="{{path .BaseURL "/network/dns"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="dns-form-domain">{{t .Lang "tool_pages.text.domain.79fa33618d"}}</label>
          <input type="text" name="domain" class="form-input" required placeholder="example.com" id="dns-form-domain">
        </div>

        <div class="form-group">
          <label class="form-label" for="dns-form-type">{{t .Lang "tool_pages.text.record.type.6989335a0c"}}</label>
          <select name="type" class="form-input" id="dns-form-type">
            <option value="A" selected>A</option>
            <option value="AAAA">AAAA</option>
            <option value="CNAME">CNAME</option>
            <option value="MX">MX</option>
            <option value="TXT">TXT</option>
            <option value="NS">NS</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.lookup.b9beafcaf6"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="dns-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/network/dns/example.com/A</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

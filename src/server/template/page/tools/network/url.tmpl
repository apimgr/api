{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/network">Network</a> / URL Parser
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">URL Parser</h1>
        <button class="btn btn-icon" data-favorite="network-url" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Break a URL down into its scheme, host, port, path, query, and
        fragment components.
      </p>

      <form id="url-form" class="tool-form" data-endpoint="/api/v1/network/url">
        <div class="form-group">
          <label class="form-label">URL</label>
          <input type="text" name="url" class="form-input" required placeholder="https://user@example.com:8443/path?a=1#frag">
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
      </form>

      <div id="url-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/network/url?url=https%3A%2F%2Fexample.com%2Fpath"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/network">Network</a> / Request Headers
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Request Headers</h1>
        <button class="btn btn-icon" data-favorite="network-headers" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Inspect your resolved IP/port and the caller-identifying headers sent
        with this request.
      </p>

      <form id="headers-form" class="tool-form" data-template="/api/v1/network/headers">
        <button type="submit" class="btn btn-primary">Inspect</button>
      </form>

      <div id="headers-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/network/headers</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

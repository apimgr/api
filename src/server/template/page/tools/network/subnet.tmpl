{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/network">Network</a> / Subnet Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Subnet Calculator</h1>
        <button class="btn btn-icon" data-favorite="network-subnet" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate network, broadcast, and host range details for a CIDR block.
      </p>

      <form id="subnet-form" class="tool-form" data-endpoint="/api/v1/network/subnet" method="get" action="/api/v1/network/subnet">
        <div class="form-group">
          <label class="form-label">CIDR</label>
          <input type="text" name="cidr" class="form-input" required placeholder="192.168.1.0/24">
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="subnet-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/network/subnet?cidr=192.168.1.0/24"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

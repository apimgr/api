{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/network"}}">{{t .Lang "tool_pages.text.network.1744b96470"}}</a> {{t .Lang "tool_pages.text.subnet.calculator.26f9d40b90"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.subnet.calculator.7f1973078b"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="network-subnet" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.network.broadcast.and.host.range.d.6dd732f9c4"}}
      </p>

      <form id="subnet-form" class="tool-form" data-endpoint="{{.APIBasePath}}/network/subnet" method="post" action="{{path .BaseURL "/network/subnet"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="subnet-form-cidr">CIDR</label>
          <input type="text" name="cidr" class="form-input" required placeholder="192.168.1.0/24" id="subnet-form-cidr">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="subnet-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/network/subnet?cidr=192.168.1.0/24"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

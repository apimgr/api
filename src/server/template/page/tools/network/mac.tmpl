{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/network"}}">{{t .Lang "tool_pages.text.network.1744b96470"}}</a> {{t .Lang "tool_pages.text.mac.vendor.lookup.a2136a6cfe"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.mac.vendor.lookup.b9246a1f0c"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="network-mac" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.the.hardware.vendor.that.owns.a.mac.721418712d"}}
      </p>

      <form id="mac-form" class="tool-form" data-template="{{.APIBasePath}}/network/mac/{mac}" method="post" action="{{path .BaseURL "/network/mac"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="mac-form-mac">{{t .Lang "tool_pages.text.mac.address.000a6ce60a"}}</label>
          <input type="text" name="mac" class="form-input" required placeholder="00:1A:2B:3C:4D:5E" id="mac-form-mac">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.look.up.vendor.6061a1d334"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="mac-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/network/mac/00:1A:2B:3C:4D:5E</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

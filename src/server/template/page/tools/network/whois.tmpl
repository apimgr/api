{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/network">Network</a> / Whois Lookup
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Whois Lookup</h1>
        <button class="btn btn-icon" data-favorite="network-whois" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Query WHOIS registration details for a domain (IANA root lookup,
        following the referral to the domain's authoritative registry).
      </p>

      <form id="whois-form" class="tool-form" data-endpoint="/api/v1/network/whois" method="get" action="/api/v1/network/whois">
        <div class="form-group">
          <label class="form-label">Domain</label>
          <input type="text" name="domain" class="form-input" required placeholder="example.com">
        </div>

        <button type="submit" class="btn btn-primary">Lookup</button>
      </form>

      <div id="whois-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/network/whois?domain=example.com"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

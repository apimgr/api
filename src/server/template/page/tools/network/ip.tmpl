{{define "content"}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/network"}}">{{t .Lang "tool_pages.text.network.1744b96470"}}</a> {{t .Lang "tool_pages.text.ip.lookup.6ded31226f"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.ip.address.lookup.957d1cb47b"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="network-ip" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.get.detailed.information.about.any.ip.addres.34d857c861"}}
      </p>

      <form id="network-ip-form" class="tool-form" data-template="{{.APIBasePath}}/network/ip/{ip}" data-empty-template="{{.APIBasePath}}/network/ip" method="post" action="{{path .BaseURL "/network/ip"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="network-ip-form-ip">{{t .Lang "tool_pages.text.ip.address.3c3de0c91c"}}</label>
          <input type="text" name="ip" class="form-input" placeholder="{{t .Lang "common.ip_example"}}" id="network-ip-form-ip">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.lookup.ip.e791f0df6f"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="network-ip-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "tool_pages.text.api.endpoints.e85a69a745"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy>{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/network/ip
curl {{.BaseURL}}{{.APIBasePath}}/network/ip/8.8.8.8</pre>
          </div>
        </div>
      </div>

      {{template "geoip_attribution" .}}
    </div>
  </div>
</section>
{{end}}

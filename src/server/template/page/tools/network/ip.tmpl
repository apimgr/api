{{define "content"}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/network">Network</a> / IP Lookup
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">IP Address Lookup</h1>
        <button class="btn btn-icon" data-favorite="network-ip" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Get detailed information about any IP address including location, ISP, and network details.
      </p>

      <form id="network-ip-form" class="tool-form">
        <div class="form-group">
          <label class="form-label">IP Address</label>
          <input type="text" name="ip" class="form-input" placeholder="8.8.8.8 or leave empty for your IP">
        </div>

        <button type="submit" class="btn btn-primary">Lookup IP</button>
      </form>

      <div id="network-ip-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoints</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy>Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/network/ip
curl {{.BaseURL}}/api/v1/network/ip/8.8.8.8</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}

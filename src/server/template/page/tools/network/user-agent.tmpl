{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/network">Network</a> / User-Agent Lookup
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">User-Agent Lookup</h1>
        <button class="btn btn-icon" data-favorite="network-user-agent" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Inspect the User-Agent header your browser is sending with this request.
      </p>

      <form id="user-agent-form" class="tool-form" data-template="/api/v1/network/user-agent">
        <button type="submit" class="btn btn-primary">Check User-Agent</button>
      </form>

      <div id="user-agent-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/network/user-agent</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

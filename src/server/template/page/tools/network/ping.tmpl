{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/network"}}">{{t .Lang "tool_pages.text.network.1744b96470"}}</a> {{t .Lang "tool_pages.text.ping.9fb43360ad"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.ping.6a4c3a4483"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="network-ping" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.measure.tcp.connect.round.trip.latency.to.a.1da506b8dc"}}
      </p>

      <form id="ping-form" class="tool-form" data-endpoint="{{.APIBasePath}}/network/ping" method="post" action="{{path .BaseURL "/network/ping"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="ping-form-host">{{t .Lang "tool_pages.text.host.4a823118b9"}}</label>
          <input type="text" name="host" class="form-input" required placeholder="example.com" id="ping-form-host">
        </div>

        <div class="form-group">
          <label class="form-label" for="ping-form-count">{{t .Lang "tool_pages.text.count.37bac4952b"}}</label>
          <input type="number" name="count" class="form-input" min="1" max="20" value="4" id="ping-form-count">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.ping.6a4c3a4483"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="ping-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/network/ping?host=example.com&count=4"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

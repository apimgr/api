{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/network">Network</a> / Ping
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Ping</h1>
        <button class="btn btn-icon" data-favorite="network-ping" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Measure TCP connect round-trip latency to a host (a privilege-free
        substitute for raw ICMP echo, which this server cannot send without
        root/CAP_NET_RAW).
      </p>

      <form id="ping-form" class="tool-form" data-endpoint="/api/v1/network/ping">
        <div class="form-group">
          <label class="form-label">Host</label>
          <input type="text" name="host" class="form-input" required placeholder="example.com">
        </div>

        <div class="form-group">
          <label class="form-label">Count</label>
          <input type="number" name="count" class="form-input" min="1" max="20" value="4">
        </div>

        <button type="submit" class="btn btn-primary">Ping</button>
      </form>

      <div id="ping-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/network/ping?host=example.com&count=4"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

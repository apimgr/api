{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.config.files.53296f7d62"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.config.files.0ca95db206"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-config" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.configuration.file.scaffold.in.ya.75cf807e4e"}}
      </p>

      <form id="config-form" class="tool-form" data-template="{{.APIBasePath}}/generate/config?format={format}&host={host}&port={port}&name={name}&debug={debug}" method="post" action="{{path .BaseURL "/generate/config"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="config-form-format">{{t .Lang "tool_pages.text.format.2f343666aa"}}</label>
          <select name="format" class="form-input" id="config-form-format">
            <option value="yaml">YAML</option>
            <option value="json">JSON</option>
            <option value="env">ENV</option>
            <option value="toml">TOML</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="config-form-host">{{t .Lang "tool_pages.text.host.4740ae6347"}}</label>
          <input type="text" name="host" class="form-input" placeholder="0.0.0.0" id="config-form-host">
        </div>

        <div class="form-group">
          <label class="form-label" for="config-form-port">{{t .Lang "tool_pages.text.port.f8d397a33f"}}</label>
          <input type="text" name="port" class="form-input" placeholder="8080" id="config-form-port">
        </div>

        <div class="form-group">
          <label class="form-label" for="config-form-name">{{t .Lang "tool_pages.text.name.82a3537ff0"}}</label>
          <input type="text" name="name" class="form-input" placeholder="{{t .Lang "tool_pages.text.myapp.c1b7024794"}}" id="config-form-name">
        </div>

        <div class="form-group">
          <label class="form-label" for="config-form-debug">{{t .Lang "tool_pages.text.debug.0b8e9e995d"}}</label>
          <input type="text" name="debug" class="form-input" placeholder="{{t .Lang "tool_pages.text.false.fcbcf16590"}}" id="config-form-debug">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="config-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/config?format=yaml&host=0.0.0.0&port=8080"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

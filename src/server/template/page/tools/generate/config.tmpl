{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / Config Files
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Config Files</h1>
        <button class="btn btn-icon" data-favorite="generate-config" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a configuration file scaffold in yaml, json, env, or toml
        format from a set of key=value pairs.
      </p>

      <form id="config-form" class="tool-form" data-template="/api/v1/generate/config?format={format}&host={host}&port={port}&name={name}&debug={debug}">
        <div class="form-group">
          <label class="form-label">Format</label>
          <select name="format" class="form-input">
            <option value="yaml">YAML</option>
            <option value="json">JSON</option>
            <option value="env">ENV</option>
            <option value="toml">TOML</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">host</label>
          <input type="text" name="host" class="form-input" placeholder="0.0.0.0">
        </div>

        <div class="form-group">
          <label class="form-label">port</label>
          <input type="text" name="port" class="form-input" placeholder="8080">
        </div>

        <div class="form-group">
          <label class="form-label">name</label>
          <input type="text" name="name" class="form-input" placeholder="myapp">
        </div>

        <div class="form-group">
          <label class="form-label">debug</label>
          <input type="text" name="debug" class="form-input" placeholder="false">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="config-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/config?format=yaml&host=0.0.0.0&port=8080"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

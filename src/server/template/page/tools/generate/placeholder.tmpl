{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / Placeholder Image
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Placeholder Image</h1>
        <button class="btn btn-icon" data-favorite="generate-placeholder" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a placeholder image of any size, optional format, and
        background color.
      </p>

      <form id="placeholder-form" class="tool-form" data-image-template="/api/v1/generate/placeholder/{width}/{height}">
        <div class="form-group">
          <label class="form-label">Width</label>
          <input type="number" name="width" class="form-input" required min="1" value="300">
        </div>

        <div class="form-group">
          <label class="form-label">Height</label>
          <input type="number" name="height" class="form-input" required min="1" value="200">
        </div>

        <div class="form-group">
          <label class="form-label">Format</label>
          <select name="format" class="form-input">
            <option value="">Default</option>
            <option value="png">PNG</option>
            <option value="jpeg">JPEG</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Background color</label>
          <input type="text" name="bg" class="form-input" placeholder="#CCCCCC">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="placeholder-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/generate/placeholder/300/200 -o placeholder.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.identicon.420825bf14"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.identicon.0f3e8a1bd5"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-identicon" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.deterministic.identicon.image.fro.a2cf95c2f4"}}
      </p>

      <form id="identicon-form" class="tool-form" data-image-template="{{.APIBasePath}}/generate/identicon" method="post" action="{{path .BaseURL "/generate/identicon"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="identicon-form-seed">{{t .Lang "tool_pages.text.seed.367ef06b8f"}}</label>
          <input type="text" name="seed" class="form-input" required placeholder="user@example.com" id="identicon-form-seed">
        </div>

        <div class="form-group">
          <label class="form-label" for="identicon-form-size">{{t .Lang "tool_pages.text.size.1af8519073"}}</label>
          <input type="number" name="size" class="form-input" min="1" value="256" id="identicon-form-size">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="identicon-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/identicon?seed=user@example.com&size=256" -o identicon.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

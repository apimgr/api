{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.qr.code.319b3fb0db"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.qr.code.5a779155ea"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-qr" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.qr.code.image.from.text.data.or.a.a61c605db9"}}
      </p>

      <form id="qr-form" class="tool-form" data-image-template="{{.APIBasePath}}/generate/qr" method="post" action="{{path .BaseURL "/generate/qr"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="qr-form-data">{{t .Lang "tool_pages.text.data.cec3a9b89b"}}</label>
          <input type="text" name="data" class="form-input" placeholder="https://example.com" id="qr-form-data">
        </div>

        <p class="tool-description">
          {{t .Lang "tool_pages.text.or.fill.in.wi.fi.network.fields.instead.of.d.c2b9a41978"}}
        </p>

        <div class="form-group">
          <label class="form-label" for="qr-form-ssid">{{t .Lang "tool_pages.text.wi.fi.ssid.ab074ce2da"}}</label>
          <input type="text" name="ssid" class="form-input" placeholder="{{t .Lang "tool_pages.text.mynetwork.f04dda584c"}}" id="qr-form-ssid">
        </div>

        <div class="form-group">
          <label class="form-label" for="qr-form-password">{{t .Lang "tool_pages.text.wi.fi.password.111dd02367"}}</label>
          <input type="text" name="password" class="form-input" placeholder="{{t .Lang "tool_pages.text.hunter2.f52fbd32b2"}}" id="qr-form-password">
        </div>

        <div class="form-group">
          <label class="form-label" for="qr-form-security">{{t .Lang "tool_pages.text.wi.fi.security.c57ab52e92"}}</label>
          <select name="security" class="form-input" id="qr-form-security">
            <option value="WPA">WPA/WPA2/WPA3</option>
            <option value="WEP">WEP</option>
            <option value="nopass">{{t .Lang "tool_pages.text.open.no.password.9f7e56cd58"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="qr-form-hidden">
            <input type="checkbox" name="hidden" value="true" id="qr-form-hidden"> {{t .Lang "tool_pages.text.hidden.network.366763cbc9"}}
          </label>
        </div>

        <div class="form-group">
          <label class="form-label" for="qr-form-width">{{t .Lang "tool_pages.text.width.3019947b6d"}}</label>
          <input type="number" name="width" class="form-input" min="1" value="300" id="qr-form-width">
        </div>

        <div class="form-group">
          <label class="form-label" for="qr-form-height">{{t .Lang "tool_pages.text.height.bfe2eca401"}}</label>
          <input type="number" name="height" class="form-input" min="1" value="300" id="qr-form-height">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="qr-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/qr?data=https://example.com" -o qr.png</pre>
          </div>
        </div>
        <div class="code-block mt-2">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "tool_pages.text.wi.fi.qr.request.7131e66add"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/qr?ssid=MyNetwork&password=hunter2&security=WPA" -o wifi-qr.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / QR Code
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">QR Code</h1>
        <button class="btn btn-icon" data-favorite="generate-qr" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a QR code image from text data, or a Wi-Fi join QR code
        from a network name and password.
      </p>

      <form id="qr-form" class="tool-form" data-image-template="/api/v1/generate/qr">
        <div class="form-group">
          <label class="form-label">Data</label>
          <input type="text" name="data" class="form-input" placeholder="https://example.com">
        </div>

        <p class="tool-description">
          Or fill in Wi-Fi Network fields instead of Data to generate a
          Wi-Fi join QR code:
        </p>

        <div class="form-group">
          <label class="form-label">Wi-Fi SSID</label>
          <input type="text" name="ssid" class="form-input" placeholder="MyNetwork">
        </div>

        <div class="form-group">
          <label class="form-label">Wi-Fi Password</label>
          <input type="text" name="password" class="form-input" placeholder="hunter2">
        </div>

        <div class="form-group">
          <label class="form-label">Wi-Fi Security</label>
          <select name="security" class="form-input">
            <option value="WPA">WPA/WPA2/WPA3</option>
            <option value="WEP">WEP</option>
            <option value="nopass">Open (no password)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">
            <input type="checkbox" name="hidden" value="true"> Hidden network
          </label>
        </div>

        <div class="form-group">
          <label class="form-label">Width</label>
          <input type="number" name="width" class="form-input" min="1" value="300">
        </div>

        <div class="form-group">
          <label class="form-label">Height</label>
          <input type="number" name="height" class="form-input" min="1" value="300">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="qr-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/qr?data=https://example.com" -o qr.png</pre>
          </div>
        </div>
        <div class="code-block mt-2">
          <div class="code-header">
            <span class="code-lang">Wi-Fi QR Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/qr?ssid=MyNetwork&password=hunter2&security=WPA" -o wifi-qr.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

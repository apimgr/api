{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / SSH Key
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">SSH Key</h1>
        <button class="btn btn-icon" data-favorite="generate-ssh-key" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a stateless Ed25519 SSH key pair (OpenSSH format). Nothing
        is persisted server-side — the private key is shown only once.
      </p>

      <form id="ssh-key-form" class="tool-form" data-template="/api/v1/generate/ssh-key">
        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="ssh-key-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/generate/ssh-key</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

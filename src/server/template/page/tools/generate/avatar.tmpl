{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.avatar.99c0a75ccc"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "users.profile.avatar"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-avatar" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.an.avatar.image.from.initials.41d72e5398"}}
      </p>

      <form id="avatar-form" class="tool-form" data-image-template="{{.APIBasePath}}/generate/avatar" method="post" action="{{path .BaseURL "/generate/avatar"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="avatar-form-initials">{{t .Lang "tool_pages.text.initials.314bf1e482"}}</label>
          <input type="text" name="initials" class="form-input" required maxlength="3" placeholder="AB" id="avatar-form-initials">
        </div>

        <div class="form-group">
          <label class="form-label" for="avatar-form-size">{{t .Lang "tool_pages.text.size.1af8519073"}}</label>
          <input type="number" name="size" class="form-input" min="1" value="128" id="avatar-form-size">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="avatar-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/avatar?initials=AB&size=128" -o avatar.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

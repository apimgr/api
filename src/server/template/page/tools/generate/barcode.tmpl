{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.barcode.bc2fb50676"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.barcode.a401f37210"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-barcode" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.1d.barcode.image.ean.13.upc.a.cod.cefe12461c"}}
      </p>

      <form id="barcode-form" class="tool-form" data-image-template="{{.APIBasePath}}/generate/barcode" method="post" action="{{path .BaseURL "/generate/barcode"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="barcode-form-format">{{t .Lang "tool_pages.text.format.2f343666aa"}}</label>
          <select name="format" class="form-input" id="barcode-form-format">
            <option value="ean13">EAN-13</option>
            <option value="upca">UPC-A</option>
            <option value="code128">{{t .Lang "tool_pages.text.code128.96307f4b38"}}</option>
            <option value="code39">{{t .Lang "tool_pages.text.code39.d3c0003b93"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="barcode-form-data">{{t .Lang "tool_pages.text.data.cec3a9b89b"}}</label>
          <input type="text" name="data" class="form-input" required placeholder="123456789012" id="barcode-form-data">
        </div>

        <div class="form-group">
          <label class="form-label" for="barcode-form-width">{{t .Lang "tool_pages.text.width.3019947b6d"}}</label>
          <input type="number" name="width" class="form-input" min="1" value="300" id="barcode-form-width">
        </div>

        <div class="form-group">
          <label class="form-label" for="barcode-form-height">{{t .Lang "tool_pages.text.height.bfe2eca401"}}</label>
          <input type="number" name="height" class="form-input" min="1" value="100" id="barcode-form-height">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="barcode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/barcode?format=code128&data=Hello" -o barcode.png</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

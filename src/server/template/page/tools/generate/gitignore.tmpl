{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / .gitignore
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">.gitignore</h1>
        <button class="btn btn-icon" data-favorite="generate-gitignore" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a .gitignore file as the union of curated boilerplate for one
        or more comma-separated languages/tools (go, node, python, rust, java,
        macos, linux, windows, vscode, jetbrains).
      </p>

      <form id="gitignore-form" class="tool-form" data-template="/api/v1/generate/gitignore?lang={lang}">
        <div class="form-group">
          <label class="form-label">Languages/Tools</label>
          <input type="text" name="lang" class="form-input" required placeholder="go,vscode,macos">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="gitignore-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/gitignore?lang=go,vscode,macos"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

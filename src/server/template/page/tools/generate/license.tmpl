{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / License File
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">License File</h1>
        <button class="btn btn-icon" data-favorite="generate-license" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate canonical license text, optionally substituting your name and year.
      </p>

      <form id="license-form" class="tool-form" data-template="/api/v1/generate/license?type={type}&author={author}&year={year}">
        <div class="form-group">
          <label class="form-label">License Type</label>
          <select name="type" class="form-input">
            <option value="mit">MIT</option>
            <option value="apache-2.0">Apache-2.0</option>
            <option value="gpl-3.0">GPL-3.0</option>
            <option value="bsd-3-clause">BSD-3-Clause</option>
            <option value="isc">ISC</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Author</label>
          <input type="text" name="author" class="form-input" placeholder="Jane Doe">
        </div>

        <div class="form-group">
          <label class="form-label">Year</label>
          <input type="text" name="year" class="form-input" placeholder="2026">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="license-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/license?type=mit&author=Jane+Doe&year=2026"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/generate">Generators</a> / Dockerfile
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Dockerfile</h1>
        <button class="btn btn-icon" data-favorite="generate-dockerfile" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate a minimal, idiomatic multi-stage Dockerfile for a language.
      </p>

      <form id="dockerfile-form" class="tool-form" data-template="/api/v1/generate/dockerfile?lang={lang}">
        <div class="form-group">
          <label class="form-label">Language</label>
          <select name="lang" class="form-input">
            <option value="go">Go</option>
            <option value="node">Node</option>
            <option value="python">Python</option>
            <option value="rust">Rust</option>
            <option value="generic">Generic</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="dockerfile-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/generate/dockerfile?lang=go"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

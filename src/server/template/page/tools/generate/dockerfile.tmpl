{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/generate"}}">{{t .Lang "categories.generate.name"}}</a> {{t .Lang "tool_pages.text.dockerfile.3ff152a855"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.dockerfile.dd2c0eb6ea"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="generate-dockerfile" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.a.minimal.idiomatic.multi.stage.doc.f1d32a29dd"}}
      </p>

      <form id="dockerfile-form" class="tool-form" data-template="{{.APIBasePath}}/generate/dockerfile?lang={lang}" method="post" action="{{path .BaseURL "/generate/dockerfile"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="dockerfile-form-lang">{{t .Lang "tool_pages.text.language.a4fe65264e"}}</label>
          <select name="lang" class="form-input" id="dockerfile-form-lang">
            <option value="go">{{t .Lang "tool_pages.text.go.6cc8519b91"}}</option>
            <option value="node">{{t .Lang "tool_pages.text.node.e93372533f"}}</option>
            <option value="python">{{t .Lang "tool_pages.text.python.18885f27b5"}}</option>
            <option value="rust">{{t .Lang "tool_pages.text.rust.d9aa89fdd1"}}</option>
            <option value="generic">{{t .Lang "tool_pages.text.generic.0228c6d48e"}}</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="dockerfile-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/generate/dockerfile?lang=go"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/validate">Validators</a> / Validate Domain
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Validate Domain</h1>
        <button class="btn btn-icon" data-favorite="validate-domain" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Check whether a domain name is correctly formatted.
      </p>

      <form id="validate-domain-form" class="tool-form" data-query-post-endpoint="/api/v1/validate/domain">
        <div class="form-group">
          <label class="form-label">Validate Domain</label>
          <input type="text" name="domain" class="form-input" required placeholder="example.com">
        </div>

        <button type="submit" class="btn btn-primary">Validate</button>
      </form>

      <div id="validate-domain-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/validate/domain?domain=example.com"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

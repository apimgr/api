{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/validate"}}">{{t .Lang "categories.validate.name"}}</a> {{t .Lang "tool_pages.text.validate.phone.number.317687aca2"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.validate.phone.number.9092e30b9f"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="validate-phone" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.check.whether.a.string.is.a.correctly.format.c430c7750c"}}
      </p>

      <form id="validate-phone-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/validate/phone" method="post" action="{{path .BaseURL "/validate/phone"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="validate-phone-form-phone">{{t .Lang "tool_pages.text.validate.phone.number.9092e30b9f"}}</label>
          <input type="text" name="phone" class="form-input" required placeholder="+14155552671" id="validate-phone-form-phone">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="validate-phone-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/validate/phone?phone=+14155552671"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

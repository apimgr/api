{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/validate"}}">{{t .Lang "categories.validate.name"}}</a> {{t .Lang "tool_pages.text.validate.credit.card.e75469849f"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.validate.credit.card.3db37dff26"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="validate-credit-card" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.check.a.credit.card.number.against.the.luhn.6292735ba1"}}
      </p>

      <form id="validate-credit-card-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/validate/credit-card" method="post" action="{{path .BaseURL "/validate/credit-card"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="validate-credit-card-form-number">{{t .Lang "tool_pages.text.validate.credit.card.3db37dff26"}}</label>
          <input type="text" name="number" class="form-input" required placeholder="4111111111111111" id="validate-credit-card-form-number">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="validate-credit-card-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/validate/credit-card?number=4111111111111111"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

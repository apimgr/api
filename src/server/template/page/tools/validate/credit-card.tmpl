{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/validate">Validators</a> / Validate Credit Card
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Validate Credit Card</h1>
        <button class="btn btn-icon" data-favorite="validate-credit-card" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Check a credit card number against the Luhn algorithm.
      </p>

      <form id="validate-credit-card-form" class="tool-form" data-query-post-endpoint="/api/v1/validate/credit-card">
        <div class="form-group">
          <label class="form-label">Validate Credit Card</label>
          <input type="text" name="number" class="form-input" required placeholder="4111111111111111">
        </div>

        <button type="submit" class="btn btn-primary">Validate</button>
      </form>

      <div id="validate-credit-card-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/validate/credit-card?number=4111111111111111"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

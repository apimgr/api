{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/validate">Validators</a> / Validate ISBN
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Validate ISBN</h1>
        <button class="btn btn-icon" data-favorite="validate-isbn" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Check an ISBN-10 or ISBN-13 book number's check digit.
      </p>

      <form id="validate-isbn-form" class="tool-form" data-query-post-endpoint="/api/v1/validate/isbn">
        <div class="form-group">
          <label class="form-label">Validate ISBN</label>
          <input type="text" name="isbn" class="form-input" required placeholder="978-3-16-148410-0">
        </div>

        <button type="submit" class="btn btn-primary">Validate</button>
      </form>

      <div id="validate-isbn-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}/api/v1/validate/isbn?isbn=978-3-16-148410-0"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

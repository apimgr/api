{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/validate"}}">{{t .Lang "categories.validate.name"}}</a> {{t .Lang "tool_pages.text.validate.email.9f2e80b7ba"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.validate.email.fb6c265d95"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="validate-email" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.check.whether.an.email.address.is.correctly.6f2555a593"}}
      </p>

      <form id="email-form" class="tool-form" data-query-post-endpoint="{{.APIBasePath}}/validate/email" method="post" action="{{path .BaseURL "/validate/email"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="email-form-email">{{t .Lang "tool_pages.text.email.address.f2488fd4ef"}}</label>
          <input type="text" name="email" class="form-input" required placeholder="user@example.com" id="email-form-email">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="email-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST "{{.BaseURL}}{{.APIBasePath}}/validate/email?email=user@example.com"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

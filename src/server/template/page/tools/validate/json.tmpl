{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/validate">Validators</a> / Validate JSON
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Validate JSON</h1>
        <button class="btn btn-icon" data-favorite="validate-json" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Check whether a document is well-formed JSON. The raw request body is
        parsed directly — it does not need to be wrapped in a field.
      </p>

      <form id="json-form" class="tool-form" data-body-endpoint="/api/v1/validate/json">
        <div class="form-group">
          <label class="form-label">JSON document</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"a":1}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Validate</button>
      </form>

      <div id="json-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/validate/json -d '{"a":1}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/validate"}}">{{t .Lang "categories.validate.name"}}</a> {{t .Lang "tool_pages.text.validate.json.cfeeb9ce52"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.validate.json.146ae74f37"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="validate-json" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.check.whether.a.document.is.well.formed.json.c54bfec2af"}}
      </p>

      <form id="json-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/validate/json" method="post" action="{{path .BaseURL "/validate/json"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="json-form-body">{{t .Lang "tool_pages.text.json.document.7cced44116"}}</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{{t .Lang "tool_pages.text.a.1.015abd7f5c"}}' id="json-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.validate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="json-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/validate/json -d '{"a":1}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

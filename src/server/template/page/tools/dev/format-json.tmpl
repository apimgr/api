{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/dev">Developer Tools</a> / Format JSON
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Format JSON</h1>
        <button class="btn btn-icon" data-favorite="dev-format-json" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Pretty-print and re-indent a raw JSON document.
      </p>

      <form id="format-json-form" class="tool-form" data-body-endpoint="/api/v1/dev/format/json">
        <div class="form-group">
          <label class="form-label">Raw JSON</label>
          <textarea name="body" class="form-input" rows="8" required placeholder='{"key":"value"}'></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Format</button>
      </form>

      <div id="format-json-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/dev/format/json -d '{"key":"value"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

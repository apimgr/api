{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/dev"}}">{{t .Lang "categories.dev.name"}}</a> {{t .Lang "tool_pages.text.sql.formatter.82389073f9"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.sql.formatter.e74a95e3a6"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="dev-sql-format" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.sql.queries.f4b8a5a295"}}
      </p>

      <form id="sql-format-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/dev/format/sql" method="post" action="{{path .BaseURL "/dev/sql-format"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="sql-format-form-body">{{t .Lang "tool_pages.text.raw.sql.e5d9c84093"}}</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="{{t .Lang "tool_pages.text.select.from.users.where.id.1.and.active.1.d99d63fbe3"}}" id="sql-format-form-body"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.format.2f343666aa"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="sql-format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/dev/format/sql -d 'select * from users where id=1 and active=1'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

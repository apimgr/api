{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/dev">Developer Tools</a> / SQL Formatter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">SQL Formatter</h1>
        <button class="btn btn-icon" data-favorite="dev-sql-format" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Format SQL queries.
      </p>

      <form id="sql-format-form" class="tool-form" data-body-endpoint="/api/v1/dev/format/sql">
        <div class="form-group">
          <label class="form-label">Raw SQL</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="select * from users where id=1 and active=1"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Format</button>
      </form>

      <div id="sql-format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/dev/format/sql -d 'select * from users where id=1 and active=1'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

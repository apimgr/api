{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/dev"}}">{{t .Lang "categories.dev.name"}}</a> {{t .Lang "tool_pages.text.xml.formatter.ea414ebc4c"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.xml.formatter.cb5f4ca27c"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="dev-xml-format" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.minify.xml.41dfcc9cfc"}}
      </p>

      <form id="xml-format-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/dev/format/xml" method="post" action="{{path .BaseURL "/dev/xml-format"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="xml-format-form-body">{{t .Lang "tool_pages.text.raw.xml.8fbe83dfb5"}}</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="{{t .Lang "tool_pages.text.root.item.value.item.root.52e0079355"}}" id="xml-format-form-body"></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="xml-format-form-minify">
            <input type="checkbox" name="minify" value="true" id="xml-format-form-minify">
            {{t .Lang "tool_pages.text.minify.instead.of.format.a2c1d87143"}}
          </label>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.format.2f343666aa"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="xml-format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/dev/format/xml -d '&lt;root&gt;&lt;item&gt;value&lt;/item&gt;&lt;/root&gt;'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/dev">Developer Tools</a> / CSS Formatter
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">CSS Formatter</h1>
        <button class="btn btn-icon" data-favorite="dev-css-format" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Format/minify CSS.
      </p>

      <form id="css-format-form" class="tool-form" data-body-endpoint="/api/v1/dev/format/css">
        <div class="form-group">
          <label class="form-label">Raw CSS</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="body{color:red;}"></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">
            <input type="checkbox" name="minify" value="true">
            Minify instead of format
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Format</button>
      </form>

      <div id="css-format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/dev/format/css -d 'body{color:red;}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

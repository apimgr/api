{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/dev"}}">{{t .Lang "categories.dev.name"}}</a> {{t .Lang "tool_pages.text.html.formatter.8b7716910b"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.html.formatter.b843b0141a"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="dev-html-format" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.format.minify.html.816d03fa5f"}}
      </p>

      <form id="html-format-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/dev/format/html" method="post" action="{{path .BaseURL "/dev/html-format"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="html-format-form-body">{{t .Lang "tool_pages.text.raw.html.f35c32ee6b"}}</label>
          <textarea name="body" class="form-input" rows="8" required placeholder="{{t .Lang "tool_pages.text.div.p.hello.p.div.5d59c1b5a0"}}" id="html-format-form-body"></textarea>
        </div>

        <div class="form-group">
          <label class="form-label" for="html-format-form-minify">
            <input type="checkbox" name="minify" value="true" id="html-format-form-minify">
            {{t .Lang "tool_pages.text.minify.instead.of.format.a2c1d87143"}}
          </label>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.format.2f343666aa"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="html-format-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/dev/format/html -d '&lt;div&gt;&lt;p&gt;Hello&lt;/p&gt;&lt;/div&gt;'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Geocode Address
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Geocode Address</h1>
        <button class="btn btn-icon" data-favorite="geo-geocode" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Convert an address or place name into geographic coordinates using
        OpenStreetMap Nominatim.
      </p>

      <form id="geocode-form" class="tool-form" data-endpoint="/api/v1/geo/geocode">
        <div class="form-group">
          <label class="form-label">Address or place name</label>
          <input type="text" name="q" class="form-input" required value="1600 Pennsylvania Ave NW, Washington, DC">
        </div>

        <button type="submit" class="btn btn-primary">Geocode</button>
      </form>

      <div id="geocode-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/geocode?q=1600+Pennsylvania+Ave+NW%2C+Washington%2C+DC"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

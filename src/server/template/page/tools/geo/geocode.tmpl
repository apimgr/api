{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.geocode.address.4b36106fc4"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.geocode.address.da4dc4a112"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-geocode" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.an.address.or.place.name.into.geogra.591a65f396"}}
      </p>

      <form id="geocode-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/geocode" method="post" action="{{path .BaseURL "/geo/geocode"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="geocode-form-q">{{t .Lang "tool_pages.text.address.or.place.name.341224a26a"}}</label>
          <input type="text" name="q" class="form-input" required value="1600 Pennsylvania Ave NW, Washington, DC" id="geocode-form-q">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.geocode.1606207c55"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="geocode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/geocode?q=1600+Pennsylvania+Ave+NW%2C+Washington%2C+DC"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

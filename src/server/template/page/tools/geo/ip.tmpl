{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / IP Geolocation
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">IP Geolocation</h1>
        <button class="btn btn-icon" data-favorite="geo-ip" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up geolocation details (country, region, city, coordinates) for
        a public IP address.
      </p>

      <form id="ip-form" class="tool-form" data-template="/api/v1/geo/ip/{ip}">
        <div class="form-group">
          <label class="form-label">IP address</label>
          <input type="text" name="ip" class="form-input" required placeholder="8.8.8.8">
        </div>

        <button type="submit" class="btn btn-primary">Look Up</button>
      </form>

      <div id="ip-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/geo/ip/8.8.8.8</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

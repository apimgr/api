{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.ip.geolocation.0b0d767d93"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.ip.geolocation.345cebdfdc"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-ip" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.geolocation.details.country.region.c.ef6ab88591"}}
      </p>

      <form id="ip-form" class="tool-form" data-template="{{.APIBasePath}}/geo/ip/{ip}" method="post" action="{{path .BaseURL "/geo/ip"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="ip-form-ip">{{t .Lang "tool_pages.text.ip.address.0302a46788"}}</label>
          <input type="text" name="ip" class="form-input" required placeholder="8.8.8.8" id="ip-form-ip">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.look.up.1f435536d8"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="ip-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/geo/ip/8.8.8.8</pre>
          </div>
        </div>
      </div>

      {{template "geoip_attribution" .}}
    </div>
  </div>
</section>
{{end}}
{{end}}

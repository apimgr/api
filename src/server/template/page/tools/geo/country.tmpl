{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.country.info.5545679f63"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.country.info.62a7a79d36"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-country" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.a.country.s.name.alpha.2.alpha.3.num.a4358e9153"}}
      </p>

      <form id="country-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/country" method="post" action="{{path .BaseURL "/geo/country"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="country-form-q">{{t .Lang "tool_pages.text.country.name.or.code.84fc6b0650"}}</label>
          <input type="text" name="q" class="form-input" required value="US" placeholder="{{t .Lang "tool_pages.text.us.usa.or.united.states.6d9e4a4502"}}" id="country-form-q">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.lookup.b9beafcaf6"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="country-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/country?q=US"</pre>
          </div>
        </div>
      </div>

      {{template "geoip_attribution" .}}
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Country Info
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Country Info</h1>
        <button class="btn btn-icon" data-favorite="geo-country" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up a country's name, alpha-2/alpha-3/numeric codes, capital,
        currency, calling code, TLD, and region.
      </p>

      <form id="country-form" class="tool-form" data-endpoint="/api/v1/geo/country">
        <div class="form-group">
          <label class="form-label">Country name or code</label>
          <input type="text" name="q" class="form-input" required value="US" placeholder="US, USA, or United States">
        </div>

        <button type="submit" class="btn btn-primary">Lookup</button>
      </form>

      <div id="country-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/country?q=US"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

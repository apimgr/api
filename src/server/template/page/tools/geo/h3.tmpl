{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / H3 Encoder
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">H3 Encoder</h1>
        <button class="btn btn-icon" data-favorite="geo-h3" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Encode a pair of coordinates into an Uber H3 hexagonal cell index at
        the given resolution.
      </p>

      <form id="h3-form" class="tool-form" data-endpoint="/api/v1/geo/h3" method="get" action="/api/v1/geo/h3">
        <div class="form-group">
          <label class="form-label">Latitude</label>
          <input type="text" name="lat" class="form-input" required value="40.7128">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude</label>
          <input type="text" name="lon" class="form-input" required value="-74.0060">
        </div>

        <div class="form-group">
          <label class="form-label">Resolution (0-15)</label>
          <input type="number" name="resolution" class="form-input" min="0" max="15" value="9">
        </div>

        <button type="submit" class="btn btn-primary">Encode</button>
      </form>

      <div id="h3-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/h3?lat=40.7128&lon=-74.0060&resolution=9"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

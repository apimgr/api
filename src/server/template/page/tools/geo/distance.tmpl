{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Distance Calculator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Distance Calculator</h1>
        <button class="btn btn-icon" data-favorite="geo-distance" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Calculate the great-circle distance between two coordinates, in
        kilometers or miles.
      </p>

      <form id="distance-form" class="tool-form" data-endpoint="/api/v1/geo/distance" method="get" action="/api/v1/geo/distance">
        <div class="form-group">
          <label class="form-label">Latitude 1</label>
          <input type="text" name="lat1" class="form-input" required value="40.7128">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude 1</label>
          <input type="text" name="lon1" class="form-input" required value="-74.0060">
        </div>

        <div class="form-group">
          <label class="form-label">Latitude 2</label>
          <input type="text" name="lat2" class="form-input" required value="34.0522">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude 2</label>
          <input type="text" name="lon2" class="form-input" required value="-118.2437">
        </div>

        <div class="form-group">
          <label class="form-label">Unit</label>
          <select name="unit" class="form-input">
            <option value="km">Kilometers</option>
            <option value="mi">Miles</option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <div id="distance-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/distance?lat1=40.7128&lon1=-74.0060&lat2=34.0522&lon2=-118.2437&unit=km"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.bounding.box.24f1193eb6"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.bounding.box.28b8bcd6ec"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-bbox" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.a.bounding.box.from.a.center.coord.c2b70b702c"}}
      </p>

      <form id="bbox-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/bbox" method="post" action="{{path .BaseURL "/geo/bbox"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="bbox-form-lat">{{t .Lang "tool_pages.text.center.latitude.beb9661a67"}}</label>
          <input type="text" name="lat" class="form-input" value="40.7128" id="bbox-form-lat">
        </div>

        <div class="form-group">
          <label class="form-label" for="bbox-form-lon">{{t .Lang "tool_pages.text.center.longitude.574a8e4ee4"}}</label>
          <input type="text" name="lon" class="form-input" value="-74.0060" id="bbox-form-lon">
        </div>

        <div class="form-group">
          <label class="form-label" for="bbox-form-radius">{{t .Lang "tool_pages.text.radius.km.1cb5a699c5"}}</label>
          <input type="text" name="radius" class="form-input" value="10" id="bbox-form-radius">
        </div>

        <div class="form-group">
          <label class="form-label" for="bbox-form-coords">{{t .Lang "tool_pages.text.coordinates.to.use.a.list.instead.b246f3fa60"}}</label>
          <input type="text" name="coords" class="form-input" placeholder="40.7128,-74.0060|34.0522,-118.2437" id="bbox-form-coords">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="bbox-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/bbox?lat=40.7128&lon=-74.0060&radius=10"
curl "{{.BaseURL}}{{.APIBasePath}}/geo/bbox?coords=40.7128,-74.0060|34.0522,-118.2437"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

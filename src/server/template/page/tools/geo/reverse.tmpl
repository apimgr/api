{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Reverse Geocode
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Reverse Geocode</h1>
        <button class="btn btn-icon" data-favorite="geo-reverse" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up the address for a pair of coordinates using OpenStreetMap
        Nominatim.
      </p>

      <form id="reverse-form" class="tool-form" data-endpoint="/api/v1/geo/reverse">
        <div class="form-group">
          <label class="form-label">Latitude</label>
          <input type="text" name="lat" class="form-input" required value="38.8977">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude</label>
          <input type="text" name="lon" class="form-input" required value="-77.0365">
        </div>

        <button type="submit" class="btn btn-primary">Reverse Geocode</button>
      </form>

      <div id="reverse-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/reverse?lat=38.8977&lon=-77.0365"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

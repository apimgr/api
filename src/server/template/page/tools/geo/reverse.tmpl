{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.reverse.geocode.80de9e82c1"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.reverse.geocode.6591e7cfab"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-reverse" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.the.address.for.a.pair.of.coordinate.94c7b4b15c"}}
      </p>

      <form id="reverse-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/reverse" method="post" action="{{path .BaseURL "/geo/reverse"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="reverse-form-lat">{{t .Lang "tool_pages.text.latitude.238a676da4"}}</label>
          <input type="text" name="lat" class="form-input" required value="38.8977" id="reverse-form-lat">
        </div>

        <div class="form-group">
          <label class="form-label" for="reverse-form-lon">{{t .Lang "tool_pages.text.longitude.6d80458fd1"}}</label>
          <input type="text" name="lon" class="form-input" required value="-77.0365" id="reverse-form-lon">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.reverse.geocode.6591e7cfab"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="reverse-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/reverse?lat=38.8977&lon=-77.0365"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

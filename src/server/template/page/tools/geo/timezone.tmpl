{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Timezone Lookup
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Timezone Lookup</h1>
        <button class="btn btn-icon" data-favorite="geo-timezone" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Look up the IANA timezone name for a pair of coordinates.
      </p>

      <form id="timezone-form" class="tool-form" data-endpoint="/api/v1/geo/timezone">
        <div class="form-group">
          <label class="form-label">Latitude</label>
          <input type="text" name="lat" class="form-input" required value="40.7128">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude</label>
          <input type="text" name="lon" class="form-input" required value="-74.0060">
        </div>

        <button type="submit" class="btn btn-primary">Lookup</button>
      </form>

      <div id="timezone-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/timezone?lat=40.7128&lon=-74.0060"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

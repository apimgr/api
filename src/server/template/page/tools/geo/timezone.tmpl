{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.timezone.lookup.9da4e2e83e"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.timezone.lookup.e98d119bb1"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-timezone" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.look.up.the.iana.timezone.name.for.a.pair.of.649d515bbb"}}
      </p>

      <form id="timezone-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/timezone" method="post" action="{{path .BaseURL "/geo/timezone"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="timezone-form-lat">{{t .Lang "tool_pages.text.latitude.238a676da4"}}</label>
          <input type="text" name="lat" class="form-input" required value="40.7128" id="timezone-form-lat">
        </div>

        <div class="form-group">
          <label class="form-label" for="timezone-form-lon">{{t .Lang "tool_pages.text.longitude.6d80458fd1"}}</label>
          <input type="text" name="lon" class="form-input" required value="-74.0060" id="timezone-form-lon">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.lookup.b9beafcaf6"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="timezone-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/timezone?lat=40.7128&lon=-74.0060"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.bearing.calculator.f0767cd2c8"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.bearing.calculator.1c2b3274fb"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-bearing" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.calculate.the.initial.compass.bearing.in.deg.3065174298"}}
      </p>

      <form id="bearing-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/bearing" method="post" action="{{path .BaseURL "/geo/bearing"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="bearing-form-lat1">{{t .Lang "tool_pages.text.latitude.1.c5b01937d0"}}</label>
          <input type="text" name="lat1" class="form-input" required value="40.7128" id="bearing-form-lat1">
        </div>

        <div class="form-group">
          <label class="form-label" for="bearing-form-lon1">{{t .Lang "tool_pages.text.longitude.1.65b1b2e0fd"}}</label>
          <input type="text" name="lon1" class="form-input" required value="-74.0060" id="bearing-form-lon1">
        </div>

        <div class="form-group">
          <label class="form-label" for="bearing-form-lat2">{{t .Lang "tool_pages.text.latitude.2.0f7f853da1"}}</label>
          <input type="text" name="lat2" class="form-input" required value="34.0522" id="bearing-form-lat2">
        </div>

        <div class="form-group">
          <label class="form-label" for="bearing-form-lon2">{{t .Lang "tool_pages.text.longitude.2.62a0eb3b04"}}</label>
          <input type="text" name="lon2" class="form-input" required value="-118.2437" id="bearing-form-lon2">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.calculate.2121cc15af"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="bearing-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/bearing?lat1=40.7128&lon1=-74.0060&lat2=34.0522&lon2=-118.2437"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

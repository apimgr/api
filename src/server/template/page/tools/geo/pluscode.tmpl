{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/geo"}}">{{t .Lang "categories.geo.name"}}</a> {{t .Lang "tool_pages.text.plus.codes.e5a958c24d"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.plus.codes.8ed584af36"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="geo-pluscode" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.encode.a.pair.of.coordinates.into.a.google.o.e43fe77c9c"}}
      </p>

      <form id="pluscode-form" class="tool-form" data-endpoint="{{.APIBasePath}}/geo/pluscode" method="post" action="{{path .BaseURL "/geo/pluscode"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="pluscode-form-lat">{{t .Lang "tool_pages.text.latitude.238a676da4"}}</label>
          <input type="text" name="lat" class="form-input" value="40.7128" id="pluscode-form-lat">
        </div>

        <div class="form-group">
          <label class="form-label" for="pluscode-form-lon">{{t .Lang "tool_pages.text.longitude.6d80458fd1"}}</label>
          <input type="text" name="lon" class="form-input" value="-74.0060" id="pluscode-form-lon">
        </div>

        <div class="form-group">
          <label class="form-label" for="pluscode-form-code">{{t .Lang "tool_pages.text.plus.code.to.decode.instead.a41403eb50"}}</label>
          <input type="text" name="code" class="form-input" placeholder="87G7PX7V+3F" id="pluscode-form-code">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.run.00d60e31a4"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="pluscode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}{{.APIBasePath}}/geo/pluscode?lat=40.7128&lon=-74.0060"
curl "{{.BaseURL}}{{.APIBasePath}}/geo/pluscode?code=87G7PX7V%2B3F"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

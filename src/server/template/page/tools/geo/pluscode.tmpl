{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/geo">Geolocation</a> / Plus Codes
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Plus Codes</h1>
        <button class="btn btn-icon" data-favorite="geo-pluscode" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Encode a pair of coordinates into a Google Open Location Code (Plus
        Code), or decode a Plus Code back into coordinates. Fill in
        coordinates to encode, or a Plus Code to decode.
      </p>

      <form id="pluscode-form" class="tool-form" data-endpoint="/api/v1/geo/pluscode" method="get" action="/api/v1/geo/pluscode">
        <div class="form-group">
          <label class="form-label">Latitude</label>
          <input type="text" name="lat" class="form-input" value="40.7128">
        </div>

        <div class="form-group">
          <label class="form-label">Longitude</label>
          <input type="text" name="lon" class="form-input" value="-74.0060">
        </div>

        <div class="form-group">
          <label class="form-label">Plus Code (to decode instead)</label>
          <input type="text" name="code" class="form-input" placeholder="87G7PX7V+3F">
        </div>

        <button type="submit" class="btn btn-primary">Run</button>
      </form>

      <div id="pluscode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl "{{.BaseURL}}/api/v1/geo/pluscode?lat=40.7128&lon=-74.0060"
curl "{{.BaseURL}}/api/v1/geo/pluscode?code=87G7PX7V%2B3F"</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

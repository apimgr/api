{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.71988c4d8e"}}</a> {{t .Lang "tool_pages.text.hash.generator.045149d3b5"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.hash.generator.ef470f43f2"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-hash" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.cryptographic.hashes.of.arbitrary.t.cce136820c"}}
      </p>

      <form id="hash-form" class="tool-form" data-template="{{.APIBasePath}}/text/hash/{algorithm}/{input}.txt" method="post" action="{{path .BaseURL "/text/hash"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="hash-form-algorithm">{{t .Lang "tool_pages.text.algorithm.d704d8af25"}}</label>
          <select name="algorithm" class="form-select" id="hash-form-algorithm">
            <option value="sha256" selected>SHA-256</option>
            <option value="md5">MD5</option>
            <option value="sha1">SHA-1</option>
            <option value="sha512">SHA-512</option>
            <option value="blake3">BLAKE3</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="hash-form-input">{{t .Lang "tool_pages.text.input.text.75b6974625"}}</label>
          <input type="text" name="input" class="form-input" required placeholder="{{t .Lang "tool_pages.text.text.to.hash.9b33596cd1"}}" id="hash-form-input">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.generate.hash.2011743a57"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="hash-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/hash/sha256/hello</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

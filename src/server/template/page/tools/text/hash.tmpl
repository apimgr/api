{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/text">Text</a> / Hash Generator
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Hash Generator</h1>
        <button class="btn btn-icon" data-favorite="text-hash" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate cryptographic hashes of arbitrary text using MD5, SHA-1, SHA-256,
        SHA-512, or BLAKE3.
      </p>

      <form id="hash-form" class="tool-form" data-template="/api/v1/text/hash/{algorithm}/{input}.txt">
        <div class="form-group">
          <label class="form-label">Algorithm</label>
          <select name="algorithm" class="form-select">
            <option value="sha256" selected>SHA-256</option>
            <option value="md5">MD5</option>
            <option value="sha1">SHA-1</option>
            <option value="sha512">SHA-512</option>
            <option value="blake3">BLAKE3</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Input text</label>
          <input type="text" name="input" class="form-input" required placeholder="Text to hash">
        </div>

        <button type="submit" class="btn btn-primary">Generate Hash</button>
      </form>

      <div id="hash-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/text/hash/sha256/hello</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/text">Text</a> / Compress/Decompress
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Compress/Decompress</h1>
        <button class="btn btn-icon" data-favorite="text-compress" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Compress or decompress text using gzip, zlib, or flate/deflate. Input and
        output are base64-encoded so the result is always safe to copy as text.
      </p>

      <form id="compress-form" class="tool-form" data-body-endpoint="/api/v1/text/compress">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"data":"hello world","algorithm":"gzip","mode":"compress"}'></textarea>
          <span class="form-help">mode is "compress" or "decompress"; algorithm is gzip, zlib, or flate</span>
        </div>

        <button type="submit" class="btn btn-primary">Run</button>
      </form>

      <div id="compress-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/text/compress -d '{"data":"hello world","algorithm":"gzip","mode":"compress"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

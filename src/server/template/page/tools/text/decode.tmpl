{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.tools.e4c1e67921"}}</a> {{t .Lang "tool_pages.text.decode.7ab00321ea"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.decode.1ae3fcff1a"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-decode" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.decode.text.encoded.with.base64.base32.hex.u.15b74ec03d"}}
      </p>

      <form id="decode-form" class="tool-form" data-template="{{.APIBasePath}}/text/decode/{encoding}/{input}" method="post" action="{{path .BaseURL "/text/decode"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="decode-form-encoding">{{t .Lang "tool_pages.text.encoding.4d25a47625"}}</label>
          <select name="encoding" class="form-input" id="decode-form-encoding">
            <option value="base64" selected>{{t .Lang "tool_pages.text.base64.f03d8fe5a6"}}</option>
            <option value="base32">{{t .Lang "tool_pages.text.base32.ad8050bb72"}}</option>
            <option value="hex">{{t .Lang "tool_pages.text.hex.69493e6f1a"}}</option>
            <option value="url">URL</option>
            <option value="html">HTML</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="decode-form-input">{{t .Lang "tool_pages.text.input.text.75b6974625"}}</label>
          <input type="text" name="input" class="form-input" required placeholder="{{t .Lang "tool_pages.text.sgvsbg8gv29ybgq.d9de98033e"}}" id="decode-form-input">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.decode.1ae3fcff1a"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="decode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/decode/base64/SGVsbG8gV29ybGQ=</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

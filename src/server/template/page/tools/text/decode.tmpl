{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/text">Text Tools</a> / Decode
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Decode</h1>
        <button class="btn btn-icon" data-favorite="text-decode" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Decode text encoded with base64, base32, hex, URL, or HTML encoding.
      </p>

      <form id="decode-form" class="tool-form" data-template="/api/v1/text/decode/{encoding}/{input}">
        <div class="form-group">
          <label class="form-label">Encoding</label>
          <select name="encoding" class="form-input">
            <option value="base64" selected>Base64</option>
            <option value="base32">Base32</option>
            <option value="hex">Hex</option>
            <option value="url">URL</option>
            <option value="html">HTML</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Input text</label>
          <input type="text" name="input" class="form-input" required placeholder="SGVsbG8gV29ybGQ=">
        </div>

        <button type="submit" class="btn btn-primary">Decode</button>
      </form>

      <div id="decode-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/text/decode/base64/SGVsbG8gV29ybGQ=</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

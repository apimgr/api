{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2" style="color: var(--text-muted); font-size: 0.875rem;">
      <a href="/">Home</a> / <a href="/text">Text Tools</a> / Lorem Ipsum
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Lorem Ipsum</h1>
        <button class="btn btn-icon" data-favorite="text-lorem" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Generate placeholder Lorem Ipsum text by word, sentence, or paragraph.
      </p>

      <form id="lorem-form" class="tool-form" data-template="/api/v1/text/lorem/{type}/{count}">
        <div class="form-group">
          <label class="form-label">Type</label>
          <select name="type" class="form-input">
            <option value="words" selected>Words</option>
            <option value="sentences">Sentences</option>
            <option value="paragraphs">Paragraphs</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Count</label>
          <input type="number" name="count" class="form-input" required min="1" value="5">
        </div>

        <button type="submit" class="btn btn-primary">Generate</button>
      </form>

      <div id="lorem-form-result" class="tool-result" style="display:none;"></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">GET Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}/api/v1/text/lorem/words/5</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

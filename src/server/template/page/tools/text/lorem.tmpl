{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.tools.e4c1e67921"}}</a> {{t .Lang "tool_pages.text.lorem.ipsum.1ce0b2d740"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.lorem.ipsum.030dc1f936"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-lorem" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.placeholder.lorem.ipsum.text.by.wor.df3b738714"}}
      </p>

      <form id="lorem-form" class="tool-form" data-template="{{.APIBasePath}}/text/lorem/{type}/{count}" method="post" action="{{path .BaseURL "/text/lorem"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="lorem-form-type">{{t .Lang "tool_pages.text.type.baaddf70fb"}}</label>
          <select name="type" class="form-input" id="lorem-form-type">
            <option value="words" selected>{{t .Lang "tool_pages.text.words.0a8be89a52"}}</option>
            <option value="sentences">{{t .Lang "tool_pages.text.sentences.9fce2e3ccc"}}</option>
            <option value="paragraphs">{{t .Lang "tool_pages.text.paragraphs.d2ef75e86b"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="lorem-form-count">{{t .Lang "tool_pages.text.count.37bac4952b"}}</label>
          <input type="number" name="count" class="form-input" required min="1" value="5" id="lorem-form-count">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "common.generate"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="lorem-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/lorem/words/5</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.71988c4d8e"}}</a> {{t .Lang "tool_pages.text.regex.tester.e9dc517620"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.regex.tester.8fa7f614d4"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-regex" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.test.a.regular.expression.against.text.find.00cb63c02c"}}
      </p>

      <form id="regex-form" class="tool-form" data-body-endpoint="{{.APIBasePath}}/text/regex" method="post" action="{{path .BaseURL "/text/regex"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="regex-form-body">{{t .Lang "tool_pages.text.request.json.0e9d4c0115"}}</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{{t .Lang "tool_pages.text.pattern.a.z.text.hello.world.mode.match.3c9546da54"}}' id="regex-form-body"></textarea>
          <span class="form-help">{{t .Lang "tool_pages.text.mode.is.one.of.match.replace.explain.replace.6252eaa0d5"}}</span>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.test.532eaabd95"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="regex-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.post_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}{{.APIBasePath}}/text/regex -d '{"pattern":"[a-z]+","text":"Hello World","mode":"match"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

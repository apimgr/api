{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="/">Home</a> / <a href="/text">Text</a> / Extract
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">Extract</h1>
        <button class="btn btn-icon" data-favorite="text-extract" title="Add to favorites">⭐</button>
      </div>

      <p class="tool-description">
        Pull emails, URLs, IP addresses, or phone numbers out of free-form text.
      </p>

      <form id="extract-form" class="tool-form" data-body-endpoint="/api/v1/text/extract">
        <div class="form-group">
          <label class="form-label">Request (JSON)</label>
          <textarea name="body" class="form-input" rows="6" required placeholder='{"text":"contact us at test@example.com or https://example.com","type":"emails"}'></textarea>
          <span class="form-help">type is one of emails, urls, ips, phones</span>
        </div>

        <button type="submit" class="btn btn-primary">Extract</button>
      </form>

      <div id="extract-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>API Endpoint</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">POST Request</span>
            <button class="btn btn-sm" data-copy title="Copy">Copy</button>
          </div>
          <div class="code-content">
            <pre>curl -X POST {{.BaseURL}}/api/v1/text/extract -d '{"text":"test@example.com","type":"emails"}'</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

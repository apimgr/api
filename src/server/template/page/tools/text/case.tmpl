{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.tools.e4c1e67921"}}</a> {{t .Lang "tool_pages.text.case.converter.2d6b4a8c6a"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.case.converter.24820a0e02"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-case" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.convert.text.between.upper.lower.title.camel.f04ca80247"}}
      </p>

      <form id="case-form" class="tool-form" data-template="{{.APIBasePath}}/text/case/{style}/{input}" method="post" action="{{path .BaseURL "/text/case"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="case-form-style">{{t .Lang "tool_pages.text.style.7e744141b4"}}</label>
          <select name="style" class="form-input" id="case-form-style">
            <option value="upper" selected>{{t .Lang "tool_pages.text.upper.case.7618f6be25"}}</option>
            <option value="lower">{{t .Lang "tool_pages.text.lower.case.99f718061e"}}</option>
            <option value="title">{{t .Lang "tool_pages.text.title.case.c897dd8675"}}</option>
            <option value="camel">{{t .Lang "tool_pages.text.camelcase.987aa078ff"}}</option>
            <option value="pascal">{{t .Lang "tool_pages.text.pascalcase.49efb87333"}}</option>
            <option value="snake">{{t .Lang "tool_pages.text.snake.case.ffdf29cd20"}}</option>
            <option value="kebab">{{t .Lang "tool_pages.text.kebab.case.1960a3c5d2"}}</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label" for="case-form-input">{{t .Lang "tool_pages.text.input.text.75b6974625"}}</label>
          <input type="text" name="input" class="form-input" required placeholder="{{t .Lang "tool_pages.text.hello.world.a591a6d40b"}}" id="case-form-input">
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.convert.5cd425f518"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="case-form-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy title="{{t .Lang "tool_pages.text.copy.e21f935f11"}}">{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/case/upper/Hello%20World</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

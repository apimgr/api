{{define "content"}}
{{$tool := .}}
{{with $tool}}
<section>
  <div class="container container-sm">
    <nav class="mb-2 tool-note">
      <a href="{{path .BaseURL "/"}}">{{t .Lang "nav.home"}}</a> / <a href="{{path .BaseURL "/text"}}">{{t .Lang "tool_pages.text.text.71988c4d8e"}}</a> {{t .Lang "tool_pages.text.uuid.generator.d8ac3e58a9"}}
    </nav>

    <div class="tool-card">
      <div class="tool-header">
        <h1 class="tool-title">{{t .Lang "tool_pages.text.uuid.generator.1b8736f8be"}}</h1>
        <button type="button" class="btn btn-icon" data-favorite="text-uuid" title="{{t .Lang "common.add_to_favorites"}}">⭐</button>
      </div>

      <p class="tool-description">
        {{t .Lang "tool_pages.text.generate.universally.unique.identifiers.uuid.27f0e2518c"}}
      </p>

      <form id="uuid-form" class="tool-form" data-template="{{.APIBasePath}}/text/uuid/{version}" data-batch-template="{{.APIBasePath}}/text/uuid/{version}/{count}" data-result-id="uuid-result" method="post" action="{{path .BaseURL "/text/uuid"}}">
        {{csrfField .CSRFToken}}
        <div class="form-group">
          <label class="form-label" for="uuid-form-version">{{t .Lang "health.version"}}</label>
          <select name="version" class="form-select" id="uuid-form-version">
            <option value="4" selected>{{t .Lang "tool_pages.text.v4.random.f93adc6ee4"}}</option>
            <option value="1">{{t .Lang "tool_pages.text.v1.timestamp.828cbd6626"}}</option>
            <option value="7">{{t .Lang "tool_pages.text.v7.timestamp.random.b87c8c27d8"}}</option>
          </select>
          <span class="form-help">{{t .Lang "tool_pages.text.v4.is.most.common.v7.is.sortable.by.time.b33d6de30a"}}</span>
        </div>

        <div class="form-group">
          <label class="form-label" for="uuid-form-count">{{t .Lang "tool_pages.text.count.37bac4952b"}}</label>
          <input type="number" name="count" class="form-input" value="1" min="1" max="100" id="uuid-form-count">
          <span class="form-help">{{t .Lang "tool_pages.text.generate.multiple.uuids.at.once.max.100.277e796ea7"}}</span>
        </div>

        <button type="submit" class="btn btn-primary">{{t .Lang "tool_pages.text.generate.uuid.7cd3687360"}}</button>
      </form>

      {{if or .ToolError .ToolResult .ToolImageURL}}
      <div class="tool-server-result" role="status" aria-live="polite">
        {{if .ToolError}}<p class="tool-server-result-error"><strong>{{t .Lang "common.error"}}:</strong> {{.ToolError}}</p>{{end}}
        {{if .ToolResult}}<h2>{{t .Lang "common.success"}}</h2><pre class="tool-result">{{.ToolResult}}</pre>{{end}}
        {{if .ToolImageURL}}<h2>{{t .Lang "common.success"}}</h2><img class="tool-result-image" src="{{.ToolImageURL}}" alt="{{.PageTitle}}">{{end}}
      </div>
      {{end}}

      <div id="uuid-result" class="tool-result" hidden></div>

      <div class="mt-3">
        <h3>{{t .Lang "common.api_endpoint"}}</h3>
        <div class="code-block">
          <div class="code-header">
            <span class="code-lang">{{t .Lang "common.get_request"}}</span>
            <button type="button" class="btn btn-sm" data-copy>{{t .Lang "common.copy"}}</button>
          </div>
          <div class="code-content">
            <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/uuid
curl {{.BaseURL}}{{.APIBasePath}}/text/uuid/4
curl {{.BaseURL}}{{.APIBasePath}}/text/uuid/4/10  # Generate 10 UUIDs</pre>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
{{end}}

{{define "content"}}
<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{t .Lang "page_text.text.geolocation.bc6177afc5"}}</h1>
    <p class="hero-subtitle">
      {{t .Lang "categories.geo.description"}}
    </p>
  </div>
</section>

<section>
  <div class="container">
    <div class="category-grid">
      <a href="{{path .BaseURL "/geo/ip"}}" class="category-card">
        <div class="category-icon">📍</div>
        <h3 class="category-title">{{t .Lang "page_text.text.ip.geolocation.345cebdfdc"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.find.location.from.ip.address.092611fa1e"}}</p>
      </a>
      
      <a href="{{path .BaseURL "/geo/geocode"}}" class="category-card">
        <div class="category-icon">🗺️</div>
        <h3 class="category-title">{{t .Lang "page_text.text.geocode.address.da4dc4a112"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.convert.address.to.coordinates.16e5b664a1"}}</p>
      </a>
      
      <a href="{{path .BaseURL "/geo/reverse"}}" class="category-card">
        <div class="category-icon">📌</div>
        <h3 class="category-title">{{t .Lang "page_text.text.reverse.geocode.6591e7cfab"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.get.address.from.coordinates.fe2e43ab68"}}</p>

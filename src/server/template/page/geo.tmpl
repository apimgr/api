      <a href="{{path .BaseURL "/geo/h3"}}" class="category-card">
        <div class="category-icon">⬡</div>
        <h3 class="category-title">{{t .Lang "page_text.text.h3.encoder.6044f8656c"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.uber.h3.hexagonal.indexing.3368e9a28c"}}</p>
      </a>
      
      <a href="{{path .BaseURL "/geo/pluscode"}}" class="category-card">
        <div class="category-icon">➕</div>

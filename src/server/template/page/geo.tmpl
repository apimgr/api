        <div class="category-icon">🧭</div>
        <h3 class="category-title">{{t .Lang "page_text.text.bearing.calculator.1c2b3274fb"}}</h3>
        <p class="category-description">{{t .Lang "page_text.text.calculate.bearing.between.points.4fa2536845"}}</p>

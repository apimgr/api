{{define "content"}}
<section class="search-section">
    <div class="container container-sm">
        <div class="section-header">
            <h1 class="section-title">System Health</h1>
            <p class="section-description">Current status and health information</p>
        </div>

        <div class="health-card {{if eq .Status "healthy"}}healthy{{else}}unhealthy{{end}}">
            <div class="health-status">
                <span class="health-indicator"></span>
                <span class="health-text">{{.Status}}</span>
            </div>
        </div>

        <div class="info-grid">
            <div class="info-item">
                <div class="info-label">Version</div>
                <div class="info-value">{{.Version}}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Mode</div>
                <div class="info-value">{{.Mode}}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Uptime</div>
                <div class="info-value">{{.Uptime}}</div>
            </div>
            <div class="info-item">
                <div class="info-label">Started</div>
                <div class="info-value">{{.StartTime}}</div>
            </div>
        </div>

        {{if .Checks}}
        <div class="checks-section">
            <h3>Health Checks</h3>
            <div class="checks-grid">
                {{range $name, $status := .Checks}}
                <div class="check-item {{if eq $status "ok"}}ok{{else}}fail{{end}}">
                    <span class="check-name">{{$name}}</span>
                    <span class="check-status">{{$status}}</span>
                </div>
                {{end}}
            </div>
        </div>
        {{end}}
    </div>
</section>
{{end}}

{{define "page-scripts"}}
<style>
    /* Colors below reference the shared palette (var(--success-color)/
       var(--danger-color) from common.css, sourced from
       src/common/theme/colors.go) instead of hardcoded hex, so this page
       stays in sync with the dark/light/auto theme. */
    .health-card {
        background: var(--surface-alt-color);
        border: 2px solid var(--border-color);
        border-radius: var(--border-radius-lg);
        padding: var(--spacing-lg);
        text-align: center;
        margin-bottom: var(--spacing-lg);
    }

    .health-card.healthy {
        border-color: var(--success-color);
    }

    .health-card.unhealthy {
        border-color: var(--danger-color);
    }

    .health-status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-sm);
    }

    .health-indicator {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    .healthy .health-indicator {
        background: var(--success-color);
        color: var(--success-color);
        box-shadow: 0 0 0 0 currentColor;
    }

    .unhealthy .health-indicator {
        background: var(--danger-color);
        color: var(--danger-color);
        box-shadow: 0 0 0 0 currentColor;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 currentColor; }
        70% { box-shadow: 0 0 0 10px transparent; }
        100% { box-shadow: 0 0 0 0 transparent; }
    }

    .health-text {
        font-size: 1.5rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    .healthy .health-text {
        color: var(--success-color);
    }

    .unhealthy .health-text {
        color: var(--danger-color);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .info-item {
        background: var(--surface-alt-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius-lg);
        padding: var(--spacing-md);
        text-align: center;
    }

    .info-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: var(--spacing-xs);
    }

    .info-value {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-color);
    }

    .checks-section h3 {
        margin-bottom: var(--spacing-md);
    }

    .checks-grid {
        display: grid;
        gap: var(--spacing-sm);
    }

    .check-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--surface-alt-color);
        border: 1px solid var(--border-color);
        border-radius: var(--border-radius);
        padding: var(--spacing-sm) var(--spacing-md);
    }

    .check-name {
        font-weight: 500;
    }

    .check-status {
        font-family: var(--font-family-mono);
        font-size: 0.875rem;
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--border-radius);
    }

    .check-item.ok .check-status {
        background: color-mix(in srgb, var(--success-color) 20%, transparent);
        color: var(--success-color);
    }

    .check-item.fail .check-status {
        background: color-mix(in srgb, var(--danger-color) 20%, transparent);
        color: var(--danger-color);
    }
</style>
{{end}}

{{define "content"}}
<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{.SiteTitle}}</h1>
    <p class="hero-subtitle">{{.SiteDescription}}</p>
    <div class="hero-actions">
      <a href="{{path .BaseURL "/categories"}}" class="btn btn-primary btn-lg">{{t .Lang "page_text.text.browse.categories.26ff1011ea"}}</a>
      <a href="{{path .BaseURL "/server/docs/swagger"}}" class="btn btn-secondary btn-lg">{{t .Lang "help.api_documentation"}}</a>
    </div>
  </div>
</section>

<section class="features">
  <div class="container">
    <h2 class="text-center mb-3">{{tf .Lang "categories.summary" (dict "tools" (printf "%d" .TotalTools) "categories" (printf "%d" .TotalCategories))}}</h2>
    <div class="category-grid">
      {{range .Categories}}
      <a href="{{.Path}}" class="category-card">
        <div class="category-icon" aria-hidden="true">{{.Icon}}</div>
        <h3 class="category-title">{{t $.Lang .NameKey}}</h3>
        <p class="category-description">{{t $.Lang .DescriptionKey}}</p>
        <span class="category-count">{{tp $.Lang "tools" .Count nil}}</span>
      </a>
      {{end}}
    </div>
  </div>
</section>

<section class="search-section">
  <div class="container container-sm">
    <h2 class="text-center mb-3">{{t .Lang "page_text.text.quick.start.examples.8572a244c1"}}</h2>
    <p class="text-center text-muted mb-3">{{t .Lang "page_text.text.call.the.api.directly.from.your.command.line.5c17ca1717"}}</p>

    <div class="code-block">
      <div class="code-header">
        <span class="code-lang">{{t .Lang "page_text.text.generate.uuid.7cd3687360"}}</span>
        <button type="button" class="btn btn-sm code-copy" data-copy>{{t .Lang "common.copy"}}</button>
      </div>
      <div class="code-content">
        <pre>curl {{.BaseURL}}{{.APIBasePath}}/text/uuid</pre>
      </div>
    </div>

    <div class="code-block">
      <div class="code-header">
        <span class="code-lang">{{t .Lang "page_text.text.hash.text.sha256.746302965c"}}</span>
        <button type="button" class="btn btn-sm code-copy" data-copy>{{t .Lang "common.copy"}}</button>
      </div>
      <div class="code-content">
        <pre>curl {{.BaseURL}}{{.APIBasePath}}/crypto/hash/sha256/hello</pre>
      </div>
    </div>

    <div class="code-block">
      <div class="code-header">
        <span class="code-lang">{{t .Lang "page_text.text.current.timestamp.8cb6a744a5"}}</span>
        <button type="button" class="btn btn-sm code-copy" data-copy>{{t .Lang "common.copy"}}</button>
      </div>
      <div class="code-content">
        <pre>curl {{.BaseURL}}{{.APIBasePath}}/datetime/now</pre>
      </div>
    </div>

    <div class="code-block">
      <div class="code-header">
        <span class="code-lang">{{t .Lang "page_text.text.convert.temperature.3a926e542c"}}</span>
        <button type="button" class="btn btn-sm code-copy" data-copy>{{t .Lang "common.copy"}}</button>
      </div>
      <div class="code-content">
        <pre>curl {{.BaseURL}}{{.APIBasePath}}/convert/temperature/32/f/c</pre>
      </div>
    </div>
  </div>
</section>
{{end}}

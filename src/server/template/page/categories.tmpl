{{define "content"}}
<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{.PageTitle}}</h1>
    <p class="hero-subtitle">{{tf .Lang "categories.summary" (dict "tools" (printf "%d" .TotalTools) "categories" (printf "%d" .TotalCategories))}}</p>
  </div>
</section>

<section>
  <div class="container">
    <div class="category-grid">
      {{range .Categories}}
      <a href="{{.Path}}" class="category-card">
        <div class="category-icon">{{.Icon}}</div>
        <h3 class="category-title">{{t $.Lang .NameKey}}</h3>
        <p class="category-description">{{t $.Lang .DescriptionKey}}</p>
        <span class="category-count">{{tp $.Lang "tools" .Count nil}}</span>
      </a>
      {{end}}
    </div>
  </div>
</section>
{{end}}

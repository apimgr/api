    <h1 class="page-title">{{.PageTitle}}</h1>
    <p class="page-description">{{.PageDescription}}</p>
  </header>

  <section class="section-card" aria-labelledby="security-policy-content">
    <h2 id="security-policy-content">{{t .Lang "security.disclosure_title"}}</h2>
    {{.SecurityPolicy}}
  </section>
</article>
{{end}}
